#!/bin/sh
# The 00379 mikroBUS display (GLT028240320IS1 on the ST7789T3 tinydrm
# driver) is a plain SPI framebuffer. G2D needs PXP, which its DTs leave
# disabled, and its primary plane only scans out RGB565/XRGB8888, so the
# stock weston.ini (use-g2d=true, gbm-format=argb8888) makes Weston fail.
# When that display is present, write a pixman/RGB565 copy of weston.ini
# where Weston finds it first ($XDG_CONFIG_HOME, set by the unit drop-in).
# Any other display keeps the stock /etc/xdg/weston/weston.ini.
dir=/run/cargt-weston
rm -rf "$dir"
for drv in /sys/class/drm/card*/device/driver; do
    [ "$(basename "$(readlink -f "$drv")")" = st7789t3 ] || continue
    mkdir -p "$dir"
    sed -e 's/^use-g2d=.*/use-g2d=false/' \
        -e 's/^gbm-format=.*/gbm-format=rgb565/' \
        -e '/^renderer=/d' \
        -e '/^\[core\]/a renderer=pixman' \
        /etc/xdg/weston/weston.ini > "$dir/weston.ini"
    break
done
exit 0
