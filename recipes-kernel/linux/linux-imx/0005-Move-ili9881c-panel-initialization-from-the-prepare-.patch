From 76e5f0da9a25932ea82cb28151cfe044946a3552 Mon Sep 17 00:00:00 2001
From: Tim Carney <tim.carney@cargt.com>
Date: Fri, 21 Nov 2025 08:18:34 -0600
Subject: [PATCH] Move ili9881c panel initialization from the prepare to the
 enable function to avoid trying to communicate over MIPI before the
 peripheral is ready.

Upstream-Status: Inappropriate [Cargt board specific]

Rebased 2026-07-17 against the current upstream driver, which had since
been rewritten to use the mipi_dsi_multi_context batched-transaction API
(no more discrete per-call return codes, and .prepare/.enable had been
re-merged back into a single function upstream). Re-expressed the same
intent -- keep MIPI communication out of .prepare, defer it to .enable --
against the new API instead of trying to force the old per-call ret
checks and separate prepare/enable split onto code that no longer has
either.
---
 drivers/gpu/drm/panel/panel-ilitek-ili9881c.c | 32 ++++++++++++++++--------
 1 file changed, 23 insertions(+), 9 deletions(-)

diff --git a/drivers/gpu/drm/panel/panel-ilitek-ili9881c.c b/drivers/gpu/drm/panel/panel-ilitek-ili9881c.c
index 3e65d17f7a11..60c1b3b86a4b 100644
--- a/drivers/gpu/drm/panel/panel-ilitek-ili9881c.c
+++ b/drivers/gpu/drm/panel/panel-ilitek-ili9881c.c
@@ -1846,8 +1846,6 @@
 static int ili9881c_prepare(struct drm_panel *panel)
 {
 	struct ili9881c *ctx = panel_to_ili9881c(panel);
-	struct mipi_dsi_multi_context mctx = { .dsi = ctx->dsi };
-	unsigned int i;
 	int ret;
 
 	/* Power the panel */
@@ -1856,12 +1854,30 @@
 		return ret;
 	msleep(5);
 
+	gpiod_set_value_cansleep(ctx->reset, 0);
+	msleep(50);
+
 	/* And reset it */
 	gpiod_set_value_cansleep(ctx->reset, 1);
 	msleep(20);
 
 	gpiod_set_value_cansleep(ctx->reset, 0);
-	msleep(20);
+	msleep(100);
+
+	return 0;
+}
+
+/*
+ * Cargt: the init sequence is deliberately run from .enable rather than
+ * .prepare -- on this platform the DSI host isn't ready to transmit at
+ * .prepare time, so sending it here avoids communicating over MIPI before
+ * the peripheral (and host controller) are actually ready.
+ */
+static int ili9881c_enable(struct drm_panel *panel)
+{
+	struct ili9881c *ctx = panel_to_ili9881c(panel);
+	struct mipi_dsi_multi_context mctx = { .dsi = ctx->dsi };
+	unsigned int i;
 
 	for (i = 0; i < ctx->desc->init_length; i++) {
 		const struct ili9881c_instr *instr = &ctx->desc->init[i];
@@ -1884,12 +1900,9 @@
 	mipi_dsi_msleep(&mctx, 120);
 	mipi_dsi_dcs_set_display_on_multi(&mctx);
 	if (mctx.accum_err)
-		goto disable_power;
-
-	return 0;
+		printk(KERN_ERR "ili9881c_enable: init sequence failed: %d\n",
+		       mctx.accum_err);
 
-disable_power:
-	regulator_disable(ctx->power);
 	return mctx.accum_err;
 }
 
@@ -2105,6 +2118,7 @@
 
 static const struct drm_panel_funcs ili9881c_funcs = {
 	.prepare	= ili9881c_prepare,
+	.enable		= ili9881c_enable,
 	.unprepare	= ili9881c_unprepare,
 	.get_modes	= ili9881c_get_modes,
 	.get_orientation = ili9881c_get_orientation,
-- 
