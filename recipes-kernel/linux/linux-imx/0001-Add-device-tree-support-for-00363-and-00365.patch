From 6493769bb026c00034fccca3f54be8b25889a39d Mon Sep 17 00:00:00 2001
From: Tim Carney <tim.carney@cargt.com>
Date: Wed, 24 Sep 2025 08:41:40 -0500
Subject: [PATCH] Add device tree support for 00363 and 00365.

---
 arch/arm64/boot/dts/freescale/Makefile        |   6 +
 ...x93-cargt-00363-00365-glt0557201280is1.dts |  15 +
 ...93-cargt-00363-00365-glt0557201280is1.dtsi |  94 ++++
 ...x93-cargt-00363-00365-glt1011280800is1.dts |  15 +
 ...93-cargt-00363-00365-glt1011280800is1.dtsi | 154 ++++++
 .../dts/freescale/imx93-cargt-00363-00365.dts | 399 ++++++++++++++++
 .../freescale/imx93-cargt-00363-osm-som.dts   | 449 ++++++++++++++++++
 7 files changed, 1132 insertions(+)
 create mode 100644 arch/arm64/boot/dts/freescale/imx93-cargt-00363-00365-glt0557201280is1.dts
 create mode 100644 arch/arm64/boot/dts/freescale/imx93-cargt-00363-00365-glt0557201280is1.dtsi
 create mode 100644 arch/arm64/boot/dts/freescale/imx93-cargt-00363-00365-glt1011280800is1.dts
 create mode 100644 arch/arm64/boot/dts/freescale/imx93-cargt-00363-00365-glt1011280800is1.dtsi
 create mode 100644 arch/arm64/boot/dts/freescale/imx93-cargt-00363-00365.dts
 create mode 100644 arch/arm64/boot/dts/freescale/imx93-cargt-00363-osm-som.dts

diff --git a/arch/arm64/boot/dts/freescale/Makefile b/arch/arm64/boot/dts/freescale/Makefile
index 6959e1e016b2..243acce1ba5a 100644
--- a/arch/arm64/boot/dts/freescale/Makefile
+++ b/arch/arm64/boot/dts/freescale/Makefile
@@ -437,7 +437,13 @@ dtb-$(CONFIG_ARCH_MXC) += imx93-9x9-qsb.dtb \
 			  imx93-9x9-qsb-aud-hat.dtb \
 			  imx93-9x9-qsb-ld.dtb \
 			  imx93-9x9-qsb-rpmsg.dtb imx93-9x9-qsb-rpmsg-lpv.dtb
+
 dtb-$(CONFIG_ARCH_MXC) += imx93-tqma9352-mba93xxla.dtb
+
+dtb-$(CONFIG_ARCH_MXC) += imx93-cargt-00363-00365.dtb \
+				imx93-cargt-00363-00365-glt0557201280is1.dtb \
+				imx93-cargt-00363-00365-glt1011280800is1.dtb
+
 dtb-$(CONFIG_ARCH_MXC) += imx91-9x9-qsb.dtb \
 			  imx91-9x9-qsb-can1.dtb \
 			  imx91-9x9-qsb-flexspi-nand.dtb \
diff --git a/arch/arm64/boot/dts/freescale/imx93-cargt-00363-00365-glt0557201280is1.dts b/arch/arm64/boot/dts/freescale/imx93-cargt-00363-00365-glt0557201280is1.dts
new file mode 100644
index 000000000000..baa248b4bc09
--- /dev/null
+++ b/arch/arm64/boot/dts/freescale/imx93-cargt-00363-00365-glt0557201280is1.dts
@@ -0,0 +1,15 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * Copyright 2022 NXP
+ */
+
+ /dts-v1/;
+
+ #include <dt-bindings/usb/pd.h>
+ #include <dt-bindings/pwm/pwm.h>
+ #include "imx93-cargt-00363-00365.dts"
+ #include "imx93-cargt-00363-00365-glt0557201280is1.dtsi"
+ 
+/ {
+	model = "Cargt i.MX93 00365 carrier board with 5.5-in MIPI DSI Display(GLT0557201280IS1-CTP)";	
+};
diff --git a/arch/arm64/boot/dts/freescale/imx93-cargt-00363-00365-glt0557201280is1.dtsi b/arch/arm64/boot/dts/freescale/imx93-cargt-00363-00365-glt0557201280is1.dtsi
new file mode 100644
index 000000000000..42f6cf4cdc2a
--- /dev/null
+++ b/arch/arm64/boot/dts/freescale/imx93-cargt-00363-00365-glt0557201280is1.dtsi
@@ -0,0 +1,94 @@
+ / {
+	 pwm_backlight: pwm_backlight {
+		compatible = "pwm-backlight";
+		pwms = <&tpm5 1 5000000 0>; // 200 Hz
+		brightness-levels = <0 100>;
+		num-interpolated-steps = <100>;
+		default-brightness-level = <80>;
+		status = "okay";
+	};
+};
+	
+&lcdif {
+	status = "okay";
+	assigned-clock-rates = <445333333>, <148444444>, <400000000>, <133333333>;
+};
+
+&dphy {
+	status = "okay";
+};
+	
+&dsi {
+	#address-cells = <1>;
+	#size-cells = <0>;
+	status = "okay";
+
+	panel@0 {
+		compatible = "globaltech,glt0557201280is1", "ilitek,ili9881c";
+		reg = <0>;
+		pinctrl-names = "default";
+		rotation = <90>;
+		reset-gpios = <&pca9555_20 3 GPIO_ACTIVE_LOW>;
+		backlight = <&pwm_backlight>;
+		status = "okay";
+
+		port {
+			panel_in: endpoint {
+				remote-endpoint = <&dsi_out>;
+			};
+		};
+	};
+
+	ports {
+		port@1 {
+			reg = <1>;
+
+			dsi_out: endpoint {
+				remote-endpoint = <&panel_in>;
+			};
+		};
+	};
+};
+
+&lpi2c3 {
+	status = "okay";
+
+	touchscreen@41 {
+		compatible = "ilitek,ili2520";
+		reg = <0x41>;
+
+		pinctrl-0 = <&pinctrl_touchscreen>;
+		reset-gpios = <&pca9555_20 4 GPIO_ACTIVE_LOW>;
+		interrupt-parent = <&gpio1>;
+		interrupts = <11 IRQ_TYPE_LEVEL_LOW>;
+		touchscreen-swapped-x-y;
+		touchscreen-inverted-x;
+		wakeup-source;
+	};
+};
+
+&tpm5 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pinctrl_backlight_pwm>;
+	status = "okay";
+};
+
+&epxp {
+	status = "okay";
+};
+
+&iomuxc {
+
+	pinctrl_backlight_pwm: backlight-pwmgrp {
+		fsl,pins = <			    
+		MX93_PAD_GPIO_IO22__TPM5_CH1		0x2
+	>;
+	};
+
+	pinctrl_touchscreen: touchscreengrp {
+		fsl,pins = <
+			MX93_PAD_SAI1_TXFS__GPIO1_IO11			0x31e // DSICT_nINT
+		>;	
+	};
+};
+
diff --git a/arch/arm64/boot/dts/freescale/imx93-cargt-00363-00365-glt1011280800is1.dts b/arch/arm64/boot/dts/freescale/imx93-cargt-00363-00365-glt1011280800is1.dts
new file mode 100644
index 000000000000..7233043d0da8
--- /dev/null
+++ b/arch/arm64/boot/dts/freescale/imx93-cargt-00363-00365-glt1011280800is1.dts
@@ -0,0 +1,15 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * Copyright 2022 NXP
+ */
+
+ /dts-v1/;
+
+ #include <dt-bindings/usb/pd.h>
+ #include <dt-bindings/pwm/pwm.h>
+ #include "imx93-cargt-00363-00365.dts"
+ #include "imx93-cargt-00363-00365-glt1011280800is1.dtsi"
+ 
+/ {
+	model = "Cargt i.MX93 00365 carrier board with 10-in LVDS Display(GLT10111280800IS1-CTP)";
+};
diff --git a/arch/arm64/boot/dts/freescale/imx93-cargt-00363-00365-glt1011280800is1.dtsi b/arch/arm64/boot/dts/freescale/imx93-cargt-00363-00365-glt1011280800is1.dtsi
new file mode 100644
index 000000000000..38ab6e95db18
--- /dev/null
+++ b/arch/arm64/boot/dts/freescale/imx93-cargt-00363-00365-glt1011280800is1.dtsi
@@ -0,0 +1,154 @@
+ / {
+ 
+	pwm_backlight: pwm_backlight {
+		compatible = "pwm-backlight";
+		pwms = <&tpm3 3 5000000 0>; // 200 Hz
+		brightness-levels = <0 100>;
+		num-interpolated-steps = <100>;
+		default-brightness-level = <80>;
+		status = "okay";
+	};
+	
+	gpio_backlight: gpio_backlight {
+		compatible = "gpio-backlight";
+		pinctrl-names = "default";
+		pinctrl-0 = <&pinctrl_backlight_gpio>;
+		gpios = <&gpio2 24 GPIO_ACTIVE_HIGH>;
+		default-on;
+		status = "disabled";
+	};
+
+	reg_lvds_i2c_switch: regulator-lvds-i2c-switch {
+		compatible = "regulator-fixed";
+		regulator-name = "lvds_i2c_sw";
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+		gpio = <&pca9555_20 15 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		regulator-always-on;
+		status = "okay";
+	};	
+
+	reg_lvds_vdd: regulator-lvds-vdd {
+		compatible = "regulator-fixed";
+		regulator-name = "lvds_vdd";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		gpio = <&pca9555_20 5 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		regulator-always-on;
+		vin-supply = <&reg_lvds_i2c_switch>;
+		status = "okay";
+	};
+
+	lvds_panel {
+		compatible = "boe,ev121wxm-n10-1850";
+		backlight = <&pwm_backlight>;		
+		power-supply = <&DISPLAY_reg>;
+
+		port {
+			panel_lvds_in: endpoint {
+				remote-endpoint = <&lvds_out>;
+			};
+		};
+	};
+  };
+ 
+&tpm3 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pinctrl_backlight_pwm>;
+	status = "okay";
+ };
+ 
+ &dphy {
+	 status = "disabled";
+ };
+ 
+ &dsi {
+	 status = "disabled";
+ };
+ 
+ &lcdif {
+	assigned-clock-rates = <498000000>, <71142857>, <400000000>, <133333333>;
+	status = "okay";
+ };
+ 
+ &ldb {
+	 status = "okay";
+ 
+	 lvds-channel@0 {
+		 status = "okay";
+ 
+		 port@1 {
+			 reg = <1>;
+ 
+			 lvds_out: endpoint {
+				 remote-endpoint = <&panel_lvds_in>;
+			 };
+		 };
+	 };
+ };
+ 
+ &ldb_phy {
+	 status = "okay";
+ };
+ 
+ &lpi2c3 {
+	touchscreen@41 {
+		compatible = "ilitek,ili251x";
+		reg = <0x41>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&pinctrl_cap_touch>;
+		interrupt-parent = <&gpio1>;
+		interrupts = <12 IRQ_TYPE_EDGE_FALLING>;
+		reset-gpios = <&pca9555_20 6 GPIO_ACTIVE_LOW>;
+		status = "okay";
+	};
+
+	/* eeprom on display */
+	eeprom@54 {
+		compatible = "atmel,24c02";
+		reg = <0x54>;
+		pagesize = <16>;		
+	};
+
+	max25221: max25221@21 {
+		compatible = "maxim,max25221";
+		reg = <0x21>;
+		lcd-supply = <&reg_lvds_vdd>;
+		status = "okay";
+
+		regulators {
+			DISPLAY_reg: DISPLAY {
+				regulator-name = "DISPLAY";
+			};
+		};
+	};
+ };
+ 
+ 
+ 
+ &iomuxc {
+ 
+	pinctrl_cap_touch: cap_touch {
+		 fsl,pins = <
+		 	MX93_PAD_SAI1_TXC__GPIO1_IO12 	0x31e	/* PCAP_LVDS_nINT */
+		 >;
+	 };
+ 
+ 	pinctrl_backlight_pwm: backlight-pwmgrp {
+		 fsl,pins = <			    
+			MX93_PAD_GPIO_IO24__TPM3_CH3		0x2
+		>;
+	};
+
+	pinctrl_backlight_gpio: backlight-gpiogrp {
+		fsl,pins = <
+			MX93_PAD_GPIO_IO24__GPIO2_IO24		0x31e
+		>;
+	};
+ };
+ 
+&epxp {
+	status = "okay";
+};
\ No newline at end of file
diff --git a/arch/arm64/boot/dts/freescale/imx93-cargt-00363-00365.dts b/arch/arm64/boot/dts/freescale/imx93-cargt-00363-00365.dts
new file mode 100644
index 000000000000..e8a94beab9ba
--- /dev/null
+++ b/arch/arm64/boot/dts/freescale/imx93-cargt-00363-00365.dts
@@ -0,0 +1,399 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * Copyright 2022 NXP
+ */
+
+/dts-v1/;
+
+#include <dt-bindings/usb/pd.h>
+#include "imx93-cargt-00363-osm-som.dts"
+ 
+ / {
+	model = "Cargt i.MX93 00363 OSM-L SOM on 00365 carrier board";
+
+	aliases {
+		rtc0 = &rtc_i2c;
+		rtc1 = &bbnsm_rtc;
+	};
+
+	reg_usdhc2_vmmc: regulator-usdhc2 {
+		pinctrl-names = "default";
+		pinctrl-0 = <&pinctrl_usdhc2_reg>;		
+		compatible = "regulator-fixed";
+		regulator-name = "SDIO_A_PWR_EN";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		gpio = <&gpio3 7 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+	};
+
+	reg_usdhc2_vddio: regulator-usdhc2-vddio {
+		compatible = "regulator-fixed";
+		regulator-name = "ldo-1v8";
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+		regulator-boot-on;
+		regulator-always-on;
+	};
+};
+ 
+ 
+&flexcan1 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pinctrl_flexcan1>;
+	status = "okay";
+};
+ 
+&flexcan2 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pinctrl_flexcan2>;
+	status = "okay";
+};
+ 
+&lpi2c2 {
+	#address-cells = <1>;
+	#size-cells = <0>;
+	clock-frequency = <400000>;
+	pinctrl-names = "default", "sleep";
+	pinctrl-0 = <&pinctrl_lpi2c2>;
+	pinctrl-1 = <&pinctrl_lpi2c2>;
+	status = "okay";
+
+	pca9555_20: pca9555@20 {
+		compatible = "nxp,pca9555";
+		gpio-controller;
+		#gpio-cells = <2>;
+		reg = <0x20>;
+		gpio-line-names =
+			"pca9555_20-0",	"pca9555_20-1",	"pca9555_20-2",	"pca9555_20-3", 	// 0-3
+			"pca9555_20-4",	"pca9555_20-5",	"pca9555_20-6",	"pca9555_20-7",		// 4-7
+			"pca9555_20-8",	"pca9555_20-9",	"pca9555_20-10","pca9555_20-11", 	// 8-11
+			"pca9555_20-12","pca9555_20-13","pca9555_20-14","pca9555_20-15"; 	// 12-15
+	};
+
+	ptn5110_51: tcpc@51 {
+		compatible = "nxp,ptn5110";
+		reg = <0x51>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&pinctrl_ptn5110_51>;
+		interrupt-parent = <&gpio2>;
+		interrupts = <9 IRQ_TYPE_LEVEL_LOW>;	
+		status = "okay";
+
+		port {
+			typec1_dr_sw: endpoint {
+				remote-endpoint = <&usb1_drd_sw>;
+			};
+		};
+
+		connector {
+			compatible = "usb-c-connector";
+			label = "USB-C(A)";
+			power-role = "dual";
+			data-role = "dual";
+			try-power-role = "sink";
+			source-pdos = <PDO_FIXED(5000, 3000, PDO_FIXED_USB_COMM)>;
+			sink-pdos = <PDO_FIXED(5000, 3000, PDO_FIXED_USB_COMM)
+					PDO_VAR(5000, 20000, 3000)>;
+			op-sink-microwatt = <15000000>;
+			self-powered;
+		};
+	};
+
+	ptn5110_52: tcpc@52 {
+		compatible = "nxp,ptn5110";
+		reg = <0x52>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&pinctrl_ptn5110_52>;
+		interrupt-parent = <&gpio2>;
+		interrupts = <10 IRQ_TYPE_LEVEL_LOW>;	
+		status = "okay";
+
+		port {
+			typec2_dr_sw: endpoint {
+				remote-endpoint = <&usb2_drd_sw>;
+			};
+		};
+
+		connector {
+			compatible = "usb-c-connector";
+			label = "USB-C(C)";
+			power-role = "dual";
+			data-role = "dual";
+			try-power-role = "sink";
+			source-pdos = <PDO_FIXED(5000, 3000, PDO_FIXED_USB_COMM)>;
+			sink-pdos = <PDO_FIXED(5000, 3000, PDO_FIXED_USB_COMM)
+					PDO_VAR(5000, 20000, 3000)>;
+			op-sink-microwatt = <15000000>;
+			self-powered;
+		};
+	};
+};
+
+&lpi2c3 {
+	#address-cells = <1>;
+	#size-cells = <0>;
+	clock-frequency = <400000>;
+	pinctrl-names = "default", "sleep";
+	pinctrl-0 = <&pinctrl_lpi2c3>;
+	pinctrl-1 = <&pinctrl_lpi2c3>;
+	status = "okay";
+ };
+
+&eqos {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pinctrl_eqos>;
+	phy-mode = "rgmii-id";
+	phy-handle = <&ethphy1>;
+	snps,reset-gpios = <&pca9555_20 0 GPIO_ACTIVE_LOW>;
+	snps,reset-delays-us = <10 20 200000>;
+	status = "okay";
+
+	mdio {
+		compatible = "snps,dwmac-mdio";
+		#address-cells = <1>;
+		#size-cells = <0>;
+		clock-frequency = <5000000>;
+
+		ethphy1: ethernet-phy@0 {
+			compatible = "ethernet-phy-ieee802.3-c22";
+			reg = <0>;
+			eee-broken-1000t;
+		};
+	};
+};
+
+&fec {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pinctrl_fec>;
+	phy-mode = "rgmii-id";
+	phy-handle = <&ethphy2>;
+	fsl,magic-packet;
+	phy-reset-gpios = <&pca9555_20 1 GPIO_ACTIVE_LOW>;
+	phy-reset-duration = <10>;
+	phy-reset-post-delay = <150>;
+	status = "okay";
+
+	mdio {
+		#address-cells = <1>;
+		#size-cells = <0>;
+		clock-frequency = <5000000>;
+
+		ethphy2: ethernet-phy@1 {
+			compatible = "ethernet-phy-ieee802.3-c22";
+			reg = <1>;
+			eee-broken-1000t;
+		};
+	};
+};
+ 
+&usbotg1 {
+	 dr_mode = "otg";
+	 hnp-disable;
+	 srp-disable;
+	 adp-disable;
+	 usb-role-switch;
+	 disable-over-current;
+	 samsung,picophy-pre-emp-curr-control = <3>;
+	 samsung,picophy-dc-vol-level-adjust = <7>;
+	 status = "okay";
+ 
+	 port {
+		 usb1_drd_sw: endpoint {
+			 remote-endpoint = <&typec1_dr_sw>;
+		 };
+	 };
+};
+
+&usbotg2 {
+	 dr_mode = "otg";
+	 hnp-disable;
+	 srp-disable;
+	 adp-disable;
+	 usb-role-switch;
+	 disable-over-current;
+	 samsung,picophy-pre-emp-curr-control = <3>;
+	 samsung,picophy-dc-vol-level-adjust = <7>;
+	 status = "okay";
+ 
+	 port {
+		 usb2_drd_sw: endpoint {
+			 remote-endpoint = <&typec2_dr_sw>;
+		 };
+	 };
+};
+ 
+&usdhc2 {
+	 pinctrl-names = "default", "state_100mhz", "state_200mhz";
+	 pinctrl-0 = <&pinctrl_usdhc2>, <&pinctrl_usdhc2_gpio>;
+	 pinctrl-1 = <&pinctrl_usdhc2>, <&pinctrl_usdhc2_gpio>;
+	 pinctrl-2 = <&pinctrl_usdhc2>, <&pinctrl_usdhc2_gpio>;
+	 vmmc-supply = <&reg_usdhc2_vmmc>;
+ 	 vqmmc-supply = <&reg_usdhc2_vddio>; // Force 1.8VDDIO see i.MX93 errata ERR052674 https://www.nxp.com/docs/en/errata/i.MX93_1P87f.pdf
+	 cd-gpios = <&gpio3 00 GPIO_ACTIVE_LOW>;
+	 bus-width = <4>;
+	 status = "okay";
+	 no-sdio;
+	 no-mmc;
+};
+
+&adc1 {
+	status = "okay";
+};
+
+&lcdif {
+	status = "disabled";
+};
+
+&ldb {
+	status = "disabled";
+};
+
+&dphy {
+	status = "disabled";
+};
+
+&dsi {
+	status = "disabled";
+};
+
+&lpuart2 { /* Mikrobus UART */
+	pinctrl-names = "default";
+	pinctrl-0 = <&pinctrl_uart2>;
+	status = "okay";
+};
+
+&lpuart6 {
+	pinctrl-names = "default";
