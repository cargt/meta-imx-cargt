From 90c13e984499d928e5fc8dbd4918f4bd330ae3c8 Mon Sep 17 00:00:00 2001
From: Tim Carney <tim.carney@cargt.com>
Date: Thu, 23 Jul 2026 09:13:16 -0500
Subject: [PATCH] Fix MIPI-DSI panel init ordering, host clock timing, and
 panel orientation on i.MX8MP/i.MX93

Enable the sec-dsim DSI host's esc/byte clock before calling
drm_panel_prepare() instead of after: panels commonly send DCS init
commands from ->prepare(), and those need a live escape/byte clock to
go out at all. Move the ili9881c panel's DCS init sequence back into
->prepare() to match, since it no longer needs to wait for ->enable().
This fixes MIPI-DSI failing to come up on i.MX8MP (-EBUSY/FIFO
timeouts) and on i.MX93 (command-FIFO write timeouts caused by sending
LP commands while dw-mipi-dsi was already in video mode).

Also call drm_connector_set_orientation_from_panel() from
sec_mipi_dsim_bind(), before drm_dev_register(), so the panel
orientation property is created at the correct point in the connector
lifecycle. Creating it after registration (as ili9881c_get_modes()
does as a legacy fallback) trips WARN_ON() in drm_mode_object_add()
and drm_object_attach_property() once a rotation property is present
in the device tree.

Add the missing power-supply reference for the GLT0557201280IS1 panel
on 00377-00365 so it uses the board's LVDS 3.3V rail instead of a
dummy regulator.
---
 ...mp-cargt-00377-00365-glt0557201280is1.dtsi |  2 ++
 drivers/gpu/drm/bridge/sec-dsim.c             | 27 ++++++++++++++++---
 drivers/gpu/drm/panel/panel-ilitek-ili9881c.c | 11 ++++----
 3 files changed, 32 insertions(+), 8 deletions(-)

diff --git a/arch/arm64/boot/dts/freescale/imx8mp-cargt-00377-00365-glt0557201280is1.dtsi b/arch/arm64/boot/dts/freescale/imx8mp-cargt-00377-00365-glt0557201280is1.dtsi
index 8916704dd98f..63c6444851c0 100644
--- a/arch/arm64/boot/dts/freescale/imx8mp-cargt-00377-00365-glt0557201280is1.dtsi
+++ b/arch/arm64/boot/dts/freescale/imx8mp-cargt-00377-00365-glt0557201280is1.dtsi
@@ -105,7 +105,9 @@ panel@0 {
 		compatible = "globaltech,glt0557201280is1", "ilitek,ili9881c";
 		reg = <0>;
 		backlight = <&pwm_backlight>;
+		power-supply = <&reg_lvds_vdd>;
 		reset-gpios = <&pca9555_20 3 GPIO_ACTIVE_LOW>;
+		rotation = <90>;
 		status = "okay";
 
 		port {
diff --git a/drivers/gpu/drm/bridge/sec-dsim.c b/drivers/gpu/drm/bridge/sec-dsim.c
index 8a63f345582d..576743334fa6 100644
--- a/drivers/gpu/drm/bridge/sec-dsim.c
+++ b/drivers/gpu/drm/bridge/sec-dsim.c
@@ -1370,6 +1370,15 @@ sec_mipi_dsim_bridge_atomic_enable(struct drm_bridge *bridge,
 	/* initialize FIFO pointers */
 	sec_mipi_dsim_init_fifo_pointers(dsim);
 
+	/*
+	 * config esc clock, byte clock and etc - must happen before
+	 * drm_panel_prepare(): panels commonly send DCS init commands
+	 * from ->prepare(), and those need the escape/byte clock live
+	 * to go out at all. Doing this after prepare() (as this driver
+	 * used to) leaves ->prepare() with no working DSI link.
+	 */
+	sec_mipi_dsim_config_clkctrl(dsim);
+
 	/* prepare panel if exists */
 	if (dsim->panel) {
 		ret = drm_panel_prepare(dsim->panel);
@@ -1379,9 +1388,6 @@ sec_mipi_dsim_bridge_atomic_enable(struct drm_bridge *bridge,
 		}
 	}
 
-	/* config esc clock, byte clock and etc */
-	sec_mipi_dsim_config_clkctrl(dsim);
-
 	/* enable panel if exists */
 	if (dsim->panel) {
 		ret = drm_panel_enable(dsim->panel);
@@ -2097,6 +2103,21 @@ int sec_mipi_dsim_bind(struct device *dev, struct device *master, void *data,
 		ret = drm_connector_attach_encoder(connector, encoder);
 		if (ret)
 			goto cleanup_connector;
+
+		/*
+		 * Must happen before drm_dev_register(): once the device is
+		 * registered, creating/attaching the "panel orientation"
+		 * property here trips WARN_ON()s in drm_mode_object_add()
+		 * and drm_object_attach_property(). ili9881c_get_modes()
+		 * (and other panel drivers) call drm_connector_set_panel_orientation()
+		 * again later as a legacy fallback, but that becomes a no-op
+		 * once it's already been set here.
+		 */
+		ret = drm_connector_set_orientation_from_panel(connector,
+								dsim->panel);
+		if (ret)
+			dev_warn(dev, "failed to set panel orientation: %d\n",
+				 ret);
 	}
 
 	dev_dbg(dev, "sec-dsim bridge bind end\n");
diff --git a/drivers/gpu/drm/panel/panel-ilitek-ili9881c.c b/drivers/gpu/drm/panel/panel-ilitek-ili9881c.c
index 941626fcaa77..58ba4488742d 100644
--- a/drivers/gpu/drm/panel/panel-ilitek-ili9881c.c
+++ b/drivers/gpu/drm/panel/panel-ilitek-ili9881c.c
@@ -1105,28 +1105,29 @@ static int ili9881c_prepare(struct drm_panel *panel)
 		}
 
 		if (ret) {
-			printk(KERN_ERR "ili9881c_enable: init sequence failed at step %u: %d\n", i, ret);
+			printk(KERN_ERR "ili9881c_prepare: init sequence failed at step %u: %d\n", i, ret);
 			return ret;
 		}
 	}
 
 	ret = ili9881c_switch_page(ctx, 0);
 	if (ret) {
-		printk(KERN_ERR "ili9881c_enable: switch to page 0 failed: %d\n", ret);
+		printk(KERN_ERR "ili9881c_prepare: switch to page 0 failed: %d\n", ret);
 		return ret;
 	}
 
 	ret = mipi_dsi_dcs_set_tear_on(ctx->dsi, MIPI_DSI_DCS_TEAR_MODE_VBLANK);
 	if (ret) {
-		printk(KERN_ERR "ili9881c_enable: set_tear_on failed: %d\n", ret);
+		printk(KERN_ERR "ili9881c_prepare: set_tear_on failed: %d\n", ret);
 		return ret;
 	}
 
 	ret = mipi_dsi_dcs_exit_sleep_mode(ctx->dsi);
 	if (ret) {
-		printk(KERN_ERR "ili9881c_enable: exit_sleep_mode failed: %d\n", ret);
+		printk(KERN_ERR "ili9881c_prepare: exit_sleep_mode failed: %d\n", ret);
 		return ret;
-		}
+	}
+
 	return 0;
 }
 
-- 
