From 812f92fd7b9736e5b1d1a25a6f772af35fce0b3c Mon Sep 17 00:00:00 2001
From: Tim Carney <tim.carney@cargt.com>
Date: Tue, 18 Aug 2026 14:15:59 -0500
Subject: [PATCH] arm64: dts: imx8mp-cargt-00377-osm-som: boost uart1 clock for
 IW612 BT

uart1_root_clk defaults to 24MHz, but this UART IP needs the module
clock to be >=16x the target baud rate for reliable operation. At
3000000 baud (the IW612 BT core's operating rate), 24MHz only gives
8x oversampling, causing garbled or missing HCI responses
(Frame reassembly failed, Opcode 0x0c03 failed: -110) from
mfgcmd_bt_provision and btnxpuart alike.

Boost uart1 to 80MHz via SYS_PLL1_80M (26.7x oversampling at 3M),
matching NXP's own imx8mp-evk.dts reference and a known upstream fix
for the same issue on i.MX8M Plus DHCOM. Confirmed end-to-end via
mfgcmd_bt_provision (PASS: provisioning verified) and automatic
hci0 bring-up through the standard boot service sequence.
---
 .../dts/freescale/imx8mp-cargt-00377-osm-som.dtsi | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/arch/arm64/boot/dts/freescale/imx8mp-cargt-00377-osm-som.dtsi b/arch/arm64/boot/dts/freescale/imx8mp-cargt-00377-osm-som.dtsi
index c891fc231649..e543ed07a316 100644
--- a/arch/arm64/boot/dts/freescale/imx8mp-cargt-00377-osm-som.dtsi
+++ b/arch/arm64/boot/dts/freescale/imx8mp-cargt-00377-osm-som.dtsi
@@ -436,6 +436,21 @@ &uart1 {
 	pinctrl-0 = <&pinctrl_uart1>;
 	uart-has-rtscts;
 	status = "okay";
+	/*
+	 * uart1_root_clk defaults to 24MHz, but this UART IP needs the module
+	 * clock to be >=16x the baud rate for reliable operation. At 24MHz,
+	 * 3000000 baud only gets 8x oversampling, causing garbled/no HCI
+	 * responses from the IW612 BT core. Boost to 80MHz (26.7x) to match.
+	 */
+	assigned-clocks = <&clk IMX8MP_CLK_UART1>;
+	assigned-clock-parents = <&clk IMX8MP_SYS_PLL1_80M>;
+	assigned-clock-rates = <80000000>;
+
+	bluetooth {
+			compatible = "nxp,88w8997-bt";
+        	fw-init-baudrate = <3000000>;
+        	max-speed = <3000000>;
+		};
 };
 
 &uart2 {
