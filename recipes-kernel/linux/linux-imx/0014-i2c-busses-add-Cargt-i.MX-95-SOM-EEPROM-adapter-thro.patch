From ba0279a84f23d622b5dbe2d4ae3871cba854594e Mon Sep 17 00:00:00 2001
From: Tim Carney <tim.carney@cargt.com>
Date: Fri, 9 Oct 2026 16:28:56 -0500
Subject: [PATCH 14/14] i2c: busses: add Cargt i.MX 95 SOM EEPROM adapter
 through the System Manager

The Cargt i.MX 95 SOM EEPROM (M24C02 at 0x50) is on LPI2C1 with the
PMICs, which the System Manager owns. The Cargt SM exposes it as board
control BRD_SM_CTRL_EEPROM (SCMI MISC control ext get/set, 1-16 bytes
per call, writes within one 16-byte page).

Add an I2C adapter that forwards transfers for chip 0x50 to that
control, described by a "cargt,imx95-sm-eeprom-i2c" node, so the at24
driver and its sysfs eeprom file work as on the i.MX 93 SOMs.

Upstream-Status: Inappropriate [Cargt board specific]
---
 drivers/i2c/busses/Kconfig               |  12 ++
 drivers/i2c/busses/Makefile              |   1 +
 drivers/i2c/busses/i2c-cargt-sm-eeprom.c | 223 +++++++++++++++++++++++
 3 files changed, 236 insertions(+)
 create mode 100644 drivers/i2c/busses/i2c-cargt-sm-eeprom.c

diff --git a/drivers/i2c/busses/Kconfig b/drivers/i2c/busses/Kconfig
index a816aaef4eee..d1108e382ad1 100644
--- a/drivers/i2c/busses/Kconfig
+++ b/drivers/i2c/busses/Kconfig
@@ -511,6 +511,18 @@ config I2C_BRCMSTB
 
 	  If you do not need I2C interface, say N.
 
+config I2C_CARGT_SM_EEPROM
+	tristate "Cargt i.MX 95 SOM EEPROM through the System Manager"
+	depends on IMX_SCMI_MISC_EXT
+	help
+	  I2C adapter for the Cargt i.MX 95 SOM EEPROM. The EEPROM is on the
+	  PMIC I2C bus, which the System Manager owns; the Cargt SM gives
+	  access to it through a board control. Use the at24 driver on this
+	  adapter to read and write the EEPROM.
+
+	  This driver can also be built as a module. If so, the module
+	  will be called i2c-cargt-sm-eeprom.
+
 config I2C_CADENCE
 	tristate "Cadence I2C Controller"
 	depends on ARCH_ZYNQ || ARM64 || XTENSA || RISCV || COMPILE_TEST
diff --git a/drivers/i2c/busses/Makefile b/drivers/i2c/busses/Makefile
index 17558b1b9079..f0136a3febd1 100644
--- a/drivers/i2c/busses/Makefile
+++ b/drivers/i2c/busses/Makefile
@@ -45,6 +45,7 @@ obj-$(CONFIG_I2C_AU1550)	+= i2c-au1550.o
 obj-$(CONFIG_I2C_AXXIA)		+= i2c-axxia.o
 obj-$(CONFIG_I2C_BCM2835)	+= i2c-bcm2835.o
 obj-$(CONFIG_I2C_BCM_IPROC)	+= i2c-bcm-iproc.o
+obj-$(CONFIG_I2C_CARGT_SM_EEPROM)	+= i2c-cargt-sm-eeprom.o
 obj-$(CONFIG_I2C_CADENCE)	+= i2c-cadence.o
 obj-$(CONFIG_I2C_CBUS_GPIO)	+= i2c-cbus-gpio.o
 obj-$(CONFIG_I2C_CGBC)		+= i2c-cgbc.o
diff --git a/drivers/i2c/busses/i2c-cargt-sm-eeprom.c b/drivers/i2c/busses/i2c-cargt-sm-eeprom.c
new file mode 100644
index 000000000000..5e275813c568
--- /dev/null
+++ b/drivers/i2c/busses/i2c-cargt-sm-eeprom.c
@@ -0,0 +1,223 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Copyright 2026 Cargt
+ *
+ * I2C adapter for the Cargt i.MX 95 SOM EEPROM, reached through the System Manager.
+ *
+ * The SOM EEPROM (M24C02, 256 bytes, 16-byte pages, address 0x50) shares LPI2C1
+ * with the PMICs, which the i.MX 95 System Manager owns, so Linux cannot drive
+ * that bus. The Cargt SM exposes the EEPROM as board control BRD_SM_CTRL_EEPROM
+ * (SCMI i.MX MISC control ext get/set: addr = EEPROM offset, one byte per value
+ * word, up to 16 bytes per call, writes within one page; the SM waits out the
+ * write cycle). This driver presents it as an I2C adapter with one chip at
+ * 0x50, so the standard at24 driver and its sysfs "eeprom" file work.
+ */
+
+#include <linux/err.h>
+#include <linux/i2c.h>
+#include <linux/minmax.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/scmi_imx_protocol.h>
+#include <linux/scmi_protocol.h>
+
+#define SM_EEPROM_CHIP_ADDR	0x50
+#define SM_EEPROM_SIZE		256
+#define SM_EEPROM_PAGE		16
+#define SM_EEPROM_MAX_XFER	16
+
+/* BRD_SM_CTRL_EEPROM is board control 8 in the Cargt i.MX 95 SM */
+#define SM_EEPROM_CTRL_ID	(BIT(15) | 8)
+
+struct cargt_sm_eeprom {
+	struct i2c_adapter adap;
+	const struct scmi_imx_misc_proto_ops *ops;
+	struct scmi_protocol_handle *ph;
+	struct device_node *np;
+	unsigned int offset;	/* current address, for reads without an address write */
+};
+
+static int cargt_sm_eeprom_read(struct cargt_sm_eeprom *ee, unsigned int off,
+				u8 *buf, unsigned int len)
+{
+	u32 val[SM_EEPROM_MAX_XFER];
+	unsigned int i, n;
+	int ret;
+
+	if (off >= SM_EEPROM_SIZE || len > SM_EEPROM_SIZE - off)
+		return -EINVAL;
+
+	while (len) {
+		n = min_t(unsigned int, len, SM_EEPROM_MAX_XFER);
+		ret = ee->ops->misc_ctrl_ext_get(ee->ph, SM_EEPROM_CTRL_ID, off, n, val);
+		if (ret)
+			return ret;
+		for (i = 0; i < n; i++)
+			buf[i] = val[i];
+		off += n;
+		buf += n;
+		len -= n;
+	}
+
+	return 0;
+}
+
+static int cargt_sm_eeprom_write(struct cargt_sm_eeprom *ee, unsigned int off,
+				 const u8 *buf, unsigned int len)
+{
+	u32 val[SM_EEPROM_MAX_XFER];
+	unsigned int i, n;
+	int ret;
+
+	if (off >= SM_EEPROM_SIZE || len > SM_EEPROM_SIZE - off)
+		return -EINVAL;
+
+	while (len) {
+		/* The SM takes up to one page per call */
+		n = min_t(unsigned int, len, SM_EEPROM_PAGE - off % SM_EEPROM_PAGE);
+		for (i = 0; i < n; i++)
+			val[i] = buf[i];
+		ret = ee->ops->misc_ctrl_ext_set(ee->ph, SM_EEPROM_CTRL_ID, off, n, val);
+		if (ret)
+			return ret;
+		off += n;
+		buf += n;
+		len -= n;
+	}
+
+	return 0;
+}
+
+static int cargt_sm_eeprom_xfer(struct i2c_adapter *adap, struct i2c_msg *msgs,
+				int num)
+{
+	struct cargt_sm_eeprom *ee = i2c_get_adapdata(adap);
+	u8 probe;
+	int i, ret;
+
+	for (i = 0; i < num; i++)
+		if (msgs[i].addr != SM_EEPROM_CHIP_ADDR)
+			return -ENXIO;
+
+	/* Address write followed by a read */
+	if (num == 2 && !(msgs[0].flags & I2C_M_RD) && msgs[0].len == 1 &&
+	    (msgs[1].flags & I2C_M_RD)) {
+		ret = cargt_sm_eeprom_read(ee, msgs[0].buf[0], msgs[1].buf, msgs[1].len);
+		if (ret)
+			return ret;
+		ee->offset = msgs[0].buf[0] + msgs[1].len;
+		return num;
+	}
+
+	if (num != 1)
+		return -EOPNOTSUPP;
+
+	/* Read from the current address */
+	if (msgs[0].flags & I2C_M_RD) {
+		ret = cargt_sm_eeprom_read(ee, ee->offset, msgs[0].buf, msgs[0].len);
+		if (ret)
+			return ret;
+		ee->offset += msgs[0].len;
+		return 1;
+	}
+
+	/* Zero-length write: probe, a one-byte read checks the SM and the EEPROM */
+	if (!msgs[0].len) {
+		ret = cargt_sm_eeprom_read(ee, 0, &probe, 1);
+		return ret ? ret : 1;
+	}
+
+	/* Address only (sets the current address), or address + data */
+	ee->offset = msgs[0].buf[0];
+	if (msgs[0].len > 1) {
+		ret = cargt_sm_eeprom_write(ee, msgs[0].buf[0], msgs[0].buf + 1,
+					    msgs[0].len - 1);
+		if (ret)
+			return ret;
+		ee->offset += msgs[0].len - 1;
+	}
+
+	return 1;
+}
+
+static u32 cargt_sm_eeprom_func(struct i2c_adapter *adap)
+{
+	return I2C_FUNC_I2C;
+}
+
+static const struct i2c_algorithm cargt_sm_eeprom_algo = {
+	.xfer		= cargt_sm_eeprom_xfer,
+	.functionality	= cargt_sm_eeprom_func,
+};
+
+static int cargt_sm_eeprom_probe(struct scmi_device *sdev)
+{
+	const struct scmi_handle *handle = sdev->handle;
+	struct cargt_sm_eeprom *ee;
+	struct device_node *np;
+	int ret;
+
+	/* The adapter is described by its own node (alias i2c0, at24 child at 0x50) */
+	np = of_find_compatible_node(NULL, NULL, "cargt,imx95-sm-eeprom-i2c");
+	if (!np)
+		return -ENODEV;
+	if (!of_device_is_available(np)) {
+		of_node_put(np);
+		return -ENODEV;
+	}
+
+	ee = devm_kzalloc(&sdev->dev, sizeof(*ee), GFP_KERNEL);
+	if (!ee) {
+		of_node_put(np);
+		return -ENOMEM;
+	}
+
+	ee->ops = handle->devm_protocol_get(sdev, SCMI_PROTOCOL_IMX_MISC, &ee->ph);
+	if (IS_ERR(ee->ops)) {
+		of_node_put(np);
+		return PTR_ERR(ee->ops);
+	}
+
+	ee->np = np;
+	ee->adap.owner = THIS_MODULE;
+	ee->adap.algo = &cargt_sm_eeprom_algo;
+	ee->adap.dev.parent = &sdev->dev;
+	ee->adap.dev.of_node = np;
+	strscpy(ee->adap.name, "cargt-sm-eeprom", sizeof(ee->adap.name));
+	i2c_set_adapdata(&ee->adap, ee);
+
+	ret = i2c_add_adapter(&ee->adap);
+	if (ret) {
+		of_node_put(np);
+		return ret;
+	}
+
+	dev_set_drvdata(&sdev->dev, ee);
+	return 0;
+}
+
+static void cargt_sm_eeprom_remove(struct scmi_device *sdev)
+{
+	struct cargt_sm_eeprom *ee = dev_get_drvdata(&sdev->dev);
+
+	i2c_del_adapter(&ee->adap);
+	of_node_put(ee->np);
+}
+
+static const struct scmi_device_id cargt_sm_eeprom_id_table[] = {
+	{ SCMI_PROTOCOL_IMX_MISC, "cargt-sm-eeprom" },
+	{ },
+};
+MODULE_DEVICE_TABLE(scmi, cargt_sm_eeprom_id_table);
+
+static struct scmi_driver cargt_sm_eeprom_driver = {
+	.name = "cargt-sm-eeprom",
+	.probe = cargt_sm_eeprom_probe,
+	.remove = cargt_sm_eeprom_remove,
+	.id_table = cargt_sm_eeprom_id_table,
+};
+module_scmi_driver(cargt_sm_eeprom_driver);
+
+MODULE_AUTHOR("Tim Carney <tim.carney@cargt.com>");
+MODULE_DESCRIPTION("Cargt i.MX 95 SOM EEPROM I2C adapter through the System Manager");
+MODULE_LICENSE("GPL");
-- 
