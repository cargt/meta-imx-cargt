 .../freescale/imx8mp-cargt-00377-osm-som.dtsi |  18 +-
 7 files changed, 736 insertions(+), 550 deletions(-)
 create mode 100644 arch/arm64/boot/dts/freescale/imx8mp-cargt-00377-00365-glt1011280800is1.dts
 create mode 100644 arch/arm64/boot/dts/freescale/imx8mp-cargt-00377-00365-glt1011280800is1.dtsi
 create mode 100644 arch/arm64/boot/dts/freescale/imx8mp-cargt-00377-00365.dtsi

