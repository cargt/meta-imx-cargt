/*
 * Copyright 2026 Cargt
 *
 * GT Display GLT0557201280IS1-CTP 5.5" 720x1280 MIPI-DSI panel (ILI9881C)
 * with ILI2520 touch, on the 00414 SOM + 00365 carrier.
 *
 * Ported from imx93-cargt-00363-00365-glt0557201280is1.dtsi by OSM-L signal
 * name. On the 00414:
 *   PWM_0/DISP_BL_PWM (DSI_BL_PWM)   TPM5_CH0, GPIO_IO06
 *   SPI_A_CS0# (DSICT_nINT)          GPIO2_IO08, GPIO_IO08
 *   I2C_B (touch)                    LPI2C6
 * DSI_VDD_EN (P03) and DSICT_nRST (P04) are on the 00365 pca9555.
 *
 * On the 00414 the i.MX 95 DSI/CSI combo PHY lanes reach the OSM DSI pins
 * through a TMUX646 switch (U4) shared with OSM CSI_B. It is enabled by
 * DSI_nOE (XSPI1_DATA5, GPIO5_IO05, low = on) and set to DSI with
 * CSI_nDSI_SEL (XSPI1_DATA6, GPIO5_IO06, high = DSI; verified on hardware).
 */

/ {
	pwm_backlight: pwm-backlight {
		compatible = "pwm-backlight";
		pwms = <&tpm5 0 5000000 0>; /* 200 Hz */
		brightness-levels = <0 100>;
		num-interpolated-steps = <100>;
		default-brightness-level = <80>;
	};

	reg_dsi_vdd: regulator-dsi-vdd {
		compatible = "regulator-fixed";
		regulator-name = "dsi_vdd";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&pca9555_20 3 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-always-on;
	};
};

/*
 * Pixel clock from VIDEOPLL1: 500 MHz / 10 = exactly the panel's 50 MHz,
 * as on the NXP FRDM 50 MHz DSI panel. 445.33 MHz (49.48 MHz) gave a
 * visibly mistimed picture.
 */
&dpu {
	assigned-clocks = <&scmi_clk IMX95_CLK_DISP1PIX>,
			  <&scmi_clk IMX95_CLK_VIDEOPLL1_VCO>,
			  <&scmi_clk IMX95_CLK_VIDEOPLL1>;
	assigned-clock-parents = <&scmi_clk IMX95_CLK_VIDEOPLL1>;
	assigned-clock-rates = <0>, <3000000000>, <500000000>;
	status = "okay";
};

&display_pixel_link {
	status = "okay";
};

&pixel_interleaver {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	channel@0 {
		reg = <0>;
		status = "okay";
	};
};

&mipi_dsi {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	panel@0 {
		compatible = "globaltech,glt0557201280is1", "ilitek,ili9881c";
		reg = <0>;
		rotation = <90>;
		power-supply = <&reg_dsi_vdd>;
		backlight = <&pwm_backlight>;

		port {
			panel_in: endpoint {
				remote-endpoint = <&dsi_out>;
			};
		};
	};

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@1 {
			reg = <1>;

			dsi_out: endpoint {
				remote-endpoint = <&panel_in>;
			};
		};
	};
};

&lpi2c6 {
	touchscreen@41 {
		compatible = "ilitek,ili2520";
		reg = <0x41>;
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_touchscreen>;
		reset-gpios = <&pca9555_20 4 GPIO_ACTIVE_LOW>;
		interrupt-parent = <&gpio2>;
		interrupts = <8 IRQ_TYPE_LEVEL_LOW>;
		touchscreen-swapped-x-y;
		touchscreen-inverted-x;
		wakeup-source;
	};
};

&gpio5 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_dsi_mux>;

	dsi-noe-hog {
		gpio-hog;
		gpios = <5 GPIO_ACTIVE_HIGH>;
		output-low;
		line-name = "DSI_nOE";
	};

	csi-ndsi-sel-hog {
		gpio-hog;
		gpios = <6 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "CSI_nDSI_SEL";
	};
};

&tpm5 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_backlight_pwm>;
	status = "okay";
};

&scmi_iomuxc {
	pinctrl_backlight_pwm: backlight-pwmgrp {
		fsl,pins = <
			IMX95_PAD_GPIO_IO06__TPM5_CH0			0x51e	/* DSI_BL_PWM */
		>;
	};

	pinctrl_dsi_mux: dsimuxgrp {
		fsl,pins = <
			IMX95_PAD_XSPI1_DATA5__GPIO5_IO_BIT5		0x31e	/* DSI_nOE */
			IMX95_PAD_XSPI1_DATA6__GPIO5_IO_BIT6		0x31e	/* CSI_nDSI_SEL */
		>;
	};

	pinctrl_touchscreen: touchscreengrp {
		fsl,pins = <
			IMX95_PAD_GPIO_IO08__GPIO2_IO_BIT8		0x31e	/* DSICT_nINT */
		>;
	};
};
