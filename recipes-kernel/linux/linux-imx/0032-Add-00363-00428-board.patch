index 000000000000..63f0a98b4150
--- /dev/null
+++ b/arch/arm64/boot/dts/freescale/imx93-cargt-00363-00428-glt028240320is1.dts
@@ -0,0 +1,13 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * Copyright 2022 NXP
+ */
+
+/dts-v1/;
+
+#include "imx93-cargt-00363-00428.dts"
+#include "imx93-cargt-00363-00428-glt028240320is1.dtsi"
+
+/ {
+	model = "Cargt i.MX93 00363 OSM-L SOM on 00428 carrier board with 2.8in SPI Display(GLT028240320IS1-CTP)";
+};
diff --git a/arch/arm64/boot/dts/freescale/imx93-cargt-00363-00428-glt028240320is1.dtsi b/arch/arm64/boot/dts/freescale/imx93-cargt-00363-00428-glt028240320is1.dtsi
new file mode 100644
index 000000000000..4d3a02686f1b
--- /dev/null
+++ b/arch/arm64/boot/dts/freescale/imx93-cargt-00363-00428-glt028240320is1.dtsi
@@ -0,0 +1,96 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * Copyright 2022 NXP
+ */
+
+/ {
+	pwm_backlight: pwm_backlight {
+		compatible = "pwm-backlight";
+		pwms = <&tpm6 1 5000000 0>; // 200 Hz
+		brightness-levels = <0 100>;
+		num-interpolated-steps = <100>;
+		default-brightness-level = <80>;
+		status = "okay";
+	};
+};
+
+&lpspi8 {
+	fsl,spi-num-chipselects = <1>;
+	pinctrl-names = "default", "sleep";
+	pinctrl-0 = <&pinctrl_lpspi8>;
+	pinctrl-1 = <&pinctrl_lpspi8>;
+	cs-gpios = <&gpio2 12 GPIO_ACTIVE_LOW>;
+	status = "okay";
+
+	/delete-property/ dmas;
+	/delete-property/ dma-names;
+
+	display@0{
+		compatible = "gtdisplay,glt028240320IS1", "sitronix,st7789t3";
+		reg = <0>;
+		spi-max-frequency = <12000000>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&pinctrl_display_rst>;
+		dc-gpios = <&gpio1 7 GPIO_ACTIVE_HIGH>;
+		reset-gpios = <&gpio2 11 GPIO_ACTIVE_HIGH>;
+		backlight = <&pwm_backlight>;
+	};
+};
+
+
+&lpuart2 {
+	status = "disabled";
+};
+
+&tpm6 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pinctrl_backlight_pwm>;
+	status = "okay";
+};
+
+&lpi2c2 {
+	focaltech_touch: touchscreen@38 {
+		compatible = "focaltech,ft6236";
+		reg = <0x38>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&pinctrl_touch_io>;
+		interrupt-parent = <&gpio2>;
+		interrupts = <8 IRQ_TYPE_EDGE_FALLING>;
+        touchscreen-size-x = <240>;
+        touchscreen-size-y = <320>;
+		touchscreen-inverted-y;
+		reset-gpios = <&gpio1 6 GPIO_ACTIVE_LOW>;
+		wakeup-source;
+      };
+};
+
+&iomuxc {
+	pinctrl_lpspi8: lpspi8grp {
+		fsl,pins = <
+			MX93_PAD_GPIO_IO12__GPIO2_IO12      0x3fe
+			MX93_PAD_GPIO_IO13__LPSPI8_SIN      0x3fe
+			MX93_PAD_GPIO_IO14__LPSPI8_SOUT     0x3fe
+			MX93_PAD_GPIO_IO15__LPSPI8_SCK      0x3fe
+            MX93_PAD_UART2_TXD__GPIO1_IO07      0x3fe // Data Command Switch
+		>;
+	};
+
+	pinctrl_backlight_pwm: backlight-pwmgrp {
+		fsl,pins = <
+			MX93_PAD_GPIO_IO23__TPM6_CH1		0x2
+		>;
+	};
+
+	pinctrl_display_rst: displayrstgrp {
+		fsl,pins = <
+			MX93_PAD_GPIO_IO11__GPIO2_IO11		0x3fe // UBUS_RST
+		>;
+	};
+
+	pinctrl_touch_io: touchiogrp {
+		fsl,pins = <
+			MX93_PAD_UART2_RXD__GPIO1_IO06		0x3fe // RST
+			MX93_PAD_GPIO_IO08__GPIO2_IO08		0x3fe // INT
+		>;
+	};
+};
\ No newline at end of file
diff --git a/arch/arm64/boot/dts/freescale/imx93-cargt-00363-00428-glt0557201280is1.dts b/arch/arm64/boot/dts/freescale/imx93-cargt-00363-00428-glt0557201280is1.dts
new file mode 100644
index 000000000000..db0bc87b8f3c
--- /dev/null
+++ b/arch/arm64/boot/dts/freescale/imx93-cargt-00363-00428-glt0557201280is1.dts
@@ -0,0 +1,15 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * Copyright 2022 NXP
+ */
+
+ /dts-v1/;
+
+ #include <dt-bindings/usb/pd.h>
+ #include <dt-bindings/pwm/pwm.h>
+ #include "imx93-cargt-00363-00428.dts"
+ #include "imx93-cargt-00363-00428-glt0557201280is1.dtsi"
+ 
+/ {
+	model = "Cargt i.MX93 00428 carrier board with 5.5-in MIPI DSI Display(GLT0557201280IS1-CTP)";	
+};
diff --git a/arch/arm64/boot/dts/freescale/imx93-cargt-00363-00428-glt0557201280is1.dtsi b/arch/arm64/boot/dts/freescale/imx93-cargt-00363-00428-glt0557201280is1.dtsi
new file mode 100644
index 000000000000..8582e6cd786b
--- /dev/null
+++ b/arch/arm64/boot/dts/freescale/imx93-cargt-00363-00428-glt0557201280is1.dtsi
@@ -0,0 +1,102 @@
+ / {
+	 pwm_backlight: pwm_backlight {
+		compatible = "pwm-backlight";
+		pwms = <&tpm5 1 5000000 0>; // 200 Hz
+		brightness-levels = <0 100>;
+		num-interpolated-steps = <100>;
+		default-brightness-level = <80>;
+		status = "okay";
+	};
+};
+
+&lcdif {
+	status = "okay";
+	assigned-clock-rates = <445333333>, <148444444>, <400000000>, <133333333>;
+};
+
+&dphy {
+	status = "okay";
+};
+
+&dsi {
+	#address-cells = <1>;
+	#size-cells = <0>;
+	status = "okay";
+
+	panel@0 {
+		compatible = "globaltech,glt0557201280is1", "ilitek,ili9881c";
+		reg = <0>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&pinctrl_dsi_vdd_en>;
+		rotation = <90>;
+		reset-gpios = <&gpio1 12 GPIO_ACTIVE_LOW>;
+		backlight = <&pwm_backlight>;
+		status = "okay";
+
+		port {
+			panel_in: endpoint {
+				remote-endpoint = <&dsi_out>;
+			};
+		};
+	};
+
+	ports {
+		port@1 {
+			reg = <1>;
+
+			dsi_out: endpoint {
+				remote-endpoint = <&panel_in>;
+			};
+		};
+	};
+};
+
+&lpi2c3 {
+	status = "okay";
+
+	touchscreen@41 {
+		compatible = "ilitek,ili2520";
+		reg = <0x41>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&pinctrl_touchscreen>;
+		reset-gpios = <&gpio2 4 GPIO_ACTIVE_LOW>;
+		interrupt-parent = <&gpio1>;
+		interrupts = <11 IRQ_TYPE_LEVEL_LOW>;
+		touchscreen-swapped-x-y;
+		touchscreen-inverted-x;
+		wakeup-source;
+	};
+};
+
+&tpm5 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pinctrl_backlight_pwm>;
+	status = "okay";
+};
+
+&epxp {
+	status = "okay";
+};
+
+&iomuxc {
+
+	pinctrl_backlight_pwm: backlight-pwmgrp {
+		fsl,pins = <
+		MX93_PAD_GPIO_IO22__TPM5_CH1		0x2
+	>;
+	};
+
+	pinctrl_dsi_vdd_en: dsivddengrp {
+		fsl,pins = <
+			MX93_PAD_SAI1_TXC__GPIO1_IO12			0x31e // DSI_VDD_EN / panel RESET
+		>;
+	};
+
+	pinctrl_touchscreen: touchscreengrp {
+		fsl,pins = <
+			MX93_PAD_SAI1_TXFS__GPIO1_IO11			0x31e // DSICT_nINT
+			MX93_PAD_GPIO_IO04__GPIO2_IO04			0x31e // DSICT_nRST
+		>;
+	};
+};
diff --git a/arch/arm64/boot/dts/freescale/imx93-cargt-00363-00428.dts b/arch/arm64/boot/dts/freescale/imx93-cargt-00363-00428.dts
new file mode 100644
index 000000000000..6b990897745f
--- /dev/null
+++ b/arch/arm64/boot/dts/freescale/imx93-cargt-00363-00428.dts
@@ -0,0 +1,219 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * Copyright 2022 NXP
+ */
+
+/dts-v1/;
+
+#include <dt-bindings/usb/pd.h>
+#include "imx93-cargt-00363-osm-som.dts"
+
+/ {
+	model = "Cargt i.MX93 00363 OSM-L SOM on 00428 carrier board";
+
+	aliases {
+		rtc0 = &rtc_i2c;
+		rtc1 = &bbnsm_rtc;
+	};
+
+	reg_usb2_vbus: regulator-usb2-vbus {
+		pinctrl-names = "default";
+		pinctrl-0 = <&pinctrl_usb2_vbus>;
+		compatible = "regulator-fixed";
+		regulator-name = "USB2_VBUS_EN";
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		gpio = <&gpio2 9 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+	};
+};
+
+&lpi2c2 {
+	#address-cells = <1>;
+	#size-cells = <0>;
+	clock-frequency = <400000>;
+	pinctrl-names = "default", "sleep";
+	pinctrl-0 = <&pinctrl_lpi2c2>;
+	pinctrl-1 = <&pinctrl_lpi2c2>;
+	status = "okay";
+
+	ptn5110_51: tcpc@51 {
+		compatible = "nxp,ptn5110";
+		reg = <0x51>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&pinctrl_ptn5110_51>;
+		interrupt-parent = <&gpio2>;
+		interrupts = <10 IRQ_TYPE_LEVEL_LOW>;
+		status = "okay";
+
+		port {
+			typec1_dr_sw: endpoint {
+				remote-endpoint = <&usb1_drd_sw>;
+			};
+		};
+
+		connector {
+			compatible = "usb-c-connector";
+			label = "USB-C";
+			power-role = "dual";
+			data-role = "dual";
+			try-power-role = "sink";
+			source-pdos = <PDO_FIXED(5000, 3000, PDO_FIXED_USB_COMM)>;
+			sink-pdos = <PDO_FIXED(5000, 3000, PDO_FIXED_USB_COMM)
+					PDO_VAR(5000, 20000, 3000)>;
+			op-sink-microwatt = <15000000>;
+			self-powered;
+		};
+	};
+};
+
+&lpi2c3 {
+	#address-cells = <1>;
+	#size-cells = <0>;
+	clock-frequency = <400000>;
+	pinctrl-names = "default", "sleep";
+	pinctrl-0 = <&pinctrl_lpi2c3>;
+	pinctrl-1 = <&pinctrl_lpi2c3>;
+	status = "okay";
+ };
+
+&eqos {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pinctrl_eqos>, <&pinctrl_eth_rst>;
+	phy-mode = "rgmii-id";
+	phy-handle = <&ethphy1>;
+	snps,reset-gpios = <&gpio1 14 GPIO_ACTIVE_LOW>;
+	snps,reset-delays-us = <10 20 200000>;
+	status = "okay";
+
+	mdio {
+		compatible = "snps,dwmac-mdio";
+		#address-cells = <1>;
+		#size-cells = <0>;
+		clock-frequency = <5000000>;
+
+		ethphy1: ethernet-phy@0 {
+			compatible = "ethernet-phy-ieee802.3-c22";
+			reg = <0>;
+			eee-broken-1000t;
+		};
+	};
+};
+
+&usbotg1 {
+	 dr_mode = "otg";
+	 hnp-disable;
+	 srp-disable;
+	 adp-disable;
+	 usb-role-switch;
+	 disable-over-current;
+	 samsung,picophy-pre-emp-curr-control = <3>;
+	 samsung,picophy-dc-vol-level-adjust = <7>;
+	 status = "okay";
+
+	 port {
+		 usb1_drd_sw: endpoint {
+			 remote-endpoint = <&typec1_dr_sw>;
+		 };
+	 };
+};
+
+&usbotg2 {
+	 dr_mode = "host";
+	 disable-over-current;
+	 vbus-supply = <&reg_usb2_vbus>;
+	 samsung,picophy-pre-emp-curr-control = <3>;
+	 samsung,picophy-dc-vol-level-adjust = <7>;
+	 status = "okay";
+};
+
+&adc1 {
+	status = "okay";
+};
+
+&lcdif {
+	status = "disabled";
+};
+
+&ldb {
+	status = "disabled";
+};
+
+&dphy {
+	status = "disabled";
+};
+
+&dsi {
+	status = "disabled";
+};
+
+&lpuart2 { /* Mikrobus UART */
+	pinctrl-names = "default";
+	pinctrl-0 = <&pinctrl_uart2>;
+	status = "okay";
+};
+
+&lpuart6 {
+	status = "disabled";
+};
+
+&iomuxc {
+
+	pinctrl_eqos: eqosgrp {
+		fsl,pins = <
+			MX93_PAD_ENET1_MDC__ENET_QOS_MDC						0x50e
+			MX93_PAD_ENET1_MDIO__ENET_QOS_MDIO						0x50e
+			MX93_PAD_ENET1_RD0__ENET_QOS_RGMII_RD0					0x51e
+			MX93_PAD_ENET1_RD1__ENET_QOS_RGMII_RD1					0x51e
+			MX93_PAD_ENET1_RD2__ENET_QOS_RGMII_RD2					0x51e
+			MX93_PAD_ENET1_RD3__ENET_QOS_RGMII_RD3					0x51e
+			MX93_PAD_ENET1_RXC__CCM_ENET_QOS_CLOCK_GENERATE_RX_CLK	0x51e
+			MX93_PAD_ENET1_RX_CTL__ENET_QOS_RGMII_RX_CTL			0x51e
+			MX93_PAD_ENET1_TD0__ENET_QOS_RGMII_TD0					0x51e
+			MX93_PAD_ENET1_TD1__ENET_QOS_RGMII_TD1					0x51e
+			MX93_PAD_ENET1_TD2__ENET_QOS_RGMII_TD2					0x51e
+			MX93_PAD_ENET1_TD3__ENET_QOS_RGMII_TD3					0x51e
+			MX93_PAD_ENET1_TXC__CCM_ENET_QOS_CLOCK_GENERATE_TX_CLK	0x51e
+			MX93_PAD_ENET1_TX_CTL__ENET_QOS_RGMII_TX_CTL			0x51e
+		>;
+	};
+
+	pinctrl_eth_rst: ethrstgrp {
+		fsl,pins = <
+			MX93_PAD_SAI1_RXD0__GPIO1_IO14			0x31e /* ETH_A_RST */
+		>;
+	};
+
+	pinctrl_lpi2c2: lpi2c2grp {
+		fsl,pins = <
+			MX93_PAD_I2C2_SDA__LPI2C2_SDA			0x40000b9e
+			MX93_PAD_I2C2_SCL__LPI2C2_SCL			0x40000b9e
+		>;
+	};
+
+	pinctrl_lpi2c3: lpi2c3grp {
+		fsl,pins = <
+			MX93_PAD_GPIO_IO28__LPI2C3_SDA			0x40000b9e
+			MX93_PAD_GPIO_IO29__LPI2C3_SCL			0x40000b9e
+		>;
+	};
+
+	pinctrl_ptn5110_51: ptn5110_51grp {
+		fsl,pins = <
+			MX93_PAD_GPIO_IO10__GPIO2_IO10			0x31e
+		>;
+	};
+
+	pinctrl_usb2_vbus: usb2vbusgrp {
+		fsl,pins = <
+			MX93_PAD_GPIO_IO09__GPIO2_IO09			0x31e /* USB2_VBUS_EN */
+		>;
+	};
+
+	pinctrl_uart2: uart2grp {
+		fsl,pins = <
+			MX93_PAD_UART2_RXD__LPUART2_RX			0x31e
+			MX93_PAD_UART2_TXD__LPUART2_TX			0x31e
+		>;
+	};
+};
