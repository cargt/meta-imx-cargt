From 1928ed52ca635f8558a72b89dba63be8c569f6bc Mon Sep 17 00:00:00 2001
From: Tim Carney <tim.carney@cargt.com>
Date: Fri, 5 Jun 2026 15:24:38 -0500
Subject: [PATCH] Add support for second RS-232 UART (lpuart7) in device tree

---
 .../dts/freescale/imx93-cargt-00359-00406.dts  | 18 +++++++++++++++++-
 1 file changed, 17 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/freescale/imx93-cargt-00359-00406.dts b/arch/arm64/boot/dts/freescale/imx93-cargt-00359-00406.dts
index 76ad8308336d..813b84df85ed 100644
--- a/arch/arm64/boot/dts/freescale/imx93-cargt-00359-00406.dts
+++ b/arch/arm64/boot/dts/freescale/imx93-cargt-00359-00406.dts
@@ -186,13 +186,20 @@ usb2_drd_sw: endpoint {
 	};
 };
 
-&lpuart3 { /* RS-232 */
+&lpuart3 { /* RS-232 (1 of 2) */
 	pinctrl-names = "default";
 	pinctrl-0 = <&pinctrl_uart3>;
 	uart-has-rtscts;
 	status = "okay";
 };
 
+&lpuart7 { /* RS-232 (2 of 2) */
+	pinctrl-names = "default";
+	pinctrl-0 = <&pinctrl_uart7>;
+	uart-has-rtscts;
+	status = "okay";
+};
+
 &iomuxc {
 	
 	pinctrl_eqos: eqosgrp {
@@ -272,5 +279,14 @@ MX93_PAD_GPIO_IO16__LPUART3_CTS_B	  	0x31e
 			MX93_PAD_GPIO_IO17__LPUART3_RTS_B	   	0x31e	
 		>;
 	};
+	
+	pinctrl_uart7: uart7grp {
+		fsl,pins = <
+			MX93_PAD_GPIO_IO08__LPUART7_TX			0x31e
+			MX93_PAD_GPIO_IO09__LPUART7_RX			0x31e
+			MX93_PAD_GPIO_IO10__LPUART7_CTS_B	  	0x31e
+			MX93_PAD_GPIO_IO11__LPUART7_RTS_B	   	0x31e	
+		>;
+	};	
 };
  
\ No newline at end of file
-- 
2.34.1

