index 000000000000..93f6651519fe
--- /dev/null
+++ b/arch/arm64/boot/dts/freescale/imx93-cargt-00324-00326-glt0701024600is2.dts
@@ -0,0 +1,13 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * Copyright 2022 NXP
+ */
+
+ /dts-v1/;
+
+ #include "imx93-cargt-00324-00326.dts"
+ #include "imx93-cargt-00324-00326-glt0701024600is2.dtsi"
+ / {
+	 model = "Cargt i.MX93 00326 carrier board with 7in LVDS Display(GLT0701024600IS2-CTP)";
+ 
+ };
diff --git a/arch/arm64/boot/dts/freescale/imx93-cargt-00324-00326-glt0701024600is2.dtsi b/arch/arm64/boot/dts/freescale/imx93-cargt-00324-00326-glt0701024600is2.dtsi
new file mode 100644
index 000000000000..16ea95a4be91
--- /dev/null
+++ b/arch/arm64/boot/dts/freescale/imx93-cargt-00324-00326-glt0701024600is2.dtsi
@@ -0,0 +1,102 @@
+ / {
+	 lvds_backlight: lvds_backlight {
+		 compatible = "gpio-backlight";
+		 pinctrl-names = "default";
+		 pinctrl-0 = <&pinctrl_backlight_lvds>;
+		 gpios = <&gpio2 8 GPIO_ACTIVE_HIGH>;
+		 default-on;
+		 status = "okay";
+	 };
+ 
+	 lvds_panel {		
+		 compatible = "globaltech,gt_GLT0701024600IS2";
+		 backlight = <&lvds_backlight>;
+		 enable-gpios = <&pca9555 4 GPIO_ACTIVE_HIGH>; 
+ 
+		 port {
+			 panel_lvds_in: endpoint {
+				 remote-endpoint = <&lvds_out>;
+			 };
+		 };
+	 };
+	 
+ };
+ 
+ &dphy {
+	 status = "disabled";
+ };
+ 
+ &dsi {
+	 status = "disabled";
+ };
+ 
+ &lcdif {
+	 assigned-clock-rates = <300000000>, <121000000>, <400000000>, <133333333>;
+ };
+ 
+ &ldb {
+	 status = "okay";
+ 
+	 lvds-channel@0 {
+		 status = "okay";
+ 
+		 port@1 {
+			 reg = <1>;
+ 
+			 lvds_out: endpoint {
+				 remote-endpoint = <&panel_lvds_in>;
+			 };
+		 };
+	 };
+ };
+ 
+ &ldb_phy {
+	 status = "okay";
+ };
+ 
+ &lpi2c1 {
+	 gt911@5d {
+		 compatible = "goodix,gt911";
+		 reg = <0x5d>;
+		 pinctrl-0 = <&pinctrl_cap_touch>;			
+		 interrupt-parent = <&gpio2>;
+		 interrupts = <9 IRQ_TYPE_EDGE_FALLING>;
+		 irq-gpios = <&gpio2 9 GPIO_ACTIVE_HIGH>;	//the driver uses this line to set the i2c address during initialization
+		 reset-gpios = <&gpio2 10 GPIO_ACTIVE_LOW>;
+		 status = "okay";
+	 };	
+ };
+ 
+ &lpi2c1 {
+ 
+	 /* eeprom on display */
+	 eeprom@50 {
+		 compatible = "atmel,24c02";
+		 reg = <0x50>;
+		 pagesize = <16>;		
+	 };
+ 
+ };
+ 
+ 
+ 
+ &iomuxc {
+ 
+	 pinctrl_backlight_lvds: backlight-lvds1grp {
+		 fsl,pins = <
+			 MX93_PAD_GPIO_IO08__GPIO2_IO08		0x31e
+		 >;
+	 };
+ 
+	 pinctrl_cap_touch: cap_touch {
+		 fsl,pins = <			    
+			 MX93_PAD_GPIO_IO09__GPIO2_IO09 		0x31e	/* nINT */
+			 MX93_PAD_GPIO_IO10__GPIO2_IO10 		0x31e	/* nRST */
+			 MX93_PAD_GPIO_IO11__GPIO2_IO11 		0x31e	/* WAKE */					 	
+		 >;
+	 };
+ 
+ 
+ };
+ 
+ 
\ No newline at end of file
diff --git a/arch/arm64/boot/dts/freescale/imx93-cargt-00324-00326-glt1011280800is1.dts b/arch/arm64/boot/dts/freescale/imx93-cargt-00324-00326-glt1011280800is1.dts
