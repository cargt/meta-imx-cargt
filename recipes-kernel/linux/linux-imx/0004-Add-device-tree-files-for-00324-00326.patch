+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * Copyright 2022 NXP
+ */
+
+ /dts-v1/;
+
+ #include <dt-bindings/usb/pd.h>
+ #include <dt-bindings/pwm/pwm.h>
+ #include "imx93-cargt-00324-00326.dts"
+ #include "imx93-cargt-00324-00326-glt1011280800is1.dtsi"
+ 
+/ {
+	model = "Cargt i.MX93 00326 carrier board with 10-in LVDS Display(GLT10111280800IS1-CTP)";
+};
diff --git a/arch/arm64/boot/dts/freescale/imx93-cargt-00324-00326-glt1011280800is1.dtsi b/arch/arm64/boot/dts/freescale/imx93-cargt-00324-00326-glt1011280800is1.dtsi
new file mode 100644
index 000000000000..1158fec90f61
--- /dev/null
+++ b/arch/arm64/boot/dts/freescale/imx93-cargt-00324-00326-glt1011280800is1.dtsi
@@ -0,0 +1,126 @@
+/ {
+
+	lvds_backlight: lvds_backlight {
+		compatible = "gpio-backlight";
+		pinctrl-names = "default";
+		pinctrl-0 = <&pinctrl_backlight_lvds>;
+		gpios = <&gpio2 8 GPIO_ACTIVE_HIGH>;
+		default-on;
+		status = "okay";
+	};
+
+	lvds_panel {
+		compatible = "boe,ev121wxm-n10-1850";
+		backlight = <&lvds_backlight>;		
+		power-supply = <&DISPLAY_reg>;
+
+		port {
+			panel_lvds_in: endpoint {
+				remote-endpoint = <&lvds_out>;
+			};
+		};
+	};
+
+	reg_lcd_pwr_en: regulator_lcd_pwr_en {
+		compatible = "regulator-fixed";
+		regulator-name = "lcd-pwr-en";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		gpio = <&pca9555 4 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		regulator-always-on;
+	};
+	
+};
+
+&dphy {
+	status = "disabled";
+};
+
+&dsi {
+	status = "disabled";
+};
+
+&lcdif {
+	assigned-clock-rates = <498000000>, <71142857>, <400000000>, <133333333>;
+};
+
+&ldb {
+	status = "okay";
+
+	lvds-channel@0 {
+		status = "okay";
+
+		port@1 {
+			reg = <1>;
+
+			lvds_out: endpoint {
+				remote-endpoint = <&panel_lvds_in>;
+			};
+		};
+	};
+};
+
+&ldb_phy {
+	status = "okay";
+};
+
+&lpi2c1 {
+	touchscreen@41 {
+		compatible = "ilitek,ili251x";
+		reg = <0x41>;
+		pinctrl-names = "default";
+		pinctrl-0 =<&pinctrl_cap_touch>;
+		interrupt-parent = <&gpio2>;
+		interrupts = <9 IRQ_TYPE_EDGE_FALLING>;
+		reset-gpios = <&gpio2 10 GPIO_ACTIVE_LOW>;
+		// touchscreen-size-x = <1280>;
+		// touchscreen-size-y = <800>;
+	};
+};
+
+&lpi2c1 {
+
+	/* eeprom on display */
+	eeprom@50 {
+		compatible = "atmel,24c02";
+		reg = <0x54>;
+		pagesize = <16>;		
+	};
+
+	max25221: max25221@21 {
+		compatible = "maxim,max25221";
+		reg = <0x21>;
+		lcd-supply = <&reg_lcd_pwr_en>;
+		status = "okay";
+
+		regulators {
+			DISPLAY_reg: DISPLAY {
+				regulator-name = "DISPLAY";
+			};
+		};
+	};
+
+};
+
+
+
+&iomuxc {
+
+	pinctrl_backlight_lvds: backlight-lvds1grp {
+		fsl,pins = <
+			MX93_PAD_GPIO_IO08__GPIO2_IO08		0x31e
+		>;
+	};
+
+	pinctrl_cap_touch: cap_touch {
+		fsl,pins = <			    
+			MX93_PAD_GPIO_IO09__GPIO2_IO09 		0x31e	/* nINT */
+			MX93_PAD_GPIO_IO10__GPIO2_IO10 		0x31e	/* nRST */
+			MX93_PAD_GPIO_IO11__GPIO2_IO11 		0x31e	/* WAKE */					 	
+		>;
+	};
+
+
+};
+
diff --git a/arch/arm64/boot/dts/freescale/imx93-cargt-00324-00326.dts b/arch/arm64/boot/dts/freescale/imx93-cargt-00324-00326.dts
new file mode 100644
index 000000000000..b7eae16f0668
--- /dev/null
+++ b/arch/arm64/boot/dts/freescale/imx93-cargt-00324-00326.dts
@@ -0,0 +1,424 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * Copyright 2022 NXP
+ */
+
+ /dts-v1/;
+
+ #include <dt-bindings/usb/pd.h>
+ #include "imx93-cargt-00324.dtsi"
+ 
+ / {
+	 model = "Cargt i.MX93 00324 SODIMM SOM on 00326 carrier board";
+
+	 reg_vref_3v3: regulator-ext-adc-vref {
+		compatible = "regulator-fixed";
+		regulator-name = "vref_3v3";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		regulator-always-on;
+	};
+
+	 reg_can1_stby: regulator-can1-stby {
+		 compatible = "regulator-fixed";
+		 regulator-name = "can1-stby";
+		 regulator-min-microvolt = <3300000>;
+		 regulator-max-microvolt = <3300000>;
+		 gpio = <&pca9555 2 GPIO_ACTIVE_LOW>;
+		 enable-active-low;
+	 };
+ 
+	 reg_can2_stby: regulator-can2-stby {
+		 compatible = "regulator-fixed";
+		 regulator-name = "can2-stby";
+		 regulator-min-microvolt = <3300000>;
+		 regulator-max-microvolt = <3300000>;
+		 gpio = <&pca9555 3 GPIO_ACTIVE_LOW>;
+		 enable-active-low;
+	 };
+
+	 wm8524: audio-codec {
+		 #sound-dai-cells = <0>;
+		 compatible = "wlf,wm8524";
+		 wlf,mute-gpios = <&pca9555 0 GPIO_ACTIVE_LOW>; 
+		 clocks = <&clk IMX93_CLK_SAI1>;
+		 clock-names = "mclk";
+		 status = "okay";
+	 };
+ 
+	 sound-wm8524 {
+		 compatible = "simple-audio-card";
+		 simple-audio-card,name = "wm8524-audio";
+		 simple-audio-card,format = "i2s";
+		 simple-audio-card,frame-master = <&cpudai>;
+		 simple-audio-card,bitclock-master = <&cpudai>;
+		 simple-audio-card,widgets =
+			 "Line", "Left Line Out Jack",
+			 "Line", "Right Line Out Jack";
+		 simple-audio-card,routing =
+			 "Left Line Out Jack", "LINEVOUTL",
+			 "Right Line Out Jack", "LINEVOUTR";
+ 
+		 status = "okay";
+ 
+		 cpudai: simple-audio-card,cpu {
+			 sound-dai = <&sai1>;
+			 dai-tdm-slot-num = <2>;
+			 dai-tdm-slot-width = <32>;
+		 };
+ 
+		 simple-audio-card,codec {
+			 sound-dai = <&wm8524>;
+			 //clocks = <&audio_blk_ctrl IMX8MP_CLK_AUDIO_BLK_CTRL_SAI1_MCLK1>;
+		 };
+	 };
+ 
+	 humidity_sensor {
+		compatible = "dht11";
+		pinctrl-0 = <&pinctrl_dht11>;
+		gpios = <&gpio2 20 GPIO_ACTIVE_HIGH>;
+		status = "okay";
+     };
+
+	 aliases {
+		 rtc0 = &rtc_i2c;
+		 rtc1 = &bbnsm_rtc;
+	 };
+ };
+
+ &wdog3 {
+	status = "okay";
+ };
+ 
+ &flexcan1 {
+	 pinctrl-names = "default";
+	 pinctrl-0 = <&pinctrl_flexcan1>;
+	 xceiver-supply = <&reg_can1_stby>;
+	 status = "okay";
+ };
+ 
+ &flexcan2 {
+	 pinctrl-names = "default";
+	 pinctrl-0 = <&pinctrl_flexcan2>;
+	 xceiver-supply = <&reg_can2_stby>;
+	 status = "okay";
+ };
+
+ &lpi2c2 {
+	 pca9555: pca9555@20 {
+		 compatible = "nxp,pca9555";
+		 pinctrl-0 = <&pinctrl_pca0>;
+		 gpio-controller;
+		 #gpio-cells = <2>;
+		 reg = <0x20>;
+		 interrupt-parent = <&gpio2>;
+		 interrupts = <13 IRQ_TYPE_LEVEL_LOW>;		
+	 };
+ 
+	 adc@13 {
+		 compatible = "ti,tla2528";
+		 reg = <0x13>;
+		 vref-supply = <&reg_vref_3v3>;
+	 };
+ 
+	 adc@14 {
+		 compatible = "ti,tla2528";
+		 reg = <0x14>;
+		 vref-supply = <&reg_vref_3v3>;
+	 };
+ 
+	 rtc_i2c: rtc@32 {
+		 compatible ="epson,rx8111";
+		 reg = <0x32>;
+	 };
+ 
+	 eeprom@50 {
+		 compatible = "atmel,24c02";
+		 reg = <0x50>;
+		 pagesize = <16>;		
+	 };
+ };
+ 
+ 
+ &lpi2c1 {
+	 #address-cells = <1>;
+	 #size-cells = <0>;
+	 clock-frequency = <100000>;
+	 pinctrl-names = "default", "sleep";
+	 pinctrl-0 = <&pinctrl_lpi2c1>;
+	 pinctrl-1 = <&pinctrl_lpi2c1>;
+	 status = "okay";
+ };
+ 
+ &lpi2c5 {
+	 #address-cells = <1>;
+	 #size-cells = <0>;
+	 clock-frequency = <100000>;
+	 pinctrl-names = "default", "sleep";
+	 pinctrl-0 = <&pinctrl_lpi2c5>;
+	 pinctrl-1 = <&pinctrl_lpi2c5>;
+	 status = "okay";
+ 
+	 ptn5110: tcpc@51 {
+		 compatible = "nxp,ptn5110";
+		 reg = <0x51>;
+		 pinctrl-names = "default";
+		 pinctrl-0 = <&pinctrl_ptn5110>;
+		 interrupt-parent = <&gpio2>;
+		 interrupts = <14 IRQ_TYPE_LEVEL_LOW>;	
+		 status = "okay";
+ 
+		 port {
+			 typec1_dr_sw: endpoint {
+				 remote-endpoint = <&usb1_drd_sw>;
+			 };
+		 };
+ 
+		 typec1_con: connector {
+			 compatible = "usb-c-connector";
+			 label = "USB-C";
+			 power-role = "dual";
+			 data-role = "dual";
+			 try-power-role = "sink";
+			 source-pdos = <PDO_FIXED(5000, 3000, PDO_FIXED_USB_COMM)>;
+			 sink-pdos = <PDO_FIXED(5000, 3000, PDO_FIXED_USB_COMM)
+					  PDO_VAR(5000, 20000, 3000)>;
+			 op-sink-microwatt = <15000000>;
+			 self-powered;
+		 };
+	 };
+ 
+	 ptn5110_2: tcpc@52 {
+		 compatible = "nxp,ptn5110";
+		 reg = <0x52>;
+		 pinctrl-names = "default";
+		 pinctrl-0 = <&pinctrl_ptn5110_2>;
+		 interrupt-parent = <&gpio2>;
+		 interrupts = <15 IRQ_TYPE_LEVEL_LOW>;			
+		 status = "okay";
+ 
+		 port {
+			 typec2_dr_sw: endpoint {
+				 remote-endpoint = <&usb2_drd_sw>;
+			 };
+		 };
+ 
+		 typec2_con: connector {
+			 compatible = "usb-c-connector";
+			 label = "USB-C";
+			 power-role = "dual";
+			 data-role = "dual";
+			 try-power-role = "sink";
+			 source-pdos = <PDO_FIXED(5000, 3000, PDO_FIXED_USB_COMM)>;
+			 sink-pdos = <PDO_FIXED(5000, 3000, PDO_FIXED_USB_COMM)
+					  PDO_VAR(5000, 20000, 3000)>;
+			 op-sink-microwatt = <15000000>;
+			 self-powered;
+		 };
+	 };
+ };
+ 
+ &usbotg1 {
+	 dr_mode = "otg";
+	 hnp-disable;
+	 srp-disable;
+	 adp-disable;
+	 usb-role-switch;
+	 disable-over-current;
+	 samsung,picophy-pre-emp-curr-control = <3>;
+	 samsung,picophy-dc-vol-level-adjust = <7>;
+	 status = "okay";
+ 
+	 port {
+		 usb1_drd_sw: endpoint {
+			 remote-endpoint = <&typec1_dr_sw>;
+		 };
+	 };
+ };
+ 
+ &usbotg2 {
+	 dr_mode = "otg";
+	 hnp-disable;
+	 srp-disable;
+	 adp-disable;
+	 usb-role-switch;
+	 disable-over-current;
+	 samsung,picophy-pre-emp-curr-control = <3>;
+	 samsung,picophy-dc-vol-level-adjust = <7>;
+	 status = "okay";
+ 
+	 port {
+		 usb2_drd_sw: endpoint {
+			 remote-endpoint = <&typec2_dr_sw>;
+		 };
+	 };
+ };
+ 
+ &usdhc2 {
+	 pinctrl-names = "default", "state_100mhz", "state_200mhz";
+	 pinctrl-0 = <&pinctrl_usdhc2>, <&pinctrl_usdhc2_gpio>;
+	 pinctrl-1 = <&pinctrl_usdhc2>, <&pinctrl_usdhc2_gpio>;
+	 pinctrl-2 = <&pinctrl_usdhc2>, <&pinctrl_usdhc2_gpio>;
+	 cd-gpios = <&gpio3 00 GPIO_ACTIVE_LOW>;
+	 bus-width = <4>;
+	 status = "okay";
+	 no-sdio;
+	 no-mmc;
+ };
+ 
+ &sai1 {
+	 #sound-dai-cells = <0>;
+	 pinctrl-names = "default";
+	 pinctrl-0 = <&pinctrl_sai1>;
+	 assigned-clocks = <&clk IMX93_CLK_SAI1>;
+	 assigned-clock-parents = <&clk IMX93_CLK_AUDIO_PLL>;
+	 assigned-clock-rates = <12288000>;
+	 status = "okay";
+ };
+
+ &lpuart5 { /* m.2 uart (bluetooth) */
+	pinctrl-names = "default";
+	assigned-clocks = <&clk IMX93_CLK_LPUART5>;
+	assigned-clock-parents = <&clk IMX93_CLK_24M>;
+	pinctrl-0 = <&pinctrl_uart5>;
+	fsl,uart-has-rtscts;
+	status = "okay";
+};
+
+&adc1 {
+	status = "okay";
+};
+
+// &lpspi4 {
+// 	fsl,spi-num-chipselects = <2>;
+// 	pinctrl-names = "default", "sleep";
+// 	pinctrl-0 = <&pinctrl_lpspi4>;
+// 	pinctrl-1 = <&pinctrl_lpspi4>;
+// 	cs-gpios = <&gpio2 18 GPIO_ACTIVE_LOW>,
+// 				<&gpio2 5 GPIO_ACTIVE_LOW>;
+// 	status = "okay";
+
+// 	spidev0: spi@0 {
+// 		reg = <0>;
+// 		compatible = "lwn,bk4";
+// 		spi-max-frequency = <1000000>;
+// 	};
+// };
+
+&pca9555 {
+	gpio-line-names =
+		"pca9555-0","pca9555-1","pca9555-2","pca9555-3", 		// 0-3
