From fbd942f4381c90ce424c14e92b4dcc366a8ee94c Mon Sep 17 00:00:00 2001
From: Tim Carney <tim.carney@cargt.com>
Date: Fri, 8 May 2026 09:12:16 -0500
Subject: [PATCH] Limit the maximum frequency for the SD Card to 104 MHz on the
 00365 for signal integrity issues.

Co-authored-by: Copilot <copilot@github.com>
---
 .../dts/freescale/imx93-cargt-00363-00365.dts | 31 +++++++++++++++++--
 1 file changed, 29 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/freescale/imx93-cargt-00363-00365.dts b/arch/arm64/boot/dts/freescale/imx93-cargt-00363-00365.dts
index 802f253bfa9d..31e511f4ae89 100644
--- a/arch/arm64/boot/dts/freescale/imx93-cargt-00363-00365.dts
+++ b/arch/arm64/boot/dts/freescale/imx93-cargt-00363-00365.dts
@@ -218,14 +218,15 @@ usb2_drd_sw: endpoint {
 &usdhc2 {
 	 pinctrl-names = "default", "state_100mhz", "state_200mhz";
 	 pinctrl-0 = <&pinctrl_usdhc2>, <&pinctrl_usdhc2_gpio>;
-	 pinctrl-1 = <&pinctrl_usdhc2>, <&pinctrl_usdhc2_gpio>;
-	 pinctrl-2 = <&pinctrl_usdhc2>, <&pinctrl_usdhc2_gpio>;
+	 pinctrl-1 = <&pinctrl_usdhc2_100mhz>, <&pinctrl_usdhc2_gpio>;
+	 pinctrl-2 = <&pinctrl_usdhc2_200mhz>, <&pinctrl_usdhc2_gpio>;
 	 vmmc-supply = <&reg_usdhc2_vmmc>;
 	 cd-gpios = <&gpio3 00 GPIO_ACTIVE_LOW>;
 	 bus-width = <4>;
 	 status = "okay";
 	 no-sdio;
 	 no-mmc;
+	 max-frequency = <104000000>; /* 104MHz is the max frequency for 00365 */
 };
 
 &adc1 {
@@ -341,6 +342,32 @@ MX93_PAD_SD2_CD_B__GPIO3_IO00		0x31e
 	};
  
 	pinctrl_usdhc2: usdhc2grp {
+		fsl,pins = <
+			 MX93_PAD_SD2_CLK__USDHC2_CLK		0x1582
+			 MX93_PAD_SD2_CMD__USDHC2_CMD		0x40001382
+			 MX93_PAD_SD2_DATA0__USDHC2_DATA0	0x40001382
+			 MX93_PAD_SD2_DATA1__USDHC2_DATA1	0x40001382
+			 MX93_PAD_SD2_DATA2__USDHC2_DATA2	0x40001382
+			 MX93_PAD_SD2_DATA3__USDHC2_DATA3	0x40001382
+			 MX93_PAD_SD2_VSELECT__USDHC2_VSELECT	0x51e
+		>;
+	 };
+
+	/* need to config the SION for data and cmd pad, refer to ERR052021 */
+	pinctrl_usdhc2_100mhz: usdhc2-100mhzgrp {
+		fsl,pins = <
+			 MX93_PAD_SD2_CLK__USDHC2_CLK		0x158e
+			 MX93_PAD_SD2_CMD__USDHC2_CMD		0x4000138e
+			 MX93_PAD_SD2_DATA0__USDHC2_DATA0	0x4000138e
+			 MX93_PAD_SD2_DATA1__USDHC2_DATA1	0x4000138e
+			 MX93_PAD_SD2_DATA2__USDHC2_DATA2	0x4000138e
+			 MX93_PAD_SD2_DATA3__USDHC2_DATA3	0x4000138e
+			 MX93_PAD_SD2_VSELECT__USDHC2_VSELECT	0x51e
+		>;
+	 };
+
+	/* need to config the SION for data and cmd pad, refer to ERR052021 */
+	pinctrl_usdhc2_200mhz: usdhc2-200mhzgrp {
 		fsl,pins = <
 			 MX93_PAD_SD2_CLK__USDHC2_CLK		0x15fe
 			 MX93_PAD_SD2_CMD__USDHC2_CMD		0x400013fe
