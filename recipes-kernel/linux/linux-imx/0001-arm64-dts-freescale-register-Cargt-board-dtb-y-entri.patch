From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tim Carney <tim.carney@cargt.com>
Date: Thu, 3 Sep 2026 00:00:00 -0500
Subject: [PATCH] arm64: dts: freescale: register Cargt board dtb-y entries

Consolidates the arch/arm64/boot/dts/freescale/Makefile hunks that used
to be scattered across patches 0001, 0004, 0006, 0007, 0013, 0022, 0024,
and 0027 into a single patch, now that those patches' device tree
content has been extracted into standalone files under
recipes-kernel/linux/linux-imx/files/dts/freescale/ instead. This is the
only place those patches touched anything outside of dts/dtsi content.

Net effect on the Makefile is identical to before this consolidation --
verified via matching dtb sha256sums against the pre-change baseline.

Upstream-Status: Inappropriate [Cargt board specific]
---
 arch/arm64/boot/dts/freescale/Makefile | 22 +++++++++++++++++++++-
 1 file changed, 21 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/freescale/Makefile b/arch/arm64/boot/dts/freescale/Makefile
index bb6bc733c7e5..f915fcc679c9 100644
--- a/arch/arm64/boot/dts/freescale/Makefile
+++ b/arch/arm64/boot/dts/freescale/Makefile
@@ -450,6 +450,11 @@ dtb-${CONFIG_ARCH_MXC} += imx8mp-frdm-waveshare-7inch-c-panel.dtb
 imx8mq-evk-pcie1-ep-dtbs += imx8mq-evk.dtb imx-pcie1-ep.dtbo
 dtb-$(CONFIG_ARCH_MXC) += imx8mq-evk-pcie1-ep.dtb

+dtb-$(CONFIG_ARCH_MXC) += imx8mp-cargt-00377-00365.dtb \
+				imx8mp-cargt-00377-00365-hdmi.dtb \
+				imx8mp-cargt-00377-00365-glt0557201280is1.dtb \
+				imx8mp-cargt-00377-00365-glt1011280800is1.dtb
+
 dtb-$(CONFIG_ARCH_MXC) += imx8mq-evk.dtb imx8mq-evk-rpmsg.dtb
 dtb-$(CONFIG_ARCH_MXC) += imx8mq-evk.dtb imx8mq-evk-rpmsg.dtb imx8mq-evk-pcie1-m2.dtb imx8mq-evk-usd-wifi.dtb \
 			  imx8mq-evk-usdhc2-m2.dtb
@@ -726,7 +731,10 @@ dtb-$(CONFIG_ARCH_MXC) += imx91-11x11-evk.dtb \
 			  imx91-11x11-evk-i2c-spi-slave.dtb \
 			  imx91-11x11-evk-i3c.dtb \
 			  imx91-11x11-evk-8mic-reve.dtb \
-			  imx91-11x11-evk-usbwifi.dtb
+			  imx91-11x11-evk-usbwifi.dtb \
+			  imx91-cargt-00363-osm-som.dtb \
+			  imx91-cargt-00363-00365.dtb \
+			  imx91-cargt-00363-00365-glt028240320is1.dtb

 imx93-11x11-evk-pmic-pf0900-dtbs := imx93-11x11-evk.dtb imx93-11x11-evk-pmic-pf0900.dtbo
 imx93-11x11-evk-pmic-pf0900-root-dtbs := imx93-11x11-evk-root.dtb imx93-11x11-evk-pmic-pf0900.dtbo
@@ -849,6 +856,18 @@ dtb-${CONFIG_ARCH_MXC} += imx8qxp-mek-max9286-rpmsg.dtb
 dtb-$(CONFIG_ARCH_MXC) += imx93-tqma9352-mba93xxca.dtb
 dtb-$(CONFIG_ARCH_MXC) += imx93-tqma9352-mba93xxla.dtb
 dtb-$(CONFIG_ARCH_MXC) += imx93-var-som-symphony.dtb
+
+dtb-$(CONFIG_ARCH_MXC) += imx93-cargt-00324-00326.dtb \
+				imx93-cargt-00324-00326-00375.dtb \
+				imx93-cargt-00324-00326-glt0701024600is2.dtb \
+				imx93-cargt-00324-00326-glt1011280800is1.dtb \
+				imx93-cargt-00324-00326-glt028240320is1.dtb \
+				imx93-cargt-00359-00406.dtb \
+				imx93-cargt-00363-00365.dtb \
+				imx93-cargt-00363-00365-glt0557201280is1.dtb \
+				imx93-cargt-00363-00365-glt1011280800is1.dtb \
+				imx93-cargt-00363-00365-glt028240320is1.dtb
+
 dtb-$(CONFIG_ARCH_MXC) += imx91-9x9-qsb.dtb \
 			  imx91-9x9-qsb-can1.dtb \
 			  imx91-9x9-qsb-flexspi-nand.dtb \
--
