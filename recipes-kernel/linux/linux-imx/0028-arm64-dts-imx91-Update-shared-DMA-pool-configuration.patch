From b09b47f8ff2fecc9d52ba206730287f4d5fc9315 Mon Sep 17 00:00:00 2001
From: Tim Carney <tim.carney@cargt.com>
Date: Thu, 4 Jun 2026 12:46:20 -0500
Subject: [PATCH 28/29] arm64: dts: imx91: Update shared DMA pool
 configurations and memory regions

---
 .../freescale/imx91-cargt-00363-osm-som.dts   | 43 +++----------------
 1 file changed, 6 insertions(+), 37 deletions(-)

diff --git a/arch/arm64/boot/dts/freescale/imx91-cargt-00363-osm-som.dts b/arch/arm64/boot/dts/freescale/imx91-cargt-00363-osm-som.dts
index 87002be65dbc..501a2f9bb59e 100644
--- a/arch/arm64/boot/dts/freescale/imx91-cargt-00363-osm-som.dts
+++ b/arch/arm64/boot/dts/freescale/imx91-cargt-00363-osm-som.dts
@@ -27,47 +27,16 @@ reserved-memory {
 		ranges;
 
 		linux,cma {
-		   compatible = "shared-dma-pool";
-		   reusable;
-		   alloc-ranges = <0 0x88000000 0 0x18000000>;
-		   size = <0 0xc000000>;
-		   linux,cma-default;
-	   };
-
-		 vdev0vring0: vdev0vring0@a4000000 {
-			reg = <0 0xa4000000 0 0x8000>;
-			no-map;
-		};
-
-		vdev0vring1: vdev0vring1@a4008000 {
-			reg = <0 0xa4008000 0 0x8000>;
-			no-map;
-		};
-
-		vdev1vring0: vdev1vring0@a4000000 {
-			reg = <0 0xa4010000 0 0x8000>;
-			no-map;
-		};
-
-		vdev1vring1: vdev1vring1@a4018000 {
-			reg = <0 0xa4018000 0 0x8000>;
-			no-map;
-		};
-
-	   rsc_table: rsc-table@2021e000 {
-			reg = <0 0x2021e000 0 0x1000>;
-			no-map;
-		};
-
-		vdevbuffer: vdevbuffer@a4020000 {
 			compatible = "shared-dma-pool";
-			reg = <0 0xa4020000 0 0x100000>;
-			no-map;
+			reusable;
+			alloc-ranges = <0 0x80000000 0 0x10000000>;
+			size = <0 0x2000000>;
+			linux,cma-default;
 		};
 
-		ele_reserved: ele-reserved@a4120000 {
+		ele_reserved: ele-reserved@84120000 {
 			compatible = "shared-dma-pool";
-			reg = <0 0xa4120000 0 0x100000>;
+			reg = <0 0x84120000 0 0x100000>;
 			no-map;
 		};
 	};
-- 
