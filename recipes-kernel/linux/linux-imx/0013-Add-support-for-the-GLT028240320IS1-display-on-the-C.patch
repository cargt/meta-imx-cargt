From d597cf2c1a9940db1457e052dc5b119a988fa136 Mon Sep 17 00:00:00 2001
From: Tim Carney <tim.carney@cargt.com>
Date: Wed, 22 Apr 2026 13:21:56 -0500
Subject: [PATCH] Add support for the GLT028240320IS1 display on the Cargt
 00365 carrier with the i.MX 93 00363 OSM-L SOM. This includes device tree and
 DRM driver support for Sitronix ST7789T3 display panels.

---
 .../bindings/display/sitronix,st7789t3.yaml   |  72 ++++
 arch/arm64/boot/dts/freescale/Makefile        |   3 +-
 ...mx93-cargt-00363-00365-glt028240320is1.dts |  13 +
 ...x93-cargt-00363-00365-glt028240320is1.dtsi |  89 +++++
 drivers/gpu/drm/tiny/Kconfig                  |  14 +
 drivers/gpu/drm/tiny/Makefile                 |   1 +
 drivers/gpu/drm/tiny/st7789t3.c               | 328 ++++++++++++++++++
 7 files changed, 519 insertions(+), 1 deletion(-)
 create mode 100644 Documentation/devicetree/bindings/display/sitronix,st7789t3.yaml
 create mode 100644 arch/arm64/boot/dts/freescale/imx93-cargt-00363-00365-glt028240320is1.dts
 create mode 100644 arch/arm64/boot/dts/freescale/imx93-cargt-00363-00365-glt028240320is1.dtsi
 create mode 100644 drivers/gpu/drm/tiny/st7789t3.c

diff --git a/Documentation/devicetree/bindings/display/sitronix,st7789t3.yaml b/Documentation/devicetree/bindings/display/sitronix,st7789t3.yaml
new file mode 100644
index 000000000000..54378cf3d94a
--- /dev/null
+++ b/Documentation/devicetree/bindings/display/sitronix,st7789t3.yaml
@@ -0,0 +1,72 @@
+# SPDX-License-Identifier: GPL-2.0-only
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/display/sitronix,st7735r.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Sitronix ST7789T3 Display Panels
+
+maintainers:
+  - Tim Carney <tim.carney@cargt.com>
+
+description:
+  This binding is for display panels using a Sitronix ST7789T3
+  controller in SPI mode. It is based on the Sitronix ST7735R
+  Display Panel driver from David Lechner <david@lechnology.com>
+
+
+allOf:
+  - $ref: panel/panel-common.yaml#
+  - $ref: /schemas/spi/spi-peripheral-props.yaml#
+
+properties:
+  compatible:
+    oneOf:
+      - description:
+          GT Display glt028240320IS1 2.8" 320x240 Color TFT LCD
+        items:
+          - enum:
+              - gtdisplay,glt028240320IS1
+          - const: sitronix,st7789t3
+
+  dc-gpios:
+    maxItems: 1
+    description: Display data/command selection (D/CX)
+
+  backlight: true
+  reg: true
+  spi-max-frequency: true
+  reset-gpios: true
+  rotation: true
+  disp_inversion: true
+
+required:
+  - compatible
+  - reg
+  - dc-gpios
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    backlight: backlight {
+            compatible = "gpio-backlight";
+            gpios = <&gpio 44 GPIO_ACTIVE_HIGH>;
+    };
+
+    spi {
+            #address-cells = <1>;
+            #size-cells = <0>;
+
+            display@0{
+              compatible = "gtdisplay,glt028240320IS1", "sitronix,st7789t3";
+              reg = <0>;
+              spi-max-frequency = <24000000>;
+              dc-gpios = <&gpio2 4 GPIO_ACTIVE_HIGH>;
+              reset-gpios = <&pca9555 1 GPIO_ACTIVE_HIGH>;
+            };
+    };
+
+...
