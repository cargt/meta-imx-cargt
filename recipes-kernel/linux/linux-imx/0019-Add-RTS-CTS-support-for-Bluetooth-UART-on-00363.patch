From 2d5e5e5d1c0cce9c11cd9fde6082bd771b221df2 Mon Sep 17 00:00:00 2001
From: Tim Carney <tim.carney@cargt.com>
Date: Wed, 22 Apr 2026 15:59:01 -0500
Subject: [PATCH] Add RTS/CTS support for Bluetooth UART on 00363.

---
 arch/arm64/boot/dts/freescale/imx93-cargt-00363-osm-som.dts | 1 +
 1 file changed, 1 insertion(+)

diff --git a/arch/arm64/boot/dts/freescale/imx93-cargt-00363-osm-som.dts b/arch/arm64/boot/dts/freescale/imx93-cargt-00363-osm-som.dts
index cf15c4fe9f4b..ec91f2329139 100644
--- a/arch/arm64/boot/dts/freescale/imx93-cargt-00363-osm-som.dts
+++ b/arch/arm64/boot/dts/freescale/imx93-cargt-00363-osm-som.dts
@@ -269,6 +269,7 @@ &lpuart1 { /* console */
 
 &lpuart5 { /* bluetooth */
 	pinctrl-names = "default";
+	uart-has-rtscts;
 	pinctrl-0 = <&pinctrl_uart5>;
 	status = "okay";
  };
-- 
2.34.1

