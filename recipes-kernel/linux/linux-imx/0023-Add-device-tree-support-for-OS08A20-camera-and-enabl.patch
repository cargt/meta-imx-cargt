From 17d2614b5c26b3abde05928c49d6a1c5b7328ccc Mon Sep 17 00:00:00 2001
From: Tim Carney <tim.carney@cargt.com>
Date: Tue, 28 Apr 2026 16:39:07 -0500
Subject: [PATCH] Add device tree support for OS08A20 camera and enable GPU
 components on i.MX8MP 00377 OSM-L SOM

Co-authored-by: Copilot <copilot@github.com>
---
 ...8mp-cargt-00377-00365-glt1011280800is1.dts |  1 +
 .../imx8mp-cargt-00377-00365-os08a20.dtsi     | 63 +++++++++++++++++++
 .../freescale/imx8mp-cargt-00377-00365.dtsi   | 16 +++++
 3 files changed, 80 insertions(+)
 create mode 100644 arch/arm64/boot/dts/freescale/imx8mp-cargt-00377-00365-os08a20.dtsi

diff --git a/arch/arm64/boot/dts/freescale/imx8mp-cargt-00377-00365-glt1011280800is1.dts b/arch/arm64/boot/dts/freescale/imx8mp-cargt-00377-00365-glt1011280800is1.dts
index 138bcd339109..344790a2197b 100644
--- a/arch/arm64/boot/dts/freescale/imx8mp-cargt-00377-00365-glt1011280800is1.dts
+++ b/arch/arm64/boot/dts/freescale/imx8mp-cargt-00377-00365-glt1011280800is1.dts
@@ -10,6 +10,7 @@
 #include <dt-bindings/phy/phy-imx8-pcie.h>
 #include "imx8mp-cargt-00377-00365.dtsi"
 #include "imx8mp-cargt-00377-00365-glt1011280800is1.dtsi"
+#include "imx8mp-cargt-00377-00365-os08a20.dtsi"
 
 / {
 	model = "Cargt i.MX8MP 00377 OSM-L SOM on 00365 carrier board with 10-in LVDS Display(GLT10111280800IS1-CTP)";
diff --git a/arch/arm64/boot/dts/freescale/imx8mp-cargt-00377-00365-os08a20.dtsi b/arch/arm64/boot/dts/freescale/imx8mp-cargt-00377-00365-os08a20.dtsi
new file mode 100644
index 000000000000..5e0716de0f72
--- /dev/null
+++ b/arch/arm64/boot/dts/freescale/imx8mp-cargt-00377-00365-os08a20.dtsi
@@ -0,0 +1,63 @@
+/ {
+	/* Placeholder camera node for board-specific OS08A20 bring-up. */
+};
+
+&i2c2 {
+	os08a20_0: os08a20_mipi@36 {
+		compatible = "ovti,os08a20_mipi";
+		reg = <0x36>;
+		reset-gpios = <&pca9555_20 7 GPIO_ACTIVE_HIGH>;
+		clocks = <&clk_dummy>;
+		clock-names = "csi_mclk";
+		csi_id = <0>;
+		mclk = <24000000>;
+		mclk_source = <0>;
+		status = "okay";
+
+		port {
+			os08a20_mipi_0_ep: endpoint {
+				data-lanes = <1 2 3 4>;
+				clock-lanes = <0>;
+				max-pixel-frequency = /bits/ 64 <500000000>;
+				remote-endpoint = <&mipi_csi0_ep>;
+			};
+		};
+	};
+};
+
+&cameradev {
+	status = "okay";
+};
+
+&isi_0 {
+	cap_device {
+		status = "disabled";
+	};
+};
+
+&isi_1 {
+	status = "disabled";
+};
+
+&isp_0 {
+	status = "okay";
+};
+
+&dewarp {
+	status = "okay";
+};
+
+&mipi_csi_0 {
+	#address-cells = <1>;
+	#size-cells = <0>;
+	status = "okay";
+
+	port@0 {
+		reg = <0>;
+		mipi_csi0_ep: endpoint {
+			remote-endpoint = <&os08a20_mipi_0_ep>;
+			data-lanes = <4>;
+			csis-hs-settle = <16>;
+		};
+	};
+};
diff --git a/arch/arm64/boot/dts/freescale/imx8mp-cargt-00377-00365.dtsi b/arch/arm64/boot/dts/freescale/imx8mp-cargt-00377-00365.dtsi
index 545b25cd609e..f5a1548a29a5 100644
--- a/arch/arm64/boot/dts/freescale/imx8mp-cargt-00377-00365.dtsi
+++ b/arch/arm64/boot/dts/freescale/imx8mp-cargt-00377-00365.dtsi
@@ -559,3 +559,19 @@ MX8MP_IOMUXC_SAI1_RXD0__GPIO4_IO02			0x10
 		>;
 	};
 };
+
+&gpu_3d {
+status = "okay";
+};
+
+&gpu_2d {
+status = "okay";
+};
+
+&ml_vipsi {
+status = "okay";
+};
+
+&mix_gpu_ml {
+status = "okay";
+};
-- 
2.34.1

