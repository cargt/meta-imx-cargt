From 5acd100767c34a0c646bfb8321d6b53e9eb854ec Mon Sep 17 00:00:00 2001
From: Tim Carney <tim.carney@cargt.com>
Date: Fri, 13 Feb 2026 15:26:47 -0600
Subject: [PATCH] Improve panel initialization error handling and reset logic
 in ili9881c driver.

Upstream-Status: Inappropriate [Cargt board specific]

Rebased 2026-07-17, same reason and same approach as the 0005 rebase this
patch stacks on: upstream's driver had been rewritten to use the
mipi_dsi_multi_context batched-transaction API in the time since this was
originally written. Re-expressed the same intent -- move the init
sequence, tear-on, and exit-sleep-mode back into .prepare, leaving only
the final msleep(120)+display-on toggle in .enable -- against the new API.
---
 drivers/gpu/drm/panel/panel-ilitek-ili9881c.c | 37 ++++++++++++++++--------
 1 file changed, 20 insertions(+), 17 deletions(-)

diff --git a/drivers/gpu/drm/panel/panel-ilitek-ili9881c.c b/drivers/gpu/drm/panel/panel-ilitek-ili9881c.c
index 60c1b3b86a4b..941626fcaa77 100644
--- a/drivers/gpu/drm/panel/panel-ilitek-ili9881c.c
+++ b/drivers/gpu/drm/panel/panel-ilitek-ili9881c.c
@@ -1846,6 +1846,8 @@
 static int ili9881c_prepare(struct drm_panel *panel)
 {
 	struct ili9881c *ctx = panel_to_ili9881c(panel);
+	struct mipi_dsi_multi_context mctx = { .dsi = ctx->dsi };
+	unsigned int i;
 	int ret;
 
 	/* Power the panel */
@@ -1864,21 +1866,6 @@
 	gpiod_set_value_cansleep(ctx->reset, 0);
 	msleep(100);
 
-	return 0;
-}
-
-/*
- * Cargt: the init sequence is deliberately run from .enable rather than
- * .prepare -- on this platform the DSI host isn't ready to transmit at
- * .prepare time, so sending it here avoids communicating over MIPI before
- * the peripheral (and host controller) are actually ready.
- */
-static int ili9881c_enable(struct drm_panel *panel)
-{
-	struct ili9881c *ctx = panel_to_ili9881c(panel);
-	struct mipi_dsi_multi_context mctx = { .dsi = ctx->dsi };
-	unsigned int i;
-
 	for (i = 0; i < ctx->desc->init_length; i++) {
 		const struct ili9881c_instr *instr = &ctx->desc->init[i];
 
@@ -1897,10 +1884,26 @@
 
 	mipi_dsi_dcs_set_tear_on_multi(&mctx, MIPI_DSI_DCS_TEAR_MODE_VBLANK);
 	mipi_dsi_dcs_exit_sleep_mode_multi(&mctx);
+	if (mctx.accum_err)
+		printk(KERN_ERR "ili9881c_prepare: init sequence failed: %d\n",
+		       mctx.accum_err);
+
+	return mctx.accum_err;
+}
+
+/*
+ * Cargt: only the final display-on toggle happens in .enable; the panel
+ * init sequence above has already completed in .prepare by this point.
+ */
+static int ili9881c_enable(struct drm_panel *panel)
+{
+	struct ili9881c *ctx = panel_to_ili9881c(panel);
+	struct mipi_dsi_multi_context mctx = { .dsi = ctx->dsi };
+
 	mipi_dsi_msleep(&mctx, 120);
 	mipi_dsi_dcs_set_display_on_multi(&mctx);
 	if (mctx.accum_err)
-		printk(KERN_ERR "ili9881c_enable: init sequence failed: %d\n",
+		printk(KERN_ERR "ili9881c_enable: display on failed: %d\n",
 		       mctx.accum_err);
 
 	return mctx.accum_err;
-- 
