[Unit]
Description=NXP Bluetooth service
Requires=nxp-wifi.service
After=nxp-wifi.service

[Service]
Type=oneshot
ExecStartPre=/bin/sh -c 'for i in $(seq 1 30); do test -e /sys/class/net/mlan0 && exit 0; sleep 1; done; exit 1'
ExecStartPre=/usr/bin/env modprobe btnxpuart
ExecStartPre=/usr/bin/hciattach /dev/ttymxc0 any 115200 flow
ExecStart=/bin/sh -c 'for i in $(seq 1 30); do /usr/bin/hciconfig hci0 up && exit 0; sleep 1; done; exit 1'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
