[Unit]
Description=Camera Fullscreen Display
After=weston.service imx8-isp.service
Requires=weston.service imx8-isp.service

[Service]
Type=simple
User=root
Environment="WAYLAND_DISPLAY=wayland-1"
Environment="XDG_RUNTIME_DIR=/run/user/0"
ExecStart=/usr/bin/camera-fullscreen.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
