[Unit]
Description=NXP WiFi service
# moal hands cfg80211 its regulatory country (reg_alpha2 in wifi_mod_para.conf)
# when it registers. NXP's wpa_supplicant reads the country once per interface
# and later pushes that cached value back when it starts an AP, so it has to
# start after the country is in place: a cached "00" turns the regulatory
# domain back to world and blocks 5 GHz APs.
Before=wpa_supplicant.service

[Service]
Type=simple
# cfg80211 is built in and tries to load regulatory.db before the rootfs is
# mounted, so it has no database and cannot apply moal's country. Load it now.
ExecStartPre=-/usr/sbin/iw reg reload
ExecStart=/usr/bin/env modprobe moal mod_para=nxp/wifi_mod_para.conf drvdbg=0x00000000
# Wait (up to 5 s) for cfg80211 to apply the country before wpa_supplicant starts.
ExecStartPost=/bin/sh -c 'for i in $(seq 1 20); do /usr/sbin/iw reg get | grep -q "^country 00" || exit 0; sleep 0.25; done'
ExecStartPost=/usr/bin/sleep 3

[Install]
WantedBy=multi-user.target
