From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tim Carney <tim.carney@cargt.com>
Date: Thu, 22 Oct 2026 00:00:00 -0500
Subject: [PATCH] boards: cargt00414: load the SoC RTC from the RX8111

The 00414 keeps time across power-off in an Epson RX8111CE (I2C 0x32 on
the PMIC bus, which the SM owns), as on the i.MX 93 SOMs: it draws less
from the backup battery than the SoC RTC would. Agents only see the SoC
BBM RTC (rtcId 0), which loses its time at power-off.

At boot, after DEV_SM_Init(), read the RX8111 and, if its time is valid
(no XST/VLF flag, clock running), load it into the SoC RTC. When an agent
sets the SoC RTC, write the same time to the RX8111 (clear XST/VLF, STOP,
write sec..year, run), as the Linux rtc-rx8111 driver does. Linux keeps
using rtc0, so hwclock, NTP and the kernel RTC sync need no changes.

Add BRD_SM_CTRL_RX8111 (board control 9): raw RX8111 register access
through SCMI MISC control ext get/set (registers 0x00-0x3F, 1-16 bytes
per call), for diagnostics and RTC tests from Linux and U-Boot.

The EVK PCA2131 board RTC (rtcId 1) is left as it was; it is not fitted.

Upstream-Status: Inappropriate [Cargt board specific]
---
diff --git a/boards/cargt00414/sm/brd_sm.c b/boards/cargt00414/sm/brd_sm.c
index 077fa06..a7066e9 100755
--- a/boards/cargt00414/sm/brd_sm.c
+++ b/boards/cargt00414/sm/brd_sm.c
@@ -682,6 +682,12 @@ static int32_t BRD_SM_InitComplete(uint32_t mSel)
     /* Init clock override */
     status = BRD_SM_ClockInit();
 
+    /* Load the SoC RTC from the battery-backed RX8111 */
+    if (status == SM_ERR_SUCCESS)
+    {
+        BRD_SM_BbmRx8111Init();
+    }
+
     /* Return status */
     return status;
 }
diff --git a/boards/cargt00414/sm/brd_sm_bbm.c b/boards/cargt00414/sm/brd_sm_bbm.c
index f053c31..44ac118 100755
--- a/boards/cargt00414/sm/brd_sm_bbm.c
+++ b/boards/cargt00414/sm/brd_sm_bbm.c
@@ -45,15 +45,42 @@
 #include "sm.h"
 #include "brd_sm.h"
 #include "lmm.h"
+#include "fsl_lpi2c.h"
 
 /* Local defines */
 
+/*
+ * Cargt 00414: the battery-backed clock is the Epson RX8111CE (I2C 0x32 on
+ * the PMIC bus), not the SoC BBM RTC. The SM loads the SoC RTC (rtcId 0,
+ * the one agents use) from the RX8111 at boot and writes the RX8111 back
+ * whenever an agent sets the SoC RTC, so Linux keeps using rtc0 unchanged.
+ */
+#define RX8111_I2C_ADDR     0x32U
+#define RX8111_REG_SEC      0x10U   /* sec, min, hour, week, day, month, year */
+#define RX8111_REG_FLAG     0x1EU
+#define RX8111_REG_CTRL     0x1FU
+#define RX8111_NUM_TIME     7U
+#define RX8111_NUM_REG      0x40U  /* register space for raw access */
+#define RX8111_MAX_XFER     16U    /* bytes per raw access */
+#define RX8111_FLAG_XST     0x01U   /* oscillation stopped */
+#define RX8111_FLAG_VLF     0x02U   /* voltage low, time lost */
+#define RX8111_CTRL_STOP    0x01U
+
 /* Local types */
 
 /* Local variables */
 
+static bool s_rx8111Present = false;
+
 /* Local functions */
 
+static bool RX8111_Read(uint8_t reg, uint8_t len, uint8_t *buf);
+static bool RX8111_Write(uint8_t reg, uint8_t len, const uint8_t *buf);
+static int32_t RX8111_TimeGet(uint64_t *secs);
+static int32_t RX8111_TimeSet(uint64_t secs);
+static uint8_t bin2bcd(uint32_t val);
+static uint32_t bcd2bin(uint8_t val);
+
 static bool days2date(uint32_t days, uint32_t *year, uint32_t *month,
     uint32_t *day, uint32_t *weekday);
 static bool date2days(uint32_t year, uint32_t month, uint32_t day,
@@ -213,6 +240,17 @@ int32_t BRD_SM_BbmRtcTimeSet(uint32_t rtcId, uint64_t val, bool ticks)
     if (rtcId < DEV_SM_NUM_RTC)
     {
         status = DEV_SM_BbmRtcTimeSet(rtcId, val, ticks);
+
+        /* Keep the battery-backed RX8111 in step with the SoC RTC */
+        if ((status == SM_ERR_SUCCESS) && s_rx8111Present)
+        {
+            uint64_t now;
+
+            if (DEV_SM_BbmRtcTimeGet(rtcId, &now, false) == SM_ERR_SUCCESS)
+            {
+                (void) RX8111_TimeSet(now);
+            }
+        }
     }
     else if (!g_pca2131Present)
     {
@@ -540,6 +578,263 @@ void BRD_SM_BbmHandler(void)
 
 /*==========================================================================*/
 
+/*--------------------------------------------------------------------------*/
+/* Load the SoC RTC from the RX8111                                         */
+/*--------------------------------------------------------------------------*/
+void BRD_SM_BbmRx8111Init(void)
+{
+    uint8_t flag;
+
+    /* Present if its flag register reads */
+    s_rx8111Present = RX8111_Read(RX8111_REG_FLAG, 1U, &flag);
+
+    if (s_rx8111Present)
+    {
+        uint64_t secs;
+
+        /* Only a valid time (battery held, oscillator ran) is loaded */
+        if (RX8111_TimeGet(&secs) == SM_ERR_SUCCESS)
+        {
+            (void) DEV_SM_BbmRtcTimeSet(0U, secs, false);
+        }
+    }
+}
+
+/*--------------------------------------------------------------------------*/
+/* Raw RX8111 register read (board control BRD_SM_CTRL_RX8111)              */
+/*--------------------------------------------------------------------------*/
+int32_t BRD_SM_BbmRx8111RegRead(uint32_t addr, uint32_t numRtn, uint32_t *rtn)
+{
+    int32_t status = SM_ERR_SUCCESS;
+    uint8_t buf[RX8111_MAX_XFER];
+
+    if (!s_rx8111Present)
+    {
+        status = SM_ERR_NOT_SUPPORTED;
+    }
+    else if ((numRtn == 0U) || (numRtn > RX8111_MAX_XFER)
+        || (addr >= RX8111_NUM_REG) || ((addr + numRtn) > RX8111_NUM_REG))
+    {
+        status = SM_ERR_INVALID_PARAMETERS;
+    }
+    else if (!RX8111_Read((uint8_t) addr, (uint8_t) numRtn, buf))
+    {
+        status = SM_ERR_HARDWARE_ERROR;
+    }
+    else
+    {
+        for (uint32_t idx = 0U; idx < numRtn; idx++)
+        {
+            rtn[idx] = (uint32_t) buf[idx];
+        }
+    }
+
+    /* Return status */
+    return status;
+}
+
+/*--------------------------------------------------------------------------*/
+/* Raw RX8111 register write (board control BRD_SM_CTRL_RX8111)             */
+/*--------------------------------------------------------------------------*/
+int32_t BRD_SM_BbmRx8111RegWrite(uint32_t addr, uint32_t numVal,
+    const uint32_t *val)
+{
+    int32_t status = SM_ERR_SUCCESS;
+    uint8_t buf[RX8111_MAX_XFER];
+
+    if (!s_rx8111Present)
+    {
+        status = SM_ERR_NOT_SUPPORTED;
+    }
+    else if ((numVal == 0U) || (numVal > RX8111_MAX_XFER)
+        || (addr >= RX8111_NUM_REG) || ((addr + numVal) > RX8111_NUM_REG))
+    {
+        status = SM_ERR_INVALID_PARAMETERS;
+    }
+    else
+    {
+        for (uint32_t idx = 0U; idx < numVal; idx++)
+        {
+            buf[idx] = U32_U8(val[idx]);
+        }
+
+        if (!RX8111_Write((uint8_t) addr, (uint8_t) numVal, buf))
+        {
+            status = SM_ERR_HARDWARE_ERROR;
+        }
+    }
+
+    /* Return status */
+    return status;
+}
+
+/*--------------------------------------------------------------------------*/
+/* Read RX8111 registers                                                    */
+/*--------------------------------------------------------------------------*/
+static bool RX8111_Read(uint8_t reg, uint8_t len, uint8_t *buf)
+{
+    static LPI2C_Type *const s_i2cBases[] = LPI2C_BASE_PTRS;
+    lpi2c_master_transfer_t xfer =
+    {
+        .flags = (uint32_t) kLPI2C_TransferDefaultFlag,
+        .slaveAddress = RX8111_I2C_ADDR,
+        .direction = kLPI2C_Read,
+        .subaddress = reg,
+        .subaddressSize = 1U,
+        .data = buf,
+        .dataSize = len
+    };
+
+    return (LPI2C_MasterTransferBlocking(s_i2cBases[BOARD_I2C_INSTANCE],
+        &xfer) == kStatus_Success);
+}
+
+/*--------------------------------------------------------------------------*/
+/* Write RX8111 registers                                                   */
+/*--------------------------------------------------------------------------*/
+static bool RX8111_Write(uint8_t reg, uint8_t len, const uint8_t *buf)
+{
+    static LPI2C_Type *const s_i2cBases[] = LPI2C_BASE_PTRS;
+    uint8_t data[RX8111_MAX_XFER];
+    lpi2c_master_transfer_t xfer =
+    {
+        .flags = (uint32_t) kLPI2C_TransferDefaultFlag,
+        .slaveAddress = RX8111_I2C_ADDR,
+        .direction = kLPI2C_Write,
+        .subaddress = reg,
+        .subaddressSize = 1U,
+        .data = data,
+        .dataSize = len
+    };
+
+    bool rc = false;
+
+    if (len <= RX8111_MAX_XFER)
+    {
+        for (uint8_t idx = 0U; idx < len; idx++)
+        {
+            data[idx] = buf[idx];
+        }
+
+        rc = (LPI2C_MasterTransferBlocking(s_i2cBases[BOARD_I2C_INSTANCE],
+            &xfer) == kStatus_Success);
+    }
+
+    return rc;
+}
+
+/*--------------------------------------------------------------------------*/
+/* Get RX8111 time (seconds since 1-1-1970)                                 */
+/*--------------------------------------------------------------------------*/
+static int32_t RX8111_TimeGet(uint64_t *secs)
+{
+    int32_t status = SM_ERR_SUCCESS;
+    uint8_t flag, ctrl;
+    uint8_t buf[RX8111_NUM_TIME];
+    uint32_t days;
+
+    if (!RX8111_Read(RX8111_REG_FLAG, 1U, &flag)
+        || !RX8111_Read(RX8111_REG_CTRL, 1U, &ctrl)
+        || !RX8111_Read(RX8111_REG_SEC, RX8111_NUM_TIME, buf))
+    {
+        status = SM_ERR_HARDWARE_ERROR;
+    }
+    /* Time lost (no battery, oscillator stopped) or clock stopped */
+    else if (((flag & (RX8111_FLAG_XST | RX8111_FLAG_VLF)) != 0U)
+        || ((ctrl & RX8111_CTRL_STOP) != 0U))
+    {
+        status = SM_ERR_GENERIC_ERROR;
+    }
+    else if (!date2days(2000U + bcd2bin(buf[6]), bcd2bin(buf[5]),
+        bcd2bin(buf[4]), &days))
+    {
+        status = SM_ERR_INVALID_PARAMETERS;
+    }
+    else
+    {
+        *secs = ((uint64_t) days * 86400U)
+            + ((uint64_t) bcd2bin(buf[2]) * 3600U)
+            + ((uint64_t) bcd2bin(buf[1]) * 60U)
+            + (uint64_t) bcd2bin(buf[0]);
+    }
+
+    /* Return status */
+    return status;
+}
+
+/*--------------------------------------------------------------------------*/
+/* Set RX8111 time (seconds since 1-1-1970)                                 */
+/*--------------------------------------------------------------------------*/
+static int32_t RX8111_TimeSet(uint64_t secs)
+{
+    int32_t status = SM_ERR_SUCCESS;
+    uint32_t year = 0U, month = 0U, day = 0U, weekday = 0U;
+    uint32_t rem = (uint32_t) (secs % 86400U);
+    uint8_t flag, ctrl;
+    uint8_t buf[RX8111_NUM_TIME];
+
+    if ((secs / 86400U) > UINT32_MAX)
+    {
+        status = SM_ERR_INVALID_PARAMETERS;
+    }
+    else if (!days2date((uint32_t) (secs / 86400U), &year, &month, &day,
+        &weekday) || (year < 2000U) || (year > 2099U))
+    {
+        status = SM_ERR_INVALID_PARAMETERS;
+    }
+    else
+    {
+        buf[0] = bin2bcd(rem % 60U);
+        buf[1] = bin2bcd((rem / 60U) % 60U);
+        buf[2] = bin2bcd(rem / 3600U);
+        buf[3] = (uint8_t) (1U << weekday);
+        buf[4] = bin2bcd(day);
+        buf[5] = bin2bcd(month);
+        buf[6] = bin2bcd(year - 2000U);
+
+        /* Clear XST/VLF, stop, write the time, start (as Linux rtc-rx8111) */
+        if (!RX8111_Read(RX8111_REG_FLAG, 1U, &flag)
+            || !RX8111_Read(RX8111_REG_CTRL, 1U, &ctrl))
+        {
+            status = SM_ERR_HARDWARE_ERROR;
+        }
+        else
+        {
+            uint8_t newFlag = flag & (uint8_t) ~(RX8111_FLAG_XST
+                | RX8111_FLAG_VLF);
+            uint8_t stop = ctrl | RX8111_CTRL_STOP;
+            uint8_t run = ctrl & (uint8_t) ~RX8111_CTRL_STOP;
+
+            if (!RX8111_Write(RX8111_REG_FLAG, 1U, &newFlag)
+                || !RX8111_Write(RX8111_REG_CTRL, 1U, &stop)
+                || !RX8111_Write(RX8111_REG_SEC, RX8111_NUM_TIME, buf)
+                || !RX8111_Write(RX8111_REG_CTRL, 1U, &run))
+            {
+                status = SM_ERR_HARDWARE_ERROR;
+            }
+        }
+    }
+
+    /* Return status */
+    return status;
+}
+
+/*--------------------------------------------------------------------------*/
+/* Binary to BCD                                                            */
+/*--------------------------------------------------------------------------*/
+static uint8_t bin2bcd(uint32_t val)
+{
+    return (uint8_t) (((val / 10U) << 4U) | (val % 10U));
+}
+
+/*--------------------------------------------------------------------------*/
+/* BCD to binary                                                            */
+/*--------------------------------------------------------------------------*/
+static uint32_t bcd2bin(uint8_t val)
+{
+    return (((uint32_t) val >> 4U) * 10U) + ((uint32_t) val & 0x0FU);
+}
+
 /*--------------------------------------------------------------------------*/
 /* Convert days since 1-1-1970 to date/time                                 */
 /*--------------------------------------------------------------------------*/
diff --git a/boards/cargt00414/sm/brd_sm_bbm.h b/boards/cargt00414/sm/brd_sm_bbm.h
index 2f17244..ab467f7 100755
--- a/boards/cargt00414/sm/brd_sm_bbm.h
+++ b/boards/cargt00414/sm/brd_sm_bbm.h
@@ -234,6 +234,24 @@ int32_t BRD_SM_BbmRtcAlarmSet(uint32_t rtcId, bool enable, uint64_t val);
  */
 void BRD_SM_BbmHandler(void);
 
+/*!
+ * Load the SoC RTC from the battery-backed RX8111 (Cargt 00414).
+ *
+ * Called once at boot, after DEV_SM_Init(). Afterwards every SoC RTC
+ * time set is also written to the RX8111.
+ */
+void BRD_SM_BbmRx8111Init(void);
+
+/*!
+ * Raw RX8111 register access (board control BRD_SM_CTRL_RX8111).
+ *
+ * addr is the register (0x00-0x3F), one byte per value word, 1-16 per
+ * call. Used for diagnostics and RTC tests.
+ */
+int32_t BRD_SM_BbmRx8111RegRead(uint32_t addr, uint32_t numRtn, uint32_t *rtn);
+int32_t BRD_SM_BbmRx8111RegWrite(uint32_t addr, uint32_t numVal,
+    const uint32_t *val);
+
 /** @} */
 
 #endif /* BRD_SM_BBM_H */
diff --git a/boards/cargt00414/sm/brd_sm_control.c b/boards/cargt00414/sm/brd_sm_control.c
index 5bfde92..368ef1b 100755
--- a/boards/cargt00414/sm/brd_sm_control.c
+++ b/boards/cargt00414/sm/brd_sm_control.c
@@ -190,6 +190,10 @@ int32_t BRD_SM_ControlExtSet(uint32_t ctrlId, uint32_t addr,
         {
             status = BRD_SM_EepromWrite(addr, numVal, val);
         }
+        else if (ctrlId == BRD_SM_CTRL_RX8111)
+        {
+            status = BRD_SM_BbmRx8111RegWrite(addr, numVal, val);
+        }
         else
         {
             status = SM_ERR_NOT_SUPPORTED;
@@ -228,6 +232,10 @@ int32_t BRD_SM_ControlExtGet(uint32_t ctrlId, uint32_t addr,
         {
             status = BRD_SM_EepromRead(addr, numRtn, rtn);
         }
+        else if (ctrlId == BRD_SM_CTRL_RX8111)
+        {
+            status = BRD_SM_BbmRx8111RegRead(addr, numRtn, rtn);
+        }
         else
         {
             status = SM_ERR_NOT_SUPPORTED;
diff --git a/boards/cargt00414/sm/brd_sm_control.h b/boards/cargt00414/sm/brd_sm_control.h
index 7e95f76..f522e7f 100755
--- a/boards/cargt00414/sm/brd_sm_control.h
+++ b/boards/cargt00414/sm/brd_sm_control.h
@@ -67,7 +67,7 @@
 /** @} */
 
 /*! Number of board controls */
-#define BRD_SM_NUM_CTRL  9UL
+#define BRD_SM_NUM_CTRL  10UL
 
 /*! Total number of controls */
 #define SM_NUM_CTRL  (DEV_SM_NUM_CTRL + BRD_SM_NUM_CTRL)
@@ -85,6 +85,7 @@
 #define BRD_SM_CTRL_PCA2131     (DEV_SM_NUM_CTRL + 6U)  /*!< PCA2131 raw access */
 #define BRD_SM_CTRL_TEST_A      (DEV_SM_NUM_CTRL + 7U)  /*!< Test action */
 #define BRD_SM_CTRL_EEPROM      (DEV_SM_NUM_CTRL + 8U)  /*!< Cargt SOM EEPROM raw access */
+#define BRD_SM_CTRL_RX8111      (DEV_SM_NUM_CTRL + 9U)  /*!< Cargt SOM RX8111 RTC raw access */
 /** @} */
 
 /* Types */
