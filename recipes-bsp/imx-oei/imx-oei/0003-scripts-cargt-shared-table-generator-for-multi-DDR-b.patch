diff --git a/scripts/cargt_ddr_merge.py b/scripts/cargt_ddr_merge.py
new file mode 100644
index 0000000..4afbf3a
--- /dev/null
+++ b/scripts/cargt_ddr_merge.py
@@ -0,0 +1,141 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: BSD-3-Clause
+# Copyright 2026 Cargt
+"""
+Prepare several NXP DDR tool timing files (*_timing.c) for one OEI image.
+
+The two large tables of a timing file are shared between configurations:
+  - ddr_ddrphy_trained_csr: a list of PHY registers saved for retention. All
+    values are 0, and configurations of one DRAM type list the same registers
+    in a different order, so a single list serves all of them.
+  - ddr_phy_pie: the PHY init engine program. Configurations differ in a few
+    entries, which are stored per configuration as a patch applied while the
+    shared table is loaded (Ddr_Phy_Cfg_Set_Patched()). A patch entry holds the
+    index of the replaced entry in the shared table, not a register address,
+    since the PIE writes some registers more than once.
+Every other table stays per configuration. A configuration whose tables cannot
+be shared keeps its own copy, with a warning.
+
+Output, in OUTDIR:
+  cargt_ddr_shared.c       the shared tables (taken from the first configuration)
+  cargt_timing_<name>.c    each configuration, defining dram_timing_<name>
+
+Each output configuration is checked against its input: the effective PIE
+(shared table with patch) and the trained CSR register set must match exactly.
+
+usage: cargt_ddr_merge.py OUTDIR name=timing.c [name=timing.c ...]
+"""
+import os
+import re
+import sys
+
+ENTRY = re.compile(r"\{\s*(0x[0-9a-fA-F]+)\s*,\s*(0x[0-9a-fA-F]+)U?\s*\}")
+
+
+def get_array(text, name):
+    m = re.search(r"static struct (\w+) %s\[\] = \{(.*?)\n\};\n" % re.escape(name), text, re.S)
+    if not m:
+        sys.exit("error: array %s not found" % name)
+    return m, [(int(r, 16), int(v, 16)) for r, v in ENTRY.findall(m.group(2))]
+
+
+def fmt(entries):
+    return "".join("    {0x%x, 0x%x},\n" % (r, v) for r, v in entries)
+
+
+def pie_patch(base, pie):
+    """(index, value) of the entries of pie that differ from base, or None if the registers differ."""
+    if [r for r, _ in base] != [r for r, _ in pie]:
+        return None
+    return [(i, p[1]) for i, (b, p) in enumerate(zip(base, pie)) if b != p]
+
+
+def apply_patch(base, patch):
+    """Mirror of Ddr_Phy_Cfg_Set_Patched() in oei/ddr/ddrphy_train.c."""
+    out, j = [], 0
+    for i, (r, v) in enumerate(base):
+        if j < len(patch) and patch[j][0] == i:
+            out.append((r, patch[j][1]))
+            j += 1
+        else:
+            out.append((r, v))
+    return out
+
+
+def main():
+    if len(sys.argv) < 3:
+        sys.exit(__doc__)
+    outdir = sys.argv[1]
+    cfgs = []
+    for arg in sys.argv[2:]:
+        name, path = arg.split("=", 1)
+        if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", name):
+            sys.exit("error: bad configuration name %s" % name)
+        with open(path) as f:
+            cfgs.append((name, path, f.read()))
+    os.makedirs(outdir, exist_ok=True)
+
+    _, base_csr = get_array(cfgs[0][2], "ddr_ddrphy_trained_csr")
+    _, base_pie = get_array(cfgs[0][2], "ddr_phy_pie")
+
+    with open(os.path.join(outdir, "cargt_ddr_shared.c"), "w") as f:
+        f.write("// SPDX-License-Identifier: BSD-3-Clause\n")
+        f.write("/* Generated by cargt_ddr_merge.py from %s - do not edit */\n\n"
+                % os.path.basename(cfgs[0][1]))
+        f.write('#include "ddr.h"\n\n')
+        f.write("struct ddrphy_cfg_param cargt_shared_trained_csr[%d] = {\n%s};\n\n"
+                % (len(base_csr), fmt(base_csr)))
+        f.write("struct ddrphy_cfg_param cargt_shared_phy_pie[%d] = {\n%s};\n"
+                % (len(base_pie), fmt(base_pie)))
+
+    for name, path, text in cfgs:
+        out = text
+        notes = []
+
+        m, csr = get_array(out, "ddr_ddrphy_trained_csr")
+        if sorted(r for r, _ in csr) == sorted(r for r, _ in base_csr) and all(v == 0 for _, v in csr):
+            out = out.replace(m.group(0),
+                "/* ddr_ddrphy_trained_csr: same registers as cargt_shared_trained_csr */\n"
+                "extern struct ddrphy_cfg_param cargt_shared_trained_csr[%d];\n"
+                "#define ddr_ddrphy_trained_csr cargt_shared_trained_csr\n" % len(base_csr))
+            notes.append("trained_csr shared")
+        else:
+            print("warning: %s: trained CSR list differs, kept unshared" % name)
+            notes.append("trained_csr UNSHARED")
+
+        m, pie = get_array(out, "ddr_phy_pie")
+        patch = pie_patch(base_pie, pie)
+        patch_init = ""
+        if patch is not None:
+            if apply_patch(base_pie, patch) != pie:
+                sys.exit("error: %s: patched PIE does not reproduce the original" % name)
+            repl = ("/* ddr_phy_pie: cargt_shared_phy_pie with %d entries patched {index, value} */\n"
+                    "extern struct ddrphy_cfg_param cargt_shared_phy_pie[%d];\n"
+                    "#define ddr_phy_pie cargt_shared_phy_pie\n" % (len(patch), len(base_pie)))
+            if patch:
+                repl += "static struct ddrphy_cfg_param ddr_phy_pie_patch[] = {\n%s};\n" % fmt(patch)
+                patch_init = ("    .ddrphy_pie_patch = ddr_phy_pie_patch,\n"
+                              "    .ddrphy_pie_patch_num = ARRAY_SIZE(ddr_phy_pie_patch),\n")
+            out = out.replace(m.group(0), repl)
+            notes.append("pie shared, %d patched" % len(patch))
+        else:
+            print("warning: %s: PIE registers differ, kept unshared" % name)
+            notes.append("pie UNSHARED")
+
+        head = "struct dram_timing_info dram_timing = {\n"
+        if out.count(head) != 1:
+            sys.exit("error: %s: dram_timing definition not found" % path)
+        start = out.index(head)
+        end = out.index("\n};", start)
+        body = out[start:end].replace(head, "struct dram_timing_info dram_timing_%s = {\n" % name)
+        out = out[:start] + body + "\n" + patch_init.rstrip("\n") + out[end:]
+
+        out = ("/* Generated by cargt_ddr_merge.py from %s (%s) - do not edit */\n"
+               % (os.path.basename(path), ", ".join(notes))) + out
+        with open(os.path.join(outdir, "cargt_timing_%s.c" % name), "w") as f:
+            f.write(out)
+        print("%s: %s" % (name, ", ".join(notes)))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/scripts/test/harness.c b/scripts/test/harness.c
new file mode 100644
index 0000000..7e40bdc
--- /dev/null
+++ b/scripts/test/harness.c
@@ -0,0 +1,24 @@
+/* Host test: real cargt_eeprom.c, fake I2C returning a record from a file */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "cargt_ddr.h"
+#include "cargt_lpi2c.h"
+static struct dram_timing_info t16, t2;
+const struct cargt_ddr_cfg cargt_ddr_cfgs[] = {
+    { .id = 2, .ranks = 2, .size_mb = 16384, .name = "16GB", .timing = &t16 },
+    { .id = 1, .ranks = 1, .size_mb = 2048,  .name = "2GB",  .timing = &t2 },
+};
+const uint32_t cargt_ddr_cfgs_num = 2;
+static unsigned char rec[48]; static int nack;
+int Cargt_Lpi2c_Init(uint32_t inst) { return 0; }
+void Cargt_Lpi2c_Deinit(void) {}
+int Cargt_Lpi2c_Read(uint8_t addr, uint8_t reg, uint8_t *buf, uint32_t len)
+{ if (nack || addr != 0x50 || reg != 0 || len != 48) return -1; memcpy(buf, rec, 48); return 0; }
+int main(int argc, char **argv)
+{
+    FILE *f = fopen(argv[1], "rb");
+    if (!f) { nack = 1; } else { fread(rec, 1, 48, f); fclose(f); }
+    printf("%s -> 0x%02x\n", argv[1], Cargt_Ddr_Get_Cfg_Id());
+    return 0;
+}
diff --git a/scripts/test/mkrec.py b/scripts/test/mkrec.py
new file mode 100644
index 0000000..444f9c1
--- /dev/null
+++ b/scripts/test/mkrec.py
@@ -0,0 +1,37 @@
+# Port of ate_pc ateTest_eeprom.cs BuildEeprom (v2), extended with the v3 ddr_cfg_id at offset 38
+import struct
+import zlib
+
+
+def build(cpn, serial, date, size_mb, speed, ranks, ver=2, cfg_id=None):
+    b = bytearray()
+    b += struct.pack(">IHB", 0x43524754, 48, ver)
+    b += cpn.encode().ljust(13, b"\0")
+    b += struct.pack(">I", serial)
+    b += date.encode().ljust(9, b"\0")
+    b += struct.pack(">HH", size_mb, speed)
+    res = bytearray(7)
+    res[0] = ranks
+    if cfg_id is not None:
+        res[1] = cfg_id
+    b += res
+    assert len(b) == 44
+    b += struct.pack(">I", zlib.crc32(bytes(b)) & 0xFFFFFFFF)
+    return bytes(b)
+
+
+cases = {
+    "v2_2g_r1": build("012-00414-01", 1001, "20261009", 2048, 6400, 1),
+    "v2_16g_r2": build("012-00414-02", 1002, "20261009", 16384, 6400, 2),
+    "v2_4g_r2_nomatch": build("012-00414-03", 1003, "20261009", 4096, 6400, 2),
+    "v3_id2": build("012-00414-02", 1004, "20261009", 16384, 6400, 2, ver=3, cfg_id=2),
+    "v3_id0_fallback": build("012-00414-01", 1005, "20261009", 2048, 6400, 1, ver=3, cfg_id=0),
+    "v1_2g_assume_r2": build("012-00414-01", 1006, "20261009", 2048, 6400, 0, ver=1),
+}
+bad = bytearray(cases["v2_2g_r1"])
+bad[33] ^= 0x01
+cases["bad_crc"] = bytes(bad)
+cases["blank_ff"] = b"\xff" * 48
+for name, data in cases.items():
+    with open(name + ".bin", "wb") as f:
+        f.write(data)
diff --git a/scripts/test/run_eeprom_test.sh b/scripts/test/run_eeprom_test.sh
new file mode 100755
index 0000000..58f648b
--- /dev/null
+++ b/scripts/test/run_eeprom_test.sh
@@ -0,0 +1,11 @@
+#!/bin/sh
+# Host test of oei/ddr/cargt_eeprom.c: records built like ate_pc BuildEeprom.
+set -e
+D=$(mktemp -d); trap "rm -rf $D" EXIT
+H=$(cd "$(dirname "$0")" && pwd)
+cp "$H/harness.c" "$H/mkrec.py" "$H/../../oei/ddr/cargt_eeprom.c" "$D"; cp -r "$H/stubs" "$D"
+cp "$H/../../oei/ddr/cargt_ddr.h" "$H/../../oei/ddr/cargt_lpi2c.h" "$D/stubs/"
+cd "$D"; gcc -Wall -std=c99 -Istubs -o harness harness.c cargt_eeprom.c; python3 mkrec.py
+check() { r=$(./harness "$1.bin" | tail -1 | sed "s/.*-> //"); [ "$r" = "$2" ] && echo "ok   $1 -> $r" || { echo "FAIL $1 -> $r (want $2)"; exit 1; }; }
+check v2_2g_r1 0x01; check v2_16g_r2 0x02; check v2_4g_r2_nomatch 0xff; check v3_id2 0x02
+check v3_id0_fallback 0x01; check v1_2g_assume_r2 0xff; check bad_crc 0xff; check blank_ff 0xff; check no_eeprom 0xff
