+/* SPDX-License-Identifier: BSD-3-Clause */
+/*
+ * Copyright 2026 Cargt
+ *
+ * Runtime selection between several DDR timing configurations, so that one
+ * OEI image can boot SOM variants populated with different DRAM parts.
+ */
+#ifndef CARGT_DDR_H
+#define CARGT_DDR_H
+
+#include <stdint.h>
+#include "ddr.h"
+
+/** No usable DDR configuration ID (blank, invalid or missing EEPROM) */
+#define CARGT_DDR_CFG_ID_NONE   0xFFU
+
+struct cargt_ddr_cfg
+{
+    uint8_t id;                         /** ddr_cfg_id stored in the Cargt EEPROM */
+    uint8_t ranks;                      /** informational, printed on the console */
+    uint32_t size_mb;                   /** informational, printed on the console */
+    const char *name;
+    struct dram_timing_info *timing;
+};
+
+/**
+ * Provided by the board. The order of the list is the bootstrap order used
+ * when the preferred configuration is unknown or fails to train: put the
+ * configurations with more ranks first, since a 1-rank configuration can
+ * train on a 2-rank part and silently expose only half of the memory.
+ */
+extern const struct cargt_ddr_cfg cargt_ddr_cfgs[];
+extern const uint32_t cargt_ddr_cfgs_num;
+
+/**
+ * Board hook returning the DDR configuration ID of this unit, or
+ * CARGT_DDR_CFG_ID_NONE if it is not known. The weak default returns
+ * CARGT_DDR_FORCE_ID when built with it, CARGT_DDR_CFG_ID_NONE otherwise.
+ */
+uint8_t Cargt_Ddr_Get_Cfg_Id(void);
+
+/**
+ * Initialize DDR with the preferred configuration, falling back to the
+ * other configurations in list order if it is unknown or fails to train.
+ *
+ * @return 0 on success, the last Ddrc_Init() error otherwise
+ */
+int Cargt_Ddr_Init(uint32_t img_id);
+
+#endif /* CARGT_DDR_H */
diff --git a/scripts/test/stubs/cargt_lpi2c.h b/scripts/test/stubs/cargt_lpi2c.h
new file mode 100644
index 0000000..58407cb
--- /dev/null
+++ b/scripts/test/stubs/cargt_lpi2c.h
@@ -0,0 +1,33 @@
+/* SPDX-License-Identifier: BSD-3-Clause */
+/*
+ * Copyright 2026 Cargt
+ *
+ * Minimal polling LPI2C master for OEI, used to read the SOM EEPROM before
+ * the System Manager starts. It leaves the controller reset and the clock
+ * root as it found them, so the SM can initialize the bus normally.
+ */
+#ifndef CARGT_LPI2C_H
+#define CARGT_LPI2C_H
+
+#include <stdint.h>
+
+/**
+ * Configure LPI2C instance inst (1..8) for 100 kHz, from the 24 MHz oscillator.
+ * The pads must already be muxed to the instance.
+ *
+ * @return 0 on success, negative on error
+ */
+int Cargt_Lpi2c_Init(uint32_t inst);
+
+/**
+ * Read len bytes (1..256) from the 7-bit address addr, starting at the
+ * 8-bit register/offset reg: START, addr+W, reg, rSTART, addr+R, data, STOP.
+ *
+ * @return 0 on success, -1 on NACK, -2 on timeout, -3 on bus/arbitration error
+ */
+int Cargt_Lpi2c_Read(uint8_t addr, uint8_t reg, uint8_t *buf, uint32_t len);
+
+/** Reset the controller and restore its clock root */
+void Cargt_Lpi2c_Deinit(void);
+
+#endif /* CARGT_LPI2C_H */
