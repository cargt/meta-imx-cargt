 oei/ddr/cargt_ddr.h    |  50 +++++++++++++++++
 oei/ddr/ddr.h          |  14 +++++
 oei/ddr/ddr_init.c     |   9 +++-
 oei/ddr/ddrphy_train.c |  27 +++++++++-
 oei/ddr/main.c         |  11 +++-
