From 55e8e6ad9d4f4d420007ed803eb1f32006d266c5 Mon Sep 17 00:00:00 2001
From: Tim Carney <tim.carney@cargt.com>
Date: Tue, 11 Nov 2025 17:01:50 -0600
Subject: [PATCH] WIP: Update settings for proper UART in U-Boot for 00377.

---
 .../dts/imx8mp-cargt-00377-00365-u-boot.dtsi  | 31 ++++++++++---------
 arch/arm/dts/imx8mp-cargt-00377-osm-som.dts   |  5 ++-
 include/configs/imx8mp_00377.h                | 27 +++++-----------
 3 files changed, 26 insertions(+), 37 deletions(-)

diff --git a/arch/arm/dts/imx8mp-cargt-00377-00365-u-boot.dtsi b/arch/arm/dts/imx8mp-cargt-00377-00365-u-boot.dtsi
index 8a0c07488b9..30f686e0273 100644
--- a/arch/arm/dts/imx8mp-cargt-00377-00365-u-boot.dtsi
+++ b/arch/arm/dts/imx8mp-cargt-00377-00365-u-boot.dtsi
@@ -2,6 +2,7 @@
 /*
  * Copyright 2025 NXP
  */
+#include "imx8mp-sec-def.h"
 #include "imx8mp-u-boot.dtsi"
 
 / {
@@ -10,7 +11,7 @@
 		wdt = <&wdog1>;
 		bootph-pre-ram;
 	};
-	
+
 	mcu_rdc {
 		compatible = "imx8m,mcu_rdc";
 			    /* rdc config when MCU starts
@@ -19,14 +20,14 @@
 			     *   SDMA3b --> domian 0
 			     *   SDMA3_SPBA2  --> domian 0
 			     * peripheral:
-			     *   SAI3   --> Only Domian 0 can access
-			     *   UART4  --> Only Domian 0 can access
-			     *   GPT1   --> Only Domian 0 can access
-			     *   SDMA3  --> Only Domian 0 can access
-			     *   I2C3   --> Only Domian 0 can access
+			     *   SAI3   --> Domian 0/1 can access
+			     *   UART4  --> Domian 0/1 can access
+			     *   GPT1   --> Domian 0/1 can access
+			     *   SDMA3  --> Domian 0/1 can access
+			     *   I2C3   --> Domian 0/1 can access
 			     * memory:
-			     *   TCM    --> Only Domian 0 can access (0x7E0000~0x81FFFF)
-			     *   DDR    --> Only Domian 0 can access (0x80000000~0x81000000)
+			     *   TCM    --> Domian 0/1 can access (0x7E0000~0x81FFFF)
+			     *   DDR    --> Domian 0/1 can access (0x80000000~0x81000000)
 			     * end.
 			     */
 		start-config = <
@@ -36,13 +37,13 @@
 			    RDC_MDA  RDC_MDA_SDMA3b DID0 0x0 0x0
 			    RDC_MDA  RDC_MDA_SDMA3_SPBA2 DID0 0x0 0x0
 			    RDC_PDAP RDC_PDAP_ENET1 PDAP_D0D1_ACCESS 0x0 0x0
-			    RDC_PDAP RDC_PDAP_SAI3  PDAP_D0_ACCESS 0x0 0x0
-			    RDC_PDAP RDC_PDAP_UART4 PDAP_D0_ACCESS 0x0 0x0
-			    RDC_PDAP RDC_PDAP_GPT1  PDAP_D0_ACCESS 0x0 0x0
-			    RDC_PDAP RDC_PDAP_SDMA3 PDAP_D0_ACCESS 0x0 0x0
-			    RDC_PDAP RDC_PDAP_I2C3  PDAP_D0_ACCESS 0x0 0x0
-			    RDC_MEM_REGION 22 TCM_START TCM_END MEM_D0_ACCESS
-			    RDC_MEM_REGION 39 M4_DDR_START M4_DDR_END MEM_D0_ACCESS
+			    RDC_PDAP RDC_PDAP_SAI3  PDAP_D0D1_ACCESS 0x0 0x0
+			    RDC_PDAP RDC_PDAP_UART4 PDAP_D0D1_ACCESS 0x0 0x0
+			    RDC_PDAP RDC_PDAP_GPT1  PDAP_D0D1_ACCESS 0x0 0x0
+			    RDC_PDAP RDC_PDAP_SDMA3 PDAP_D0D1_ACCESS 0x0 0x0
+			    RDC_PDAP RDC_PDAP_I2C3  PDAP_D0D1_ACCESS 0x0 0x0
+			    RDC_MEM_REGION 22 TCM_START TCM_END MEM_D0D1_ACCESS
+			    RDC_MEM_REGION 39 M4_DDR_START M4_DDR_END MEM_D0D1_ACCESS
 			    0x0      0x0            0x0  0x0 0x0
 			  >;
 			    /* rdc config when MCU stops
diff --git a/arch/arm/dts/imx8mp-cargt-00377-osm-som.dts b/arch/arm/dts/imx8mp-cargt-00377-osm-som.dts
index 1854e33c3a5..0ef802d3a89 100644
--- a/arch/arm/dts/imx8mp-cargt-00377-osm-som.dts
+++ b/arch/arm/dts/imx8mp-cargt-00377-osm-som.dts
@@ -13,7 +13,7 @@
 	 compatible = "cargt,imx8mp-00377", "fsl,imx8mp";
 
 	chosen {
-		bootargs = "console=ttymxc1,115200 earlycon=ec_imx6q,0x30890000,115200";
+		bootargs = "console=ttymxc3,115200 earlycon=ec_imx6q,30a60000,115200";
 		stdout-path = &uart4;
 	};
 
@@ -25,8 +25,7 @@
 
 	memory@40000000 {
 		device_type = "memory";
-		reg = <0x0 0x40000000 0 0xc0000000>,
-		      <0x1 0x00000000 0 0x40000000>;
+		reg = <0x0 0x40000000 0 0x80000000>;
 	};
 
 	reg_usdhc1_vmmc: regulator-usdhc1 {
diff --git a/include/configs/imx8mp_00377.h b/include/configs/imx8mp_00377.h
index 8a3dc1b89b6..da00825398f 100644
--- a/include/configs/imx8mp_00377.h
+++ b/include/configs/imx8mp_00377.h
@@ -72,8 +72,8 @@
 	"fdt_addr=0x43000000\0"			\
 	"fdt_high=0xffffffffffffffff\0" \
 	"mtdparts=" MFG_NAND_PARTITION "\0" \
-	"console=ttymxc1,115200 earlycon=ec_imx6q,0x30890000,115200\0" \
-	"bootargs=console=ttymxc1,115200 earlycon=ec_imx6q,0x30890000,115200 ubi.mtd=nandrootfs "  \
+	"console=ttymxc3,115200 earlycon=ec_imx6q,30a60000,115200\0" \
+	"bootargs=console=ttymxc3,115200 earlycon=ec_imx6q,0x30a60000,115200 ubi.mtd=nandrootfs "  \
 		"root=ubi0:nandrootfs rootfstype=ubifs "		     \
 		MFG_NAND_PARTITION \
 		"\0" \
@@ -93,7 +93,7 @@
 	"bsp_script=boot.scr\0" \
 	"image=Image\0" \
 	"splashimage=0x50000000\0" \
-	"console=ttymxc1,115200\0" \
+	"console=ttymxc3,115200\0" \
 	"fdt_addr_r=0x43000000\0"			\
 	"fdt_addr=0x43000000\0"			\
 	"boot_fdt=try\0" \
@@ -156,31 +156,20 @@
 #endif
 
 /* Link Definitions */
-
 #define CFG_SYS_INIT_RAM_ADDR	0x40000000
 #define CFG_SYS_INIT_RAM_SIZE	0x80000
 
 
-/* Totally 6GB DDR */
+/* 4GB DDR */
 #define CFG_SYS_SDRAM_BASE		0x40000000
-#define PHYS_SDRAM			0x40000000
-#define PHYS_SDRAM_SIZE			0xC0000000	/* 3 GB */
-#define PHYS_SDRAM_2			0x100000000
-#ifdef CONFIG_TARGET_IMX8MP_DDR4_EVK
-#define PHYS_SDRAM_2_SIZE		0x40000000	/* 1 GB */
-#else
-#define PHYS_SDRAM_2_SIZE		0xC0000000	/* 3 GB */
-#endif
+#define PHYS_SDRAM				0x40000000
+#define PHYS_SDRAM_SIZE			0x80000000	/* 2 GB */
+#define PHYS_SDRAM_2			0xC0000000
+#define PHYS_SDRAM_2_SIZE		0x80000000	/* 2 GB */
 
 #define CFG_MXC_UART_BASE		UART4_BASE_ADDR
 
-#define CFG_SYS_NAND_BASE           0x20000000
-
-#ifdef CONFIG_TARGET_IMX8MP_DDR4_EVK
-#define CFG_SYS_FSL_USDHC_NUM	1
-#else
 #define CFG_SYS_FSL_USDHC_NUM	2
-#endif
 
 #ifdef CONFIG_ANDROID_SUPPORT
 #include "imx8mp_evk_android.h"
