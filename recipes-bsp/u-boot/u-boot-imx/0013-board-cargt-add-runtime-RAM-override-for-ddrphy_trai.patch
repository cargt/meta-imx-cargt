From 45b995550de613b427320a8cc616d16faadc1c65 Mon Sep 17 00:00:00 2001
From: Tim Carney <tim.carney@cargt.com>
Date: Tue, 26 May 2026 12:29:35 -0500
Subject: [PATCH] board/cargt: add runtime RAM override for ddrphy_trained_csr
 (bounded copy)

---
 board/cargt/imx93_00363/spl-cargt.c | 39 +++++++++++++++++++++++++++++
 1 file changed, 39 insertions(+)

diff --git a/board/cargt/imx93_00363/spl-cargt.c b/board/cargt/imx93_00363/spl-cargt.c
index d74c3d357ed..13fbd542b73 100644
--- a/board/cargt/imx93_00363/spl-cargt.c
+++ b/board/cargt/imx93_00363/spl-cargt.c
@@ -216,6 +216,43 @@ static void patch_fsp_msg_for_rank(struct dram_timing_info *timing, uint8_t rank
 		/* fsp_cfg_num remains the same */
 	}
 }
+
+/*
+ * Make a RAM copy of the `ddrphy_trained_csr` table so it can be
+ * mutated at runtime by the driver. Keep the buffer bounded to limit
+ * SPL .bss usage. We don't attempt large semantic patches here; the
+ * goal is to ensure the table is writable in SRAM and can be further
+ * patched if necessary for rank-specific entries.
+ */
+static void patch_ddrphy_trained_csr_for_rank(struct dram_timing_info *timing, uint8_t rank)
+{
+	/* allow reasonably large trained CSR lists but cap for SPL */
+	#define MAX_DDRPHY_TRAINED_CSR 1024
+	static struct dram_cfg_param ddrphy_trained_csr_override[MAX_DDRPHY_TRAINED_CSR];
+	int i;
+
+	if (!timing)
+		return;
+
+	if (timing->ddrphy_trained_csr_num == 0 || !timing->ddrphy_trained_csr)
+		return;
+
+	if (timing->ddrphy_trained_csr_num > MAX_DDRPHY_TRAINED_CSR)
+		return;
+
+	/* copy the whole trained CSR table into RAM */
+	for (i = 0; i < timing->ddrphy_trained_csr_num; i++)
+		ddrphy_trained_csr_override[i] = timing->ddrphy_trained_csr[i];
+
+	/*
+	 * If specific rank-2 register adjustments become necessary they can
+	 * be applied here by checking `rank` and modifying entries in
+	 * `ddrphy_trained_csr_override[]` before repointing.
+	 */
+
+	timing->ddrphy_trained_csr = ddrphy_trained_csr_override;
+	/* timing->ddrphy_trained_csr_num unchanged */
+}
 void spl_dram_init(void)
 {
 	struct dram_timing_info *ptiming = &cargt_lpddr4x_1gbyte_3200mts_timing;
@@ -258,6 +295,8 @@ void spl_dram_init(void)
 	patch_ddrc_cfg_for_rank(ptiming, dram_rank);
 	/* Apply rank-specific FSP message overrides when needed */
 	patch_fsp_msg_for_rank(ptiming, dram_rank);
+	/* Make trained CSR writable in SRAM and optionally patch for rank */
+	patch_ddrphy_trained_csr_for_rank(ptiming, dram_rank);
 	printf("\tSelected board timing: %uMB @ %u MT/s (rank %u)\r\n",
 		   dram_size_mbytes, dram_speed_mts, dram_rank);
 
