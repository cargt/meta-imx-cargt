/*
 * Copyright 2024 NXP
 * Copyright 2026 Cargt
 *
 * Cargt i.MX 95 00414 OSM-L SOM on the 00428 carrier (U-Boot).
 * Boot-relevant subset of the kernel imx95-cargt-00414-00428.dts: the
 * ETH_A RGMII port (PHY reset released by board_init()) and USB.
 */

/dts-v1/;

#include "imx95-cargt-00414-osm-som.dts"

/ {
	model = "Cargt i.MX95 00414 OSM-L SOM on 00428 carrier board";
	compatible = "cargt,imx95-00414-00428", "cargt,imx95-00414-osm-som",
		     "fsl,imx95";

	aliases {
		ethernet0 = &enetc_port0;
	};

	/* OSM USB_C VBUS (USB2_VBUS_EN on OSM UART_A_RX) */
	reg_usb_c_vbus: regulator-usb-c-vbus {
		compatible = "regulator-fixed";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_usb_c_vbus>;
		regulator-name = "USB2_VBUS_EN";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		gpio = <&gpio2 15 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};
};

&netcmix_blk_ctrl {
	status = "okay";
};

&netc_blk_ctrl {
	status = "okay";
};

/* ETH_A PHY MDIO (ENET1_MDC/MDIO) */
&netc_emdio {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_emdio>;
	status = "okay";

	ethphy0: ethernet-phy@0 {
		reg = <0>;
		realtek,clkout-disable;
	};
};

/* OSM ETH_A */
&enetc_port0 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_enetc0>;
	phy-handle = <&ethphy0>;
	phy-mode = "rgmii-id";
	status = "okay";
};

/*
 * OSM USB_A: the USB-C connector. No TCPC handling in U-Boot, so run it as
 * a peripheral for fastboot/UUU.
 */
&usb2 {
	dr_mode = "peripheral";
	disable-over-current;
	status = "okay";
};

/* OSM USB_C: host only on the 00428 */
&usb3 {
	status = "okay";
};

&usb3_dwc3 {
	dr_mode = "host";
	vbus-supply = <&reg_usb_c_vbus>;
	status = "okay";
};

&usb3_phy {
	status = "okay";
};

&scmi_iomuxc {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_hog>;

	/* ETH_A_RST must be a GPIO before board_init() pulses it */
	pinctrl_hog: hoggrp {
		fsl,pins = <
			IMX95_PAD_GPIO_IO09__GPIO2_IO_BIT9			0x31e
		>;
	};

	pinctrl_emdio: emdiogrp {
		fsl,pins = <
			IMX95_PAD_ENET1_MDC__NETCMIX_TOP_NETC_MDC		0x50e
			IMX95_PAD_ENET1_MDIO__NETCMIX_TOP_NETC_MDIO		0x90e
		>;
	};

	pinctrl_enetc0: enetc0grp {
		fsl,pins = <
			IMX95_PAD_ENET1_TD3__NETCMIX_TOP_ETH0_RGMII_TD3		0x50e
			IMX95_PAD_ENET1_TD2__NETCMIX_TOP_ETH0_RGMII_TD2		0x50e
			IMX95_PAD_ENET1_TD1__NETCMIX_TOP_ETH0_RGMII_TD1		0x50e
			IMX95_PAD_ENET1_TD0__NETCMIX_TOP_ETH0_RGMII_TD0		0x50e
			IMX95_PAD_ENET1_TX_CTL__NETCMIX_TOP_ETH0_RGMII_TX_CTL	0x57e
			IMX95_PAD_ENET1_TXC__NETCMIX_TOP_ETH0_RGMII_TX_CLK	0x58e
			IMX95_PAD_ENET1_RX_CTL__NETCMIX_TOP_ETH0_RGMII_RX_CTL	0x57e
			IMX95_PAD_ENET1_RXC__NETCMIX_TOP_ETH0_RGMII_RX_CLK	0x58e
			IMX95_PAD_ENET1_RD0__NETCMIX_TOP_ETH0_RGMII_RD0		0x57e
			IMX95_PAD_ENET1_RD1__NETCMIX_TOP_ETH0_RGMII_RD1		0x57e
			IMX95_PAD_ENET1_RD2__NETCMIX_TOP_ETH0_RGMII_RD2		0x57e
			IMX95_PAD_ENET1_RD3__NETCMIX_TOP_ETH0_RGMII_RD3		0x57e
		>;
	};

	pinctrl_usb_c_vbus: usbcvbusgrp {
		fsl,pins = <
			IMX95_PAD_GPIO_IO15__GPIO2_IO_BIT15			0x31e
		>;
	};
};
