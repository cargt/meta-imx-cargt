From c1b02dbb1aacb2dc12c0b4dbc4bef4854e2de601 Mon Sep 17 00:00:00 2001
From: Tim Carney <tim.carney@cargt.com>
Date: Thu, 11 Dec 2025 11:14:34 -0600
Subject: [PATCH] Add updates for 00377-00365 support.

---
 board/cargt/imx8mp_00377/imx8mp_00377.c    | 22 +++++-----------------
 configs/imx8mp-cargt-00377-00365_defconfig |  2 +-
 include/configs/imx8mp_00377.h             | 14 ++++++--------
 3 files changed, 12 insertions(+), 26 deletions(-)

diff --git a/board/cargt/imx8mp_00377/imx8mp_00377.c b/board/cargt/imx8mp_00377/imx8mp_00377.c
index b1b1e5f4895..a69ab596c46 100644
--- a/board/cargt/imx8mp_00377/imx8mp_00377.c
+++ b/board/cargt/imx8mp_00377/imx8mp_00377.c
@@ -128,8 +128,6 @@ int ft_board_setup(void *blob, struct bd_info *bd)
 #endif
 
 #ifdef CONFIG_USB_TCPC
-/* USB_TCPC is not implemented in U-Boot for 00377 yet */
-#else
 struct tcpc_port port1;
 struct tcpc_port port2;
 
@@ -187,8 +185,8 @@ int pd_switch_snk_enable(struct tcpc_port *port)
 
 /* Port2 is the power supply, port 1 does not support power */
 struct tcpc_port_config port1_config = {
-	.i2c_bus = 1, /*i2c2*/
-	.addr = 0x51,
+	.i2c_bus = 0, /*i2c1*/
+	.addr = 0x50,
 	.port_type = TYPEC_PORT_UFP,
 	.max_snk_mv = 20000,
 	.max_snk_ma = 3000,
@@ -199,7 +197,7 @@ struct tcpc_port_config port1_config = {
 };
 
 struct tcpc_port_config port2_config = {
-	.i2c_bus = 1, /*i2c2*/
+	.i2c_bus = 0, /*i2c1*/
 	.addr = 0x52,
 	.port_type = TYPEC_PORT_UFP,
 	.max_snk_mv = 20000,
@@ -371,8 +369,6 @@ int board_usb_init(int index, enum usb_init_type init)
 	if (index == 0 && init == USB_INIT_DEVICE) {
 		imx8m_usb_power(index, true);
 #ifdef CONFIG_USB_TCPC
-printf("USB_TCPC is not implemented in U-Boot for 00377 yet\n");
-#else
 		ret = tcpc_setup_ufp_mode(&port1);
 		if (ret)
 			return ret;
@@ -381,8 +377,6 @@ printf("USB_TCPC is not implemented in U-Boot for 00377 yet\n");
 		return dwc3_uboot_init(&dwc3_device_data);
 	} else if (index == 0 && init == USB_INIT_HOST) {
 #ifdef CONFIG_USB_TCPC
-printf("USB_TCPC is not implemented in U-Boot for 00377 yet\n");
-#else
 		ret = tcpc_setup_dfp_mode(&port1);
 #endif
 		return ret;
@@ -400,8 +394,6 @@ int board_usb_cleanup(int index, enum usb_init_type init)
 		imx8m_usb_power(index, false);
 	} else if (index == 0 && init == USB_INIT_HOST) {
 #ifdef CONFIG_USB_TCPC
-printf("USB_TCPC is not implemented in U-Boot for 00377 yet\n");
-#else
 		ret = tcpc_disable_src_vbus(&port1);
 #endif
 	}
@@ -410,8 +402,6 @@ printf("USB_TCPC is not implemented in U-Boot for 00377 yet\n");
 }
 
 #ifdef CONFIG_USB_TCPC
-/* USB_TCPC is not implemented in U-Boot for 00377 yet */
-#else
 /* Not used so far */
 int board_typec_get_mode(int index)
 {
@@ -443,10 +433,8 @@ int board_init(void)
 #endif
 
 #ifdef CONFIG_USB_TCPC
-printf("***************************************************\n");
-printf("USB_TCPC is not implemented in U-Boot for 00377 yet\n");
-printf("***************************************************\n");
-	// setup_typec();
+	printf("Type-C PD init\n");
+	setup_typec();
 #endif
 
 #ifdef CONFIG_NAND_MXS
diff --git a/configs/imx8mp-cargt-00377-00365_defconfig b/configs/imx8mp-cargt-00377-00365_defconfig
index 5d1d101677a..88c528e3d56 100644
--- a/configs/imx8mp-cargt-00377-00365_defconfig
+++ b/configs/imx8mp-cargt-00377-00365_defconfig
@@ -34,7 +34,7 @@ CONFIG_OF_BOARD_FIXUP=y
 CONFIG_OF_BOARD_SETUP=y
 CONFIG_OF_SYSTEM_SETUP=y
 CONFIG_BOOTCOMMAND="run distro_bootcmd;run bsp_bootcmd"
-CONFIG_DEFAULT_FDT_FILE="boot/imx8mp-cargt-00377-00365.dtb"
+CONFIG_DEFAULT_FDT_FILE="imx8mp-cargt-00377-00365.dtb"
 CONFIG_ARCH_MISC_INIT=y
 CONFIG_BOARD_EARLY_INIT_F=y
 CONFIG_BOARD_LATE_INIT=y
diff --git a/include/configs/imx8mp_00377.h b/include/configs/imx8mp_00377.h
index 7d5109524c3..da00825398f 100644
--- a/include/configs/imx8mp_00377.h
+++ b/include/configs/imx8mp_00377.h
@@ -31,7 +31,7 @@
 #define BOOTENV
 #endif
 
-#define JH_ROOT_DTB    "imx8mp-cargt-00377-00365.dtb"
+#define JH_ROOT_DTB    "imx8mp-evk-root.dtb"
 
 #define JAILHOUSE_ENV \
 	"jh_clk= \0 " \
@@ -91,7 +91,7 @@
 	"scriptaddr=0x43500000\0" \
 	"kernel_addr_r=" __stringify(CONFIG_SYS_LOAD_ADDR) "\0" \
 	"bsp_script=boot.scr\0" \
-	"image=boot/Image\0" \
+	"image=Image\0" \
 	"splashimage=0x50000000\0" \
 	"console=ttymxc3,115200\0" \
 	"fdt_addr_r=0x43000000\0"			\
@@ -105,13 +105,12 @@
 	"mmcpart=1\0" \
 	"mmcroot=/dev/mmcblk1p2 rootwait rw\0" \
 	"mmcautodetect=yes\0" \
-	"mmcargs=setenv bootargs ${jh_clk} console=${console} " \
-		"root=/dev/mmcblk${mmcdev}p${mmcpart} rootwait rw ${cargt_bootargs}\0" \
-	"loadbootscript=${loadcmd} mmc ${mmcdev}:${mmcpart} ${loadaddr} ${script};\0" \
+	"mmcargs=setenv bootargs ${jh_clk} ${mcore_clk} console=${console} root=${mmcroot}\0 " \
+	"loadbootscript=fatload mmc ${mmcdev}:${mmcpart} ${loadaddr} ${bsp_script};\0" \
 	"bootscript=echo Running bootscript from mmc ...; " \
 		"source\0" \
-	"loadimage=${loadcmd} mmc ${mmcdev}:${mmcpart} ${loadaddr} ${image}\0" \
-	"loadfdt=${loadcmd} mmc ${mmcdev}:${mmcpart} ${fdt_addr_r} ${fdtfile}\0" \
+	"loadimage=fatload mmc ${mmcdev}:${mmcpart} ${loadaddr} ${image}\0" \
+	"loadfdt=fatload mmc ${mmcdev}:${mmcpart} ${fdt_addr_r} ${fdtfile}\0" \
 	"mmcboot=echo Booting from mmc ...; " \
 		"run mmcargs; " \
 		"if test ${boot_fit} = yes || test ${boot_fit} = try; then " \
@@ -144,7 +143,6 @@
 			"fi; " \
 		"fi;\0" \
 	"bsp_bootcmd=echo Running BSP bootcmd ...; " \
-		"setenv loadcmd ext4load; " \
 		"mmc dev ${mmcdev}; if mmc rescan; then " \
 		   "if run loadbootscript; then " \
 			   "run bootscript; " \
