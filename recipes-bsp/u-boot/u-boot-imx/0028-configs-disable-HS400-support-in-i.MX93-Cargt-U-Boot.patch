From 3fd1a642ec16a21583cb6a4e9c93f1a78452d91e Mon Sep 17 00:00:00 2001
From: Tim Carney <tim.carney@cargt.com>
Date: Wed, 24 Jun 2026 13:30:08 -0500
Subject: [PATCH] configs: disable HS400 support in i.MX93 Cargt  U-Boot
 defconfigs

---
 configs/imx93-cargt-00363-00365_defconfig   | 4 ++--
 configs/imx93-cargt-00363-osm-som_defconfig | 4 ++--
 2 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/configs/imx93-cargt-00363-00365_defconfig b/configs/imx93-cargt-00363-00365_defconfig
index 0ec6729957e..5705343cce7 100644
--- a/configs/imx93-cargt-00363-00365_defconfig
+++ b/configs/imx93-cargt-00363-00365_defconfig
@@ -116,8 +116,8 @@ CONFIG_SUPPORT_EMMC_RPMB=y
 CONFIG_SUPPORT_EMMC_BOOT=y
 CONFIG_MMC_IO_VOLTAGE=y
 CONFIG_MMC_UHS_SUPPORT=y
-CONFIG_MMC_HS400_ES_SUPPORT=y
-CONFIG_MMC_HS400_SUPPORT=y
+# CONFIG_MMC_HS400_ES_SUPPORT is not set
+# CONFIG_MMC_HS400_SUPPORT is not set
 CONFIG_FSL_USDHC=y
 CONFIG_MTD=y
 CONFIG_DM_SPI_FLASH=y
diff --git a/configs/imx93-cargt-00363-osm-som_defconfig b/configs/imx93-cargt-00363-osm-som_defconfig
index c350aef7ebc..c23e3f7d34c 100644
--- a/configs/imx93-cargt-00363-osm-som_defconfig
+++ b/configs/imx93-cargt-00363-osm-som_defconfig
@@ -116,8 +116,8 @@ CONFIG_SUPPORT_EMMC_RPMB=y
 CONFIG_SUPPORT_EMMC_BOOT=y
 CONFIG_MMC_IO_VOLTAGE=y
 CONFIG_MMC_UHS_SUPPORT=y
-CONFIG_MMC_HS400_ES_SUPPORT=y
-CONFIG_MMC_HS400_SUPPORT=y
+# CONFIG_MMC_HS400_ES_SUPPORT is not set
+# CONFIG_MMC_HS400_SUPPORT is not set
 CONFIG_FSL_USDHC=y
 CONFIG_MTD=y
 CONFIG_DM_SPI_FLASH=y
-- 
2.34.1

