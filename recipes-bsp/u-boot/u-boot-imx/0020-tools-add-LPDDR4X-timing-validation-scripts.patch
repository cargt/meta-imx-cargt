new file mode 100644
index 00000000000..9cb63c42ce1
--- /dev/null
+++ b/tools/cargt_timing_array_compare.py
@@ -0,0 +1,154 @@
+#!/usr/bin/env python3
+"""
+Compare dram timing arrays between a generated reference C file and the
+board timing C file by resolving the dram_timing initializer and the
+referenced arrays.
+
+Usage: tools/cargt_timing_array_compare.py GENERATED.c BOARD.c
+
+Prints per-role comparisons (ddrc_cfg, ddrphy_cfg, ddrphy_trained_csr,
+ddrphy_pie, fsp_msg, fsp_table). Returns non-zero if any difference found.
+"""
+import re
+import sys
+from pathlib import Path
+
+
+def read_text(p):
+    return Path(p).read_text()
+
+
+def find_dram_timing_assignments(text):
+    # Find the dram_timing struct initializer (last occurrence)
+    m = list(re.finditer(r"struct\s+dram_timing_info\s+\w+\s*=\s*\{", text))
+    if not m:
+        return None
+    pos = m[-1].start()
+    # Extract until the closing '};' after pos
+    sub = text[pos:]
+    # naive find matching closing '};'
+    idx = sub.find('};')
+    if idx == -1:
+        return None
+    init = sub[:idx+2]
+    # Find assignments like .ddrc_cfg = ddr_ddrc_cfg,
+    assigns = dict(re.findall(r"\.(\w+)\s*=\s*([\w_]+)\s*,", init))
+    # Also fsp_table may be an inline initializer like .fsp_table = {3200,1866,625}
+    fsp_m = re.search(r"\.fsp_table\s*=\s*\{([^}]+)\}", init)
+    if fsp_m:
+        assigns['fsp_table_values'] = [s.strip() for s in fsp_m.group(1).split(',') if s.strip()]
+    return assigns
+
+
+def extract_array(text, name):
+    # match static struct dram_cfg_param <name>[] = { ... };
+    pat = re.compile(r"static\s+struct\s+\w+\s+%s\s*\[\s*\]\s*=\s*\{" % re.escape(name))
+    m = pat.search(text)
+    if not m:
+        # try non-static or different type
+        pat2 = re.compile(r"struct\s+\w+\s+%s\s*\[\s*\]\s*=\s*\{" % re.escape(name))
+        m = pat2.search(text)
+        if not m:
+            return None
+    start = m.end()
+    sub = text[start:]
+    # find matching closing '};' for the array
+    level = 1
+    i = 0
+    while i < len(sub):
+        if sub[i] == '{':
+            level += 1
+        elif sub[i] == '}':
+            level -= 1
+            if level == 0:
+                arr_text = sub[:i]
+                break
+        i += 1
+    else:
+        return None
+    # split top-level initializer entries (separated by '},')
+    entries = re.findall(r"\{([^}]*)\}", arr_text)
+    cleaned = []
+    for e in entries:
+        # split numbers
+        nums = [s.strip() for s in re.split(r',', e) if s.strip()]
+        cleaned.append(nums)
+    return cleaned
+
+
+def compare_arrays(a, b):
+    if a is None and b is None:
+        return True, 'both missing'
+    if a is None or b is None:
+        return False, 'one missing'
+    if len(a) != len(b):
+        return False, f'len {len(a)} vs {len(b)}'
+    for i, (ea, eb) in enumerate(zip(a, b)):
+        if len(ea) != len(eb):
+            return False, f'entry {i} len {len(ea)} vs {len(eb)}'
+        # compare numeric equivalence: strip leading zeros/case
+        for x, y in zip(ea, eb):
+            if normalize_num(x) != normalize_num(y):
+                return False, f'diff at entry {i}: {ea} vs {eb}'
+    return True, 'match'
+
+
+def normalize_num(s):
+    s = s.strip()
+    # remove casts and U suffixes
+    s = re.sub(r"\(.*?\)", '', s)
+    s = s.rstrip('uUlL')
+    # hex to int
+    try:
+        if s.lower().startswith('0x'):
+            return str(int(s, 16))
+        return str(int(s))
+    except Exception:
+        # fallback: normalized whitespace
+        return s
+
+
+def main():
+    print('DEBUG: cargt_timing_array_compare starting')
+    if len(sys.argv) != 3:
+        print('Usage: cargt_timing_array_compare.py GENERATED.c BOARD.c')
+        return 2
+    genf = sys.argv[1]
+    boardf = sys.argv[2]
+    gen = read_text(genf)
+    board = read_text(boardf)
+
+    g_assigns = find_dram_timing_assignments(gen)
+    b_assigns = find_dram_timing_assignments(board)
+    if not g_assigns or not b_assigns:
+        print('Failed to locate dram_timing initializer in one of the files')
+        return 2
+
+    roles = ['ddrc_cfg', 'ddrphy_cfg', 'ddrphy_trained_csr', 'ddrphy_pie', 'fsp_msg']
+    results = {}
+    for r in roles:
+        gname = g_assigns.get(r)
+        bname = b_assigns.get(r)
+        ga = extract_array(gen, gname) if gname else None
+        ba = extract_array(board, bname) if bname else None
+        ok, note = compare_arrays(ga, ba)
+        results[r] = (ok, note, gname, bname)
+
+    # fsp_table values
+    gft = g_assigns.get('fsp_table_values')
+    bft = b_assigns.get('fsp_table_values')
+    fsp_ok = (gft == bft)
+
+    # print summary
+    print(f'Comparing {genf} -> {boardf}')
+    any_diff = False
+    for r in roles:
+        ok, note, gname, bname = results[r]
+        status = 'OK' if ok else 'DIFF'
+        if not ok:
+            any_diff = True
+        print(f'- {r}: {status} ({note})  gen={gname} board={bname}')
+
+    print(f'- fsp_table: {"OK" if fsp_ok else "DIFF"} gen={gft} board={bft}')
+
+    return 1 if any_diff or not fsp_ok else 0
\ No newline at end of file
