@@ -0,0 +1,113 @@
+#!/usr/bin/env python3
+"""
+Batch-compare all generated timing reference files against the board timing
+after applying the same runtime rank patches used in SPL.
+
+Usage: tools/compare_all_generated_vs_board.py
+
+Writes a short report to stdout and exits with non-zero if any diff found.
+"""
+import re
+from pathlib import Path
+import subprocess
+import sys
+
+ROOT = Path(__file__).resolve().parents[1]
+GEN_DIR = ROOT / 'board' / 'cargt' / 'imx93_00363' / 'generated_timings_for_reference'
+BOARD_DIR = ROOT / 'board' / 'cargt' / 'imx93_00363'
+TMP = Path('/tmp')
+
+# simple ddrc and fsp patches used in SPL for rank==2
+DDRC_PATCHES = {
+    '0x4e300110': '0x44104001',
+    '0x4e300080': '0x80000412',
+    '0x4e300084': '0x80000412',
+}
+
+FSP_PATCHES = {
+    '0x54012': '0x310',
+    '0x5401b': '0x1126',
+    '0x54021': '0x1126',
+    '0x54034': '0x2600',
+    '0x5403a': '0x2600',
+}
+
+def read_text(p):
+    return p.read_text()
+
+
+def apply_patches_to_board(board_text, rank):
+    text = board_text
+    if rank != 2:
+        return text
+
+    # patch ddrc entries: {0xADDR, 0xVAL}
+    for reg, val in DDRC_PATCHES.items():
+        # replace occurrences like {0x4e300110, 0x44100001}
+        text = re.sub(r"\{" + re.escape(reg) + r"\s*,\s*0x[0-9a-fA-F]+\}",
+                      '{' + reg + ', ' + val + '}', text)
+
+    # patch fsp arrays (dram_cfg_param entries with {0xADDR, 0xVAL})
+    for reg, val in FSP_PATCHES.items():
+        text = re.sub(r"\{" + re.escape(reg) + r"\s*,\s*0x[0-9a-fA-F]+\}",
+                      '{' + reg + ', ' + val + '}', text)
+
+    return text
+
+
+def pick_board_file_for_gen(gen_name):
+    # gen_name examples: lpddr4x_2g_3200_rank2_generated.c
+    if '1g_3200' in gen_name:
+        return BOARD_DIR / 'cargt_lpddr4x_1gbyte_3200mts_timing.c'
+    if '1g_3733' in gen_name:
+        return BOARD_DIR / 'cargt_lpddr4x_1gbyte_3733mts_timing.c'
+    if '2g_3200' in gen_name:
+        return BOARD_DIR / 'cargt_lpddr4x_2gbyte_3200mts_timing.c'
+    if '2g_3733' in gen_name:
+        return BOARD_DIR / 'cargt_lpddr4x_2gbyte_3733mts_timing.c'
+    # No mapping for 512MB variants; they will be skipped if no board file
+    # exists for that size/speed combination.
+    return None
+
+
+def gen_rank_from_name(gen_name):
+    return 2 if '_rank2_' in gen_name or gen_name.endswith('_rank2_generated.c') or '_rank2' in gen_name else 1
+
+
+def main():
+    gen_files = sorted(GEN_DIR.glob('*.c'))
+    if not gen_files:
+        print('No generated reference files found in', GEN_DIR)
+        return 2
+
+    comparator = ROOT / 'tools' / 'cargt_timing_array_compare.py'
+    any_diff = False
+    for gf in gen_files:
+        gen_name = gf.name
+        board_file = pick_board_file_for_gen(gen_name)
+        if board_file is None or not board_file.exists():
+            print('Skip', gen_name, '- no board file')
+            continue
+
+        rank = gen_rank_from_name(gen_name)
+        board_text = read_text(board_file)
+        patched = apply_patches_to_board(board_text, rank)
+
+        tmp_board = TMP / f'patched_board_{gen_name}'
+        tmp_board.write_text(patched)
+
+        print(f'Comparing {gf.name} vs patched {tmp_board.name} (rank {rank})')
+        p = subprocess.run([sys.executable, str(comparator), str(gf), str(tmp_board)], capture_output=True, text=True)
+        print(p.stdout)
+        if p.returncode != 0:
+            any_diff = True
+            print('DIFFERENCES found for', gen_name)
+        else:
+            print('MATCH for', gen_name)
+
+    return 1 if any_diff else 0
+
+
+if __name__ == '__main__':
+    rc = main()
+    sys.exit(rc)
