new file mode 100644
index 00000000000..0c4bbac2c63
--- /dev/null
+++ b/tools/cargt_timing_compare.py
@@ -0,0 +1,45 @@
+#!/usr/bin/env python3
+"""
+Simple comparator to diff a generated timing file against a board timing file.
+Usage: tools/cargt_timing_compare.py GENERATED.c BOARD.c
+Prints a unified diff of the two files after stripping comments and normalizing whitespace.
+"""
+import sys
+import re
+from pathlib import Path
+from difflib import unified_diff
+
+
+def normalize(path):
+    s = Path(path).read_text()
+    # remove C comments
+    s = re.sub(r'/\*.*?\*/', '', s, flags=re.S)
+    s = re.sub(r'//.*?\n', '\n', s)
+    # collapse multiple whitespace
+    s = re.sub(r'\s+', ' ', s)
+    # put one token per line for easier diff: split by semicolon and braces
+    tokens = re.split(r'(;|\{|\})', s)
+    lines = []
+    cur = ''
+    for t in tokens:
+        cur += t
+        if t in (';', '{', '}'):
+            lines.append(cur.strip())
+            cur = ''
+    if cur.strip():
+        lines.append(cur.strip())
+    return lines
+
+
+def main():
+    if len(sys.argv) != 3:
+        print("Usage: cargt_timing_compare.py GENERATED.c BOARD.c")
+        return 2
+    a = normalize(sys.argv[1])
+    b = normalize(sys.argv[2])
+    for line in unified_diff(a, b, fromfile=sys.argv[1], tofile=sys.argv[2], lineterm=''):
+        print(line)
+    return 0
+
+if __name__ == '__main__':
+    sys.exit(main())
