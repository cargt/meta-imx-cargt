+++ b/tools/compare_generated_vs_board.sh
@@ -0,0 +1,88 @@
+#!/usr/bin/env bash
+set -euo pipefail
+ROOT=$(pwd)
+GEN_DIR=board/cargt/imx93_00363/generated_timings_for_reference
+BOARD_DIR=board/cargt/imx93_00363
+OUT=tools/compare_generated_summary.txt
+echo "Comparing generated timings -> board timings" > "$OUT"
+
+# map generated filename tokens to board filename
+map_board() {
+  local gen=$1
+  # extract size and speed from filename
+  # e.g. lpddr4x_1g_3200_rank1_generated.c
+  if [[ $gen =~ lpddr4x_([12])g_([0-9]+)_rank([0-9]+)_generated\.c$ ]]; then
+    size_g=${BASH_REMATCH[1]}
+    speed=${BASH_REMATCH[2]}
+    # size in MB
+    if [[ $size_g == "1" ]]; then size_mb=1024; else size_mb=2048; fi
+    if [[ $speed == "3200" ]]; then sf="3200mts"; else sf="3733mts"; fi
+    if [[ $size_mb -eq 1024 ]]; then
+      echo "$BOARD_DIR/cargt_lpddr4x_1gbyte_${sf}_timing.c"
+    else
+      echo "$BOARD_DIR/cargt_lpddr4x_2gbyte_${sf}_timing.c"
+    fi
+  else
+    echo "" # no match
+  fi
+}
+
+# Normalize array text: remove comments, whitespace, collapse numbers
+norm() {
+  sed -e 's:/\*.*\*/::g' -e 's://.*$::' | tr -s ' \t\n' ' ' | sed 's/^[ \t]*//;s/[ \t]*$//' 
+}
+
+for genf in "$GEN_DIR"/*.c; do
+  fname=$(basename "$genf")
+  boardf=$(map_board "$fname")
+  if [[ -z "$boardf" || ! -f "$boardf" ]]; then
+    echo "$fname -> no matching board file" | tee -a "$OUT"
+    continue
+  fi
+  echo "\nComparing $fname -> $(basename "$boardf")" | tee -a "$OUT"
+  # extract dram_timing initializer rhs names from each file
+  for role in ddrc_cfg ddrphy_cfg ddrphy_trained_csr ddrphy_pie fsp_msg; do
+    # get rhs name for generated
+    g_rhs=$(awk "/\.$role[[:space:]]*=/{print; exit}" "$genf" | sed -n 's/.*=\s*\(.*\),/\1/p')
+    b_rhs=$(awk "/\.$role[[:space:]]*=/{print; exit}" "$boardf" | sed -n 's/.*=\s*\(.*\),/\1/p')
+    if [[ -z "$g_rhs" && -z "$b_rhs" ]]; then
+      echo "- $role: missing in both" | tee -a "$OUT"
+      continue
+    fi
+    echo "- $role: gen=$g_rhs board=$b_rhs" | tee -a "$OUT"
+    # extract array bodies
+    if [[ -n "$g_rhs" ]]; then
+      awk "/\b$g_rhs\b\s*\[\s*\]\s*=\s*\{/ {p=1} p{print; if (/\};/){exit}}" "$genf" > /tmp/gen_arr.txt || true
+      norm < /tmp/gen_arr.txt > /tmp/gen_norm.txt || true
+    else
+      echo "" > /tmp/gen_norm.txt
+    fi
+    if [[ -n "$b_rhs" ]]; then
+      awk "/\b$b_rhs\b\s*\[\s*\]\s*=\s*\{/ {p=1} p{print; if (/\};/){exit}}" "$boardf" > /tmp/board_arr.txt || true
+      norm < /tmp/board_arr.txt > /tmp/board_norm.txt || true
+    else
+      echo "" > /tmp/board_norm.txt
+    fi
+    if cmp -s /tmp/gen_norm.txt /tmp/board_norm.txt; then
+      echo "  -> MATCH" | tee -a "$OUT"
+    else
+      echo "  -> DIFFER" | tee -a "$OUT"
+      # show small sample of diff
+      diff -u /tmp/gen_norm.txt /tmp/board_norm.txt | sed -n '1,40p' | tee -a "$OUT"
+    fi
+  done
+
+  # compare fsp_table inline values if present
+  gft=$(sed -n "/.fsp_table/ {n; p; q}" "$genf" | tr -d '\n') || true
+  bft=$(sed -n "/.fsp_table/ {n; p; q}" "$boardf" | tr -d '\n') || true
+  if [[ -n "$gft" || -n "$bft" ]]; then
+    if [[ "$gft" == "$bft" ]]; then
+      echo "- fsp_table: MATCH" | tee -a "$OUT"
+    else
+      echo "- fsp_table: DIFF gen='$gft' board='$bft'" | tee -a "$OUT"
+    fi
+  fi
+
+done
+
+echo "Summary written to $OUT"
