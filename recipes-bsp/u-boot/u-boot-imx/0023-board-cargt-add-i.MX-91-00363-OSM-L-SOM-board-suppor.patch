new file mode 100644
index 00000000000..c63d61fc627
--- /dev/null
+++ b/include/configs/imx91_00363.h
@@ -0,0 +1,161 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * Copyright 2025 Cargt Inc.
+ *
+ * Configuration for the Cargt 00363 OSM-L SOM on i.MX 91.
+ */
+
+#ifndef __IMX91_00363_H
+#define __IMX91_00363_H
+
+#include <linux/sizes.h>
+#include <linux/stringify.h>
+#include <asm/arch/imx-regs.h>
+#include "imx_env.h"
+
+/* Link Definitions */
+#define CFG_SYS_INIT_RAM_ADDR		0x80000000
+#define CFG_SYS_INIT_RAM_SIZE		0x200000
+
+#define CFG_SYS_SDRAM_BASE		0x80000000
+#define PHYS_SDRAM			0x80000000
+#define PHYS_SDRAM_SIZE			0x20000000 /* 512 MB minimum; runtime detection via EEPROM updates MMU */
+
+/*
+ * EEPROM landing zone in DRAM.
+ * Place it at the mid-point of the minimum density (512 MB) so it is
+ * always reachable regardless of the actual installed DRAM size.
+ */
+#define DEFAULT_SDRAM_SIZE_MB		(512)
+#define CARGT_EEPROM_DRAM_START		(PHYS_SDRAM + ((DEFAULT_SDRAM_SIZE_MB * SZ_1M) >> 1))
+#define DEFAULT_SDRAM_SPEED_MTS		(2400)
+#define CARGT_EEPROM_I2C_NAME		"i2c@44340000"	/* lpi2c1 */
+#define WDOG_BASE_ADDR			WDG3_BASE_ADDR
+
+#define CFG_SYS_UBOOT_BASE	\
+	(QSPI0_AMBA_BASE + CONFIG_SYS_MMCSD_RAW_MODE_U_BOOT_SECTOR * 512)
+
+#ifdef CONFIG_AHAB_BOOT
+#define AHAB_ENV "sec_boot=yes\0"
+#else
+#define AHAB_ENV "sec_boot=no\0"
+#endif
+
+#ifdef CONFIG_DISTRO_DEFAULTS
+#define BOOT_TARGET_DEVICES(func) \
+	func(MMC, mmc, 0) \
+	func(MMC, mmc, 1) \
+	func(USB, usb, 0)
+
+#include <config_distro_bootcmd.h>
+#else
+#define BOOTENV
+#endif
+
+#define CFG_MFG_ENV_SETTINGS \
+	CFG_MFG_ENV_SETTINGS_DEFAULT \
