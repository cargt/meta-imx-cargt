+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Copyright 2022 NXP
+ * Copyright 2025 Cargt Inc.
+ *
+ * Board file for the Cargt 00363 OSM-L SOM on i.MX 91.
+ */
+
+#include <common.h>
+#include <env.h>
+#include <efi_loader.h>
+#include <init.h>
+#include <miiphy.h>
+#include <netdev.h>
+#include <asm/global_data.h>
+#include <asm/arch-imx9/ccm_regs.h>
+#include <asm/arch/sys_proto.h>
+#include <asm/arch-imx9/imx91_pins.h>
+#include <asm/arch/clock.h>
+#include <power/pmic.h>
+#include <dm/device.h>
+#include <dm/uclass.h>
+#include <usb.h>
+#include <asm/gpio.h>
+
+DECLARE_GLOBAL_DATA_PTR;
+
+#define UART_PAD_CTRL	(PAD_CTL_DSE(6) | PAD_CTL_FSEL2)
+
+static iomux_v3_cfg_t const uart_pads[] = {
+	MX91_PAD_UART1_RXD__LPUART1_RX | MUX_PAD_CTRL(UART_PAD_CTRL),
+	MX91_PAD_UART1_TXD__LPUART1_TX | MUX_PAD_CTRL(UART_PAD_CTRL),
+};
+
+#if CONFIG_IS_ENABLED(EFI_HAVE_CAPSULE_SUPPORT)
+#define IMX_BOOT_IMAGE_GUID \
+	EFI_GUID(0x7a3e9b3f, 0xda91, 0x4f22, 0xbc, 0x17, \
+		 0x3c, 0x55, 0x9f, 0xeb, 0x7d, 0x42)
+
+struct efi_fw_image fw_images[] = {
+	{
+		.image_type_id = IMX_BOOT_IMAGE_GUID,
+		.fw_name = u"IMX91-00363",
+		.image_index = 1,
+	},
+};
+
+struct efi_capsule_update_info update_info = {
+	.dfu_string = "mmc 0=flash-bin raw 0 0x2000 mmcpart 1",
+	.num_images = ARRAY_SIZE(fw_images),
+	.images = fw_images,
+};
+
+#endif /* EFI_HAVE_CAPSULE_SUPPORT */
+
+int board_early_init_f(void)
+{
+	imx_iomux_v3_setup_multiple_pads(uart_pads, ARRAY_SIZE(uart_pads));
+
+	return 0;
+}
+
+static int setup_fec(void)
+{
+	return set_clk_enet(ENET_125MHZ);
+}
+
+int board_phy_config(struct phy_device *phydev)
+{
+	if (phydev->drv->config)
+		phydev->drv->config(phydev);
+
+	return 0;
+}
+
+int board_init(void)
+{
+	if (IS_ENABLED(CONFIG_FEC_MXC))
+		setup_fec();
+
+	return 0;
+}
+
+int board_late_init(void)
+{
+#ifdef CONFIG_ENV_IS_IN_MMC
+	board_late_mmc_env_init();
+#endif
+
+	env_set("sec_boot", "no");
+#ifdef CONFIG_AHAB_BOOT
+	env_set("sec_boot", "yes");
+#endif
+
+#ifdef CONFIG_ENV_VARS_UBOOT_RUNTIME_CONFIG
+	env_set("board_name", "00363");
+	env_set("board_rev", "iMX91");
+#endif
+	return 0;
+}
+
+#ifdef CONFIG_FSL_FASTBOOT
+#ifdef CONFIG_ANDROID_RECOVERY
+int is_recovery_key_pressing(void)
+{
+	return 0;
+}
+#endif /*CONFIG_ANDROID_RECOVERY*/
+#endif /*CONFIG_FSL_FASTBOOT*/
diff --git a/board/cargt/imx91_00363/spl-cargt.c b/board/cargt/imx91_00363/spl-cargt.c
new file mode 100644
index 00000000000..274e384ca7d
--- /dev/null
+++ b/board/cargt/imx91_00363/spl-cargt.c
@@ -0,0 +1,259 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Copyright 2025 Cargt Inc.
+ *
+ * SPL board init for Cargt 00363 OSM-L SOM on i.MX 91.
+ * Based on the i.MX 93 00363 SPL implementation.
+ */
+
+#include <common.h>
+#include <command.h>
+#include <cpu_func.h>
+#include <hang.h>
+#include <image.h>
+#include <init.h>
+#include <log.h>
+#include <spl.h>
+#include <asm/global_data.h>
+#include <asm/io.h>
+#include <asm/arch/imx91_pins.h>
+#include <asm/arch/mu.h>
+#include <asm/arch/clock.h>
+#include <asm/arch/sys_proto.h>
+#include <asm/mach-imx/boot_mode.h>
+#include <asm/mach-imx/mxc_i2c.h>
+#include <asm/arch-mx7ulp/gpio.h>
+#include <asm/mach-imx/ele_api.h>
+#include <asm/mach-imx/syscounter.h>
+#include <asm/sections.h>
+#include <dm/uclass.h>
+#include <ctype.h>
+#include <dm/device.h>
+#include <dm/uclass-internal.h>
+#include <dm/device-internal.h>
+#include <linux/delay.h>
+#include <asm/arch/clock.h>
+#include <asm/arch/ccm_regs.h>
+#include <asm/arch/ddr.h>
+#include <power/pmic.h>
+#include <power/pca9450.h>
+#include <asm/arch/trdc.h>
+#include "../common/cargt_eeprom.h"
+#include "../imx9x_00363_common/imx9x_00363_pmic.h"
+
+DECLARE_GLOBAL_DATA_PTR;
+
+static struct cargt_eeprom eeprom = {0};
+
+int spl_board_boot_device(enum boot_device boot_dev_spl)
+{
+#ifdef CONFIG_SPL_BOOTROM_SUPPORT
+	return BOOT_DEVICE_BOOTROM;
+#else
+	switch (boot_dev_spl) {
+	case SD1_BOOT:
+	case MMC1_BOOT:
+		return BOOT_DEVICE_MMC1;
+	case SD2_BOOT:
+	case MMC2_BOOT:
+		return BOOT_DEVICE_MMC2;
+	default:
+		return BOOT_DEVICE_NONE;
+	}
+#endif
+}
+
+void spl_board_init(void)
+{
+	struct cargt_eeprom *ep = CARGT_EEPROM_DATA;
+	int ret;
+
+	ret = ele_start_rng();
+	if (ret)
+		printf("Fail to start RNG: %d\n", ret);
+
+	/* Copy EEPROM contents to DRAM */
+	memcpy(ep, &eeprom, sizeof(*ep));
+}
+
+extern struct dram_timing_info cargt_lpddr4_512mb_2400mts_timing;
+extern struct dram_timing_info cargt_lpddr4_512mb_2400mts_caodt120_timing;
+extern struct dram_timing_info cargt_lpddr4_512mb_1600mts_timing;
+extern struct dram_timing_info cargt_lpddr4_1gbyte_2400mts_timing;
+extern struct dram_timing_info cargt_lpddr4_2gbyte_2400mts_timing;
+extern struct dram_timing_info cargt_lpddr4_2gbyte_2400mts_rank2_timing;
+
+/* Failsafe DRAM config — selected via Kconfig */
+#if IS_ENABLED(CONFIG_CARGT_IMX91_00363_FAILSAFE_DRAM_2GB_RANK2)
+# define FAILSAFE_DRAM_SIZE_MB	2048
+# define FAILSAFE_DRAM_RANK	2
+# define FAILSAFE_DRAM_RATE_MTS	2400
+# define failsafe_dram_timing	cargt_lpddr4_2gbyte_2400mts_rank2_timing
+#elif IS_ENABLED(CONFIG_CARGT_IMX91_00363_FAILSAFE_DRAM_512MB_1600MTS)
+# define FAILSAFE_DRAM_SIZE_MB	512
+# define FAILSAFE_DRAM_RANK	1
+# define FAILSAFE_DRAM_RATE_MTS	1600
+# define failsafe_dram_timing	cargt_lpddr4_512mb_1600mts_timing
+#elif IS_ENABLED(CONFIG_CARGT_IMX91_00363_FAILSAFE_DRAM_512MB_RANK1)
+# define FAILSAFE_DRAM_SIZE_MB	512
+# define FAILSAFE_DRAM_RANK	1
+# define FAILSAFE_DRAM_RATE_MTS	2400
+# define failsafe_dram_timing	cargt_lpddr4_512mb_2400mts_timing
+#elif IS_ENABLED(CONFIG_CARGT_IMX91_00363_FAILSAFE_DRAM_512MB_RANK1_CAODT120)
+# define FAILSAFE_DRAM_SIZE_MB	512
+# define FAILSAFE_DRAM_RANK	1
+# define FAILSAFE_DRAM_RATE_MTS	2400
+# define failsafe_dram_timing	cargt_lpddr4_512mb_2400mts_caodt120_timing
+#else
+# error "No CARGT_IMX91_00363_FAILSAFE_DRAM_* option selected"
+#endif
+
+/*
+ * Select a board-provided dram_timing_info based on DRAM size and rank.
+ * The i.MX 91 00363 SOM only uses LPDDR4 at 2400 MT/s; speed is not
+ * a selection criterion here.
+ */
+static struct dram_timing_info *select_dram_timing(uint16_t size_mbytes,
+						   uint8_t rank)
+{
+	switch (size_mbytes) {
+	case 2048:
+		if (rank == 2)
+			return &cargt_lpddr4_2gbyte_2400mts_rank2_timing;
+		return &cargt_lpddr4_2gbyte_2400mts_timing;
+
+	case 1024:
+		return &cargt_lpddr4_1gbyte_2400mts_timing;
+
+	case 512:
+		return &cargt_lpddr4_512mb_2400mts_timing;
+
+	default:
+		printf("Unsupported DRAM size %u MB — using failsafe %u MB/rank%u\n",
+		       size_mbytes, FAILSAFE_DRAM_SIZE_MB, FAILSAFE_DRAM_RANK);
+		return &failsafe_dram_timing;
+	}
+}
+
+void spl_dram_init(void)
+{
+	struct dram_timing_info *ptiming = &failsafe_dram_timing;
+	uint16_t dram_size_mbytes = FAILSAFE_DRAM_SIZE_MB;
+	uint8_t  dram_rank = FAILSAFE_DRAM_RANK;
+	bool use_failsafe = false;
+
+#if IS_ENABLED(CONFIG_CARGT_IMX91_00363_LPDDR4_TIMING_BY_EEPROM)
+	printf("Reading Cargt EEPROM over I2C...\n");
+	cargt_eeprom_read(&eeprom);
+	printf("Cargt EEPROM read complete.\n");
+
+	if (!cargt_eeprom_is_valid(&eeprom)) {
+		printf("WARNING: EEPROM blank or invalid magic — using failsafe %u MB/%u/rank%u\n",
+		       FAILSAFE_DRAM_SIZE_MB, FAILSAFE_DRAM_RATE_MTS, FAILSAFE_DRAM_RANK);
+		printf("         Program EEPROM with correct DDR parameters after boot.\n");
+		dram_size_mbytes = FAILSAFE_DRAM_SIZE_MB;
+		dram_rank        = FAILSAFE_DRAM_RANK;
+		use_failsafe     = true;
+	} else {
+		cargt_eeprom_print_prod_info(&eeprom);
+		dram_size_mbytes = cargt_eeprom_get_dram_size_mb(&eeprom);
+		dram_rank        = cargt_eeprom_get_dram_rank(&eeprom);
+	}
+
+#if CONFIG_CARGT_IMX91_00363_MIN_SDRAM_SIZE_MB > 0
+	if (dram_size_mbytes < CONFIG_CARGT_IMX91_00363_MIN_SDRAM_SIZE_MB) {
+		printf("WARNING: DRAM %u MB < minimum %u MB, loading failsafe %u MB/%u/rank%u\n",
+		       dram_size_mbytes, CONFIG_CARGT_IMX91_00363_MIN_SDRAM_SIZE_MB,
+		       FAILSAFE_DRAM_SIZE_MB, FAILSAFE_DRAM_RATE_MTS, FAILSAFE_DRAM_RANK);
+		dram_size_mbytes = FAILSAFE_DRAM_SIZE_MB;
+		dram_rank        = FAILSAFE_DRAM_RANK;
+		use_failsafe     = true;
+	}
+#endif
+
+	if (!use_failsafe)
+		ptiming = select_dram_timing(dram_size_mbytes, dram_rank);
+	printf("\tSelected LPDDR4 timing: %u MB (rank %u)\n",
+	       dram_size_mbytes, dram_rank);
+
+#endif /* CONFIG_CARGT_IMX91_00363_LPDDR4_TIMING_BY_EEPROM */
+
+	printf("DDR: %u MT/s\n", ptiming->fsp_msg[0].drate);
+	ddr_init(ptiming);
+
+	if (gd && gd->bd) {
+		gd->bd->bi_dram[0].start = CFG_SYS_SDRAM_BASE;
+		gd->bd->bi_dram[0].size = (phys_size_t)dram_size_mbytes * 1024 * 1024;
+		gd->ram_size = gd->bd->bi_dram[0].size;
+		printf("spl: saved dram_size=%llu (%u MB) to gd and bd\n",
+		       (unsigned long long)gd->ram_size, dram_size_mbytes);
+	}
+}
+
+#if CONFIG_IS_ENABLED(DM_PMIC_PCA9450)
+int power_init_board(void)
+{
+	/* i.MX 91 always uses LPDDR4 → VDDQ = 1.1V via BUCK2 */
+	return cargt_pca9451a_init(true);
+}
+#endif
+
+void board_init_f(ulong dummy)
+{
+	int ret;
+
+	/* Clear the BSS. */
+	memset(__bss_start, 0, __bss_end - __bss_start);
+
+	timer_init();
+
+	/*
+	 * Set up LPUART1 clocks and pads before arch_cpu_init() so that
+	 * preloader_console_init() works after spl_early_init(). arch_cpu_init()
+	 * may block for up to 40 s waiting on ELE (EdgeLock Enclave).
+	 */
+	clock_init_early();
+	init_uart_clk(LPUART1_CLK_ROOT);
+	board_early_init_f();	/* sets UART1 iomux pads */
+
+	arch_cpu_init();
+	spl_early_init();
+	preloader_console_init();
+
+	ret = imx9_probe_mu();
+	if (ret) {
+		printf("Fail to init ELE API\n");
+	} else {
+		printf("SOC: 0x%x\n", gd->arch.soc_rev);
+		printf("LC: 0x%x\n", gd->arch.lifecycle);
+	}
+
+	clock_init_late();
+
+	power_init_board();
+
+	if (!is_voltage_mode(VOLT_LOW_DRIVE))
+		set_arm_core_max_clk();
+
+	/* Init power of mix */
+	soc_power_init();
+
+	/* Setup TRDC for DDR access */
+	trdc_init();
+
+	/* DDR initialization */
+	spl_dram_init();
+
+	/* Put M33 into CPUWAIT for following kick */
+	ret = m33_prepare();
+	if (!ret)
+		printf("M33 prepare ok\n");
+
+	board_init_r(NULL, 0);
+}
+
+#ifdef CONFIG_ANDROID_SUPPORT
+int board_get_emmc_id(void) {
+	return 0;
+}
+#endif
