diff --git a/arch/arm/dts/imx91-cargt-00363-00365-u-boot.dtsi b/arch/arm/dts/imx91-cargt-00363-00365-u-boot.dtsi
new file mode 100644
index 00000000000..c7f971e1170
--- /dev/null
+++ b/arch/arm/dts/imx91-cargt-00363-00365-u-boot.dtsi
@@ -0,0 +1,50 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Copyright 2025 Cargt Inc.
+ */
+
+#include "imx91-cargt-00363-osm-som-u-boot.dtsi"
+
+&reg_usdhc2_vmmc {
+	u-boot,off-on-delay-us = <20000>;
+	bootph-pre-ram;
+};
+
+&pinctrl_usdhc2_reg {
+	bootph-pre-ram;
+};
+
+&pinctrl_usdhc2 {
+	bootph-pre-ram;
+};
+
+&pinctrl_usdhc2_gpio {
+	bootph-pre-ram;
+};
+
+&usdhc2 {
+	bootph-pre-ram;
+	fsl,signal-voltage-switch-extra-delay-ms = <8>;
+};
+
+&lpi2c2 {
+	bootph-pre-ram;
+};
+
+&pinctrl_lpi2c2 {
+	bootph-pre-ram;
+};
+
+&usbotg1 {
+	status = "okay";
+	extcon = <&ptn5110_51>;
+};
+
+&usbotg2 {
+	status = "okay";
+	extcon = <&ptn5110_52>;
+};
+
+&fec {
+	compatible = "fsl,imx91-fec", "fsl,imx93-fec", "fsl,imx8mq-fec";
+};
diff --git a/arch/arm/dts/imx91-cargt-00363-00365.dts b/arch/arm/dts/imx91-cargt-00363-00365.dts
new file mode 100644
index 00000000000..3550ccb6da3
--- /dev/null
+++ b/arch/arm/dts/imx91-cargt-00363-00365.dts
@@ -0,0 +1,311 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * Copyright 2025 Cargt Inc.
+ */
+
+/dts-v1/;
+
+#include <dt-bindings/usb/pd.h>
+#include "imx91-cargt-00363-osm-som.dts"
+
+/ {
+	model = "Cargt i.MX91 00363 OSM-L SOM on 00365 carrier board";
+	compatible = "cargt,imx91-00363-00365", "fsl,imx91";
+
+	aliases {
+		rtc0 = &rtc_i2c;
+		rtc1 = &bbnsm_rtc;
+	};
+
+	reg_usdhc2_vmmc: regulator-usdhc2 {
+		pinctrl-names = "default";
+		pinctrl-0 = <&pinctrl_usdhc2_reg>;
+		compatible = "regulator-fixed";
+		regulator-name = "SDIO_A_PWR_EN";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		gpio = <&gpio3 7 GPIO_ACTIVE_HIGH>;
+		off-on-delay-us = <12000>;
+		enable-active-high;
+	};
+};
+
+&lpi2c2 {
+	#address-cells = <1>;
+	#size-cells = <0>;
+	clock-frequency = <400000>;
+	pinctrl-names = "default", "sleep";
+	pinctrl-0 = <&pinctrl_lpi2c2>;
+	pinctrl-1 = <&pinctrl_lpi2c2>;
+	status = "okay";
+
+	pca9555_20: pca9555@20 {
+		compatible = "nxp,pca9555";
+		gpio-controller;
+		#gpio-cells = <2>;
+		reg = <0x20>;
+	};
+
+	ptn5110_51: tcpc@51 {
+		compatible = "nxp,ptn5110";
+		reg = <0x51>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&pinctrl_ptn5110_51>;
+		interrupt-parent = <&gpio2>;
+		interrupts = <9 IRQ_TYPE_LEVEL_LOW>;
+		status = "okay";
+
+		port {
+			typec1_dr_sw: endpoint {
+				remote-endpoint = <&usb1_drd_sw>;
+			};
+		};
+
+		connector {
+			compatible = "usb-c-connector";
+			label = "USB-C(A)";
+			power-role = "dual";
+			data-role = "dual";
+			try-power-role = "sink";
+			source-pdos = <PDO_FIXED(5000, 3000, PDO_FIXED_USB_COMM)>;
+			sink-pdos = <PDO_FIXED(5000, 3000, PDO_FIXED_USB_COMM)
+					PDO_VAR(5000, 20000, 3000)>;
+			op-sink-microwatt = <15000000>;
+			self-powered;
+		};
+	};
+
+	ptn5110_52: tcpc@52 {
+		compatible = "nxp,ptn5110";
+		reg = <0x52>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&pinctrl_ptn5110_52>;
+		interrupt-parent = <&gpio2>;
+		interrupts = <10 IRQ_TYPE_LEVEL_LOW>;
+		status = "okay";
+
+		port {
+			typec2_dr_sw: endpoint {
+				remote-endpoint = <&usb2_drd_sw>;
+			};
+		};
+
+		connector {
+			compatible = "usb-c-connector";
+			label = "USB-C(C)";
+			power-role = "dual";
+			data-role = "dual";
+			try-power-role = "sink";
+			source-pdos = <PDO_FIXED(5000, 3000, PDO_FIXED_USB_COMM)>;
+			sink-pdos = <PDO_FIXED(5000, 3000, PDO_FIXED_USB_COMM)
+					PDO_VAR(5000, 20000, 3000)>;
+			op-sink-microwatt = <15000000>;
+			self-powered;
+		};
+	};
+};
+
+&eqos {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pinctrl_eqos>;
+	phy-mode = "rgmii-id";
+	phy-handle = <&ethphy1>;
+	snps,reset-gpios = <&pca9555_20 0 GPIO_ACTIVE_LOW>;
+	snps,reset-delays-us = <10 20 200000>;
+	status = "okay";
+
+	mdio {
+		compatible = "snps,dwmac-mdio";
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		ethphy1: ethernet-phy@0 {
+			compatible = "ethernet-phy-ieee802.3-c22";
+			reg = <0>;
+			eee-broken-1000t;
+		};
+	};
+};
+
+&fec {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pinctrl_fec>;
+	phy-mode = "rgmii-id";
+	phy-handle = <&ethphy2>;
+	fsl,magic-packet;
+	phy-reset-gpios = <&pca9555_20 1 GPIO_ACTIVE_LOW>;
+	phy-reset-duration = <10>;
+	phy-reset-post-delay = <150>;
+	status = "okay";
+
+	mdio {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		ethphy2: ethernet-phy@0 {
+			compatible = "ethernet-phy-ieee802.3-c22";
+			reg = <0>;
+			eee-broken-1000t;
+		};
+	};
+};
+
+&usbotg1 {
+	dr_mode = "otg";
+	hnp-disable;
+	srp-disable;
+	adp-disable;
+	usb-role-switch;
+	disable-over-current;
+	samsung,picophy-pre-emp-curr-control = <3>;
+	samsung,picophy-dc-vol-level-adjust = <7>;
+	status = "okay";
+
+	port {
+		usb1_drd_sw: endpoint {
+			remote-endpoint = <&typec1_dr_sw>;
+		};
+	};
+};
+
+&usbotg2 {
+	dr_mode = "otg";
+	hnp-disable;
+	srp-disable;
+	adp-disable;
+	usb-role-switch;
+	disable-over-current;
+	samsung,picophy-pre-emp-curr-control = <3>;
+	samsung,picophy-dc-vol-level-adjust = <7>;
+	status = "okay";
+
+	port {
+		usb2_drd_sw: endpoint {
+			remote-endpoint = <&typec2_dr_sw>;
+		};
+	};
+};
+
+&usdhc2 {
+	pinctrl-names = "default", "state_100mhz", "state_200mhz";
+	pinctrl-0 = <&pinctrl_usdhc2>, <&pinctrl_usdhc2_gpio>;
+	pinctrl-1 = <&pinctrl_usdhc2_100mhz>, <&pinctrl_usdhc2_gpio>;
+	pinctrl-2 = <&pinctrl_usdhc2_200mhz>, <&pinctrl_usdhc2_gpio>;
+	vmmc-supply = <&reg_usdhc2_vmmc>;
+	cd-gpios = <&gpio3 0 GPIO_ACTIVE_LOW>;
+	bus-width = <4>;
+	no-sdio;
+	no-mmc;
+	max-frequency = <104000000>;
+	no-1-8-v;
+	status = "okay";
+};
+
+&iomuxc {
+	pinctrl_eqos: eqosgrp {
+		fsl,pins = <
+			MX91_PAD_ENET1_MDC__ENET1_MDC					0x57e
+			MX91_PAD_ENET1_MDIO__ENET_QOS_MDIO				0x57e
+			MX91_PAD_ENET1_RD0__ENET_QOS_RGMII_RD0				0x57e
+			MX91_PAD_ENET1_RD1__ENET_QOS_RGMII_RD1				0x57e
+			MX91_PAD_ENET1_RD2__ENET_QOS_RGMII_RD2				0x57e
+			MX91_PAD_ENET1_RD3__ENET_QOS_RGMII_RD3				0x57e
+			MX91_PAD_ENET1_RXC__ENET_QOS_RGMII_RXC				0x5fe
+			MX91_PAD_ENET1_RX_CTL__ENET_QOS_RGMII_RX_CTL			0x57e
+			MX91_PAD_ENET1_TD0__ENET_QOS_RGMII_TD0				0x57e
+			MX91_PAD_ENET1_TD1__ENET1_RGMII_TD1				0x57e
+			MX91_PAD_ENET1_TD2__ENET_QOS_RGMII_TD2				0x57e
+			MX91_PAD_ENET1_TD3__ENET_QOS_RGMII_TD3				0x57e
+			MX91_PAD_ENET1_TXC__CCM_ENET_QOS_CLOCK_GENERATE_TX_CLK		0x5fe
+			MX91_PAD_ENET1_TX_CTL__ENET_QOS_RGMII_TX_CTL			0x57e
+		>;
+	};
+
+	pinctrl_fec: fecgrp {
+		fsl,pins = <
+			MX91_PAD_ENET2_MDC__ENET2_MDC					0x57e
+			MX91_PAD_ENET2_MDIO__ENET2_MDIO					0x57e
+			MX91_PAD_ENET2_RD0__ENET2_RGMII_RD0				0x57e
+			MX91_PAD_ENET2_RD1__ENET2_RGMII_RD1				0x57e
+			MX91_PAD_ENET2_RD2__ENET2_RGMII_RD2				0x57e
+			MX91_PAD_ENET2_RD3__ENET2_RGMII_RD3				0x57e
+			MX91_PAD_ENET2_RXC__ENET2_RGMII_RXC				0x5fe
+			MX91_PAD_ENET2_RX_CTL__ENET2_RGMII_RX_CTL			0x57e
+			MX91_PAD_ENET2_TD0__ENET2_RGMII_TD0				0x57e
+			MX91_PAD_ENET2_TD1__ENET2_RGMII_TD1				0x57e
+			MX91_PAD_ENET2_TD2__ENET2_RGMII_TD2				0x57e
+			MX91_PAD_ENET2_TD3__ENET2_RGMII_TD3				0x57e
+			MX91_PAD_ENET2_TXC__ENET2_RGMII_TXC				0x5fe
+			MX91_PAD_ENET2_TX_CTL__ENET2_RGMII_TX_CTL			0x57e
+		>;
+	};
+
+	pinctrl_lpi2c2: lpi2c2grp {
+		fsl,pins = <
+			MX91_PAD_I2C2_SDA__LPI2C2_SDA				0x40000b9e
+			MX91_PAD_I2C2_SCL__LPI2C2_SCL				0x40000b9e
+		>;
+	};
+
+	pinctrl_ptn5110_51: ptn5110_51grp {
+		fsl,pins = <
+			MX91_PAD_GPIO_IO09__GPIO2_IO9				0x31e
+		>;
+	};
+
+	pinctrl_ptn5110_52: ptn5110_52grp {
+		fsl,pins = <
+			MX91_PAD_GPIO_IO10__GPIO2_IO10				0x31e
+		>;
+	};
+
+	pinctrl_usdhc2_reg: usdhc2reggrp {
+		fsl,pins = <
+			MX91_PAD_SD2_RESET_B__GPIO3_IO7				0x31e /* SDIO_A_PWR_EN */
+		>;
+	};
+
+	pinctrl_usdhc2_gpio: usdhc2gpiogrp {
+		fsl,pins = <
+			MX91_PAD_SD2_CD_B__GPIO3_IO0				0x31e
+		>;
+	};
+
+	pinctrl_usdhc2: usdhc2grp {
+		fsl,pins = <
+			MX91_PAD_SD2_CLK__USDHC2_CLK				0x1582
+			MX91_PAD_SD2_CMD__USDHC2_CMD				0x40001382
+			MX91_PAD_SD2_DATA0__USDHC2_DATA0			0x40001382
+			MX91_PAD_SD2_DATA1__USDHC2_DATA1			0x40001382
+			MX91_PAD_SD2_DATA2__USDHC2_DATA2			0x40001382
+			MX91_PAD_SD2_DATA3__USDHC2_DATA3			0x40001382
+			MX91_PAD_SD2_VSELECT__USDHC2_VSELECT			0x51e
+		>;
+	};
+
+	/* need to config the SION for data and cmd pad, refer to ERR052021 */
+	pinctrl_usdhc2_100mhz: usdhc2-100mhzgrp {
+		fsl,pins = <
+			MX91_PAD_SD2_CLK__USDHC2_CLK				0x158e
+			MX91_PAD_SD2_CMD__USDHC2_CMD				0x4000138e
+			MX91_PAD_SD2_DATA0__USDHC2_DATA0			0x4000138e
+			MX91_PAD_SD2_DATA1__USDHC2_DATA1			0x4000138e
+			MX91_PAD_SD2_DATA2__USDHC2_DATA2			0x4000138e
+			MX91_PAD_SD2_DATA3__USDHC2_DATA3			0x4000138e
+			MX91_PAD_SD2_VSELECT__USDHC2_VSELECT			0x51e
+		>;
+	};
+
+	/* need to config the SION for data and cmd pad, refer to ERR052021 */
+	pinctrl_usdhc2_200mhz: usdhc2-200mhzgrp {
+		fsl,pins = <
+			MX91_PAD_SD2_CLK__USDHC2_CLK				0x15fe
+			MX91_PAD_SD2_CMD__USDHC2_CMD				0x400013fe
+			MX91_PAD_SD2_DATA0__USDHC2_DATA0			0x400013fe
+			MX91_PAD_SD2_DATA1__USDHC2_DATA1			0x400013fe
+			MX91_PAD_SD2_DATA2__USDHC2_DATA2			0x400013fe
+			MX91_PAD_SD2_DATA3__USDHC2_DATA3			0x400013fe
+			MX91_PAD_SD2_VSELECT__USDHC2_VSELECT			0x51e
+		>;
+	};
+};
diff --git a/arch/arm/dts/imx91-cargt-00363-osm-som-u-boot.dtsi b/arch/arm/dts/imx91-cargt-00363-osm-som-u-boot.dtsi
new file mode 100644
index 00000000000..d39677a68dc
--- /dev/null
+++ b/arch/arm/dts/imx91-cargt-00363-osm-som-u-boot.dtsi
@@ -0,0 +1,165 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Copyright 2025 Cargt Inc.
+ */
+
+#include "imx91-u-boot.dtsi"
+
+/ {
+	wdt-reboot {
+		compatible = "wdt-reboot";
+		wdt = <&wdog3>;
+		bootph-pre-ram;
+		bootph-some-ram;
+	};
+
+	aliases {
