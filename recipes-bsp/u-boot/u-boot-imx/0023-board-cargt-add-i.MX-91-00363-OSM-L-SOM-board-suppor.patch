diff --git a/board/cargt/imx91_00363/Kconfig b/board/cargt/imx91_00363/Kconfig
new file mode 100644
index 00000000000..21a4b2b2140
--- /dev/null
+++ b/board/cargt/imx91_00363/Kconfig
@@ -0,0 +1,71 @@
+if TARGET_IMX91_00363
+
+config SYS_BOARD
+	default "imx91_00363"
+
+config SYS_VENDOR
+	default "cargt"
+
+config SYS_CONFIG_NAME
+	default "imx91_00363"
+
+choice
+	prompt "Select method to choose LPDDR4 timing for TARGET_IMX91_00363"
+	default CARGT_IMX91_00363_LPDDR4_TIMING_BY_EEPROM
+
+config CARGT_IMX91_00363_LPDDR4_TIMING_BY_EEPROM
+	bool "Using Cargt EEPROM contents for LPDDR4 timing selection"
+	help
+	  Select the LPDDR4 timing based on contents of EEPROM on SOM.
+	  This is the recommended default: the EEPROM stores the DDR size
+	  and rank so the SPL can pick the correct 2400 MT/s timing.
+
+endchoice
+
+choice
+	prompt "LPDDR4 failsafe timing (used when EEPROM is absent or blank)"
+	default CARGT_IMX91_00363_FAILSAFE_DRAM_512MB_1600MTS
+	depends on CARGT_IMX91_00363_LPDDR4_TIMING_BY_EEPROM
+
+config CARGT_IMX91_00363_FAILSAFE_DRAM_2GB_RANK2
+	bool "2 GB / 2400 MT/s / rank2 (IMAG16L4JCDG-046I)"
+	help
+	  Use the 2 GB dual-rank LPDDR4 timing as the fallback when the
+	  EEPROM has not been programmed. Correct for boards populated with
+	  the IMAG16L4JCDG-046I (16 Gb, dual-rank, x16, 1 channel, 2400 MT/s).
+
+config CARGT_IMX91_00363_FAILSAFE_DRAM_512MB_1600MTS
+	bool "512 MB / 1600 MT/s / rank1 (universal failsafe)"
+	help
+	  512 MB single-rank LPDDR4 timing at 1600 MT/s. Used as the failsafe
+	  when EEPROM is blank. Lower speed provides wider margins for parts
+	  that may not train reliably at 2400 MT/s without exact EEPROM config.
+	  Once EEPROM is programmed the device will switch to the 2400 MT/s
+	  timing on next boot.
+
+config CARGT_IMX91_00363_FAILSAFE_DRAM_512MB_RANK1
+	bool "512 MB / 2400 MT/s / rank1 / 60-ohm CA ODT"
+	help
+	  Use the 512 MB single-rank LPDDR4 timing as the fallback when the
+	  EEPROM has not been programmed. Correct for boards populated with
+	  a 512 MB single-rank LPDDR4 device.
+
+config CARGT_IMX91_00363_FAILSAFE_DRAM_512MB_RANK1_CAODT120
+	bool "512 MB / 2400 MT/s / rank1 / 120-ohm CA ODT (universal failsafe)"
+	help
+	  512 MB address mapping with 120-ohm CA ODT. Intended as a universal
+	  failsafe that works on both single-rank 512 MB parts and rank2 die
+	  (e.g. IMAG16L4JCDG-046I) used with rank1 addressing. Use this when
+	  a single image must cold-boot any part before EEPROM is programmed.
+
+endchoice
+
+config CARGT_IMX91_00363_MIN_SDRAM_SIZE_MB
+	int "Minimum required SDRAM size in MB (0 = no minimum)"
+	default 0
+	help
+	  If non-zero, the SPL will halt with an error if the EEPROM-reported
+	  DRAM size is less than this value. Set to 512 for machines that
+	  require at least 512 MB (the minimum supported density).
+
+endif
