diff --git a/board/cargt/imx9x_00363_common/imx9x_00363_board.h b/board/cargt/imx9x_00363_common/imx9x_00363_board.h
new file mode 100644
index 00000000000..db4c0360a78
--- /dev/null
+++ b/board/cargt/imx9x_00363_common/imx9x_00363_board.h
@@ -0,0 +1,37 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * Copyright (C) 2025 Cargt Inc.
+ *
+ * Common board constants for the Cargt 00363 OSM-L SOM.
+ * Shared between imx93_00363 and imx91_00363.
+ */
+
+#ifndef IMX9X_00363_BOARD_H
+#define IMX9X_00363_BOARD_H
+
+/* PMIC PCA9451A - I2C1 */
+#define CARGT_00363_PMIC_I2C_ADDR	0x25
+
+/* EEPROM AT24C02 - I2C1 */
+/* NOTE: CARGT_EEPROM_I2C_ADDR (0x50) is defined in board/cargt/common/cargt_eeprom.h */
+
+/* RTC RX8111 - I2C1 */
+#define CARGT_00363_RTC_I2C_ADDR	0x32
+
+/* WiFi IW612 regulator: WL_REG_ON = GPIO2_IO6 */
+#define CARGT_00363_WLAN_REG_ON_GPIO_BANK	2
+#define CARGT_00363_WLAN_REG_ON_GPIO_PIN	6
+
+/* RTC interrupt: RTC_nINT = GPIO2_IO7 */
+#define CARGT_00363_RTC_INT_GPIO_BANK	2
+#define CARGT_00363_RTC_INT_GPIO_PIN	7
+
+/*
+ * DDR density values stored in EEPROM (dramsize_mbytes field).
+ * Used by both imx93_00363 and imx91_00363 SPL to select timing.
+ */
+#define CARGT_00363_DDR_512MB		512
+#define CARGT_00363_DDR_1GB		1024
+#define CARGT_00363_DDR_2GB		2048
+
+#endif /* IMX9X_00363_BOARD_H */
diff --git a/board/cargt/imx9x_00363_common/imx9x_00363_pmic.c b/board/cargt/imx9x_00363_common/imx9x_00363_pmic.c
new file mode 100644
index 00000000000..efdf23b4e8d
--- /dev/null
+++ b/board/cargt/imx9x_00363_common/imx9x_00363_pmic.c
@@ -0,0 +1,78 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Copyright (C) 2025 Cargt Inc.
+ *
+ * Shared PCA9451A PMIC initialisation for the Cargt 00363 OSM-L SOM.
+ * Used by both imx93_00363 (LPDDR4X, VDDQ=0.6V) and
+ * imx91_00363 (LPDDR4, VDDQ=1.1V).
+ */
+
+#include <common.h>
+#include <power/pmic.h>
+#include <power/pca9450.h>
+#include <asm/arch/sys_proto.h>
+
+#include "imx9x_00363_pmic.h"
+#include "imx9x_00363_board.h"
+
+int cargt_pca9451a_init(bool lpddr4_vddq)
+{
+	struct udevice *dev;
+	int ret;
+	unsigned int val = 0, buck_val;
+
+	ret = pmic_get("pmic@25", &dev);
+	if (ret != 0) {
+		puts("ERROR: Get PMIC PCA9451A failed!\n");
+		return ret;
+	}
+	puts("PMIC: PCA9451A\n");
+
+	/* BUCKxOUT_DVS0/1 control BUCK123 output */
+	pmic_reg_write(dev, PCA9450_BUCK123_DVS, 0x29);
+
+	/* Enable DVS control through PMIC_STBY_REQ */
+	pmic_reg_write(dev, PCA9450_BUCK1CTRL, 0x59);
+
+	ret = pmic_reg_read(dev, PCA9450_PWR_CTRL);
+	if (ret < 0)
+		return ret;
+	else
+		val = ret;
+
+	if (is_voltage_mode(VOLT_LOW_DRIVE)) {
+		buck_val = 0x0c; /* 0.8V for Low drive mode */
+		printf("PMIC: Low Drive Voltage Mode\n");
+	} else if (is_voltage_mode(VOLT_NOMINAL_DRIVE)) {
+		buck_val = 0x10; /* 0.85V for Nominal drive mode */
+		printf("PMIC: Nominal Voltage Mode\n");
+	} else {
+		buck_val = 0x14; /* 0.9V for Over drive mode */
+		printf("PMIC: Over Drive Voltage Mode\n");
+	}
+
+	if (val & PCA9450_REG_PWRCTRL_TOFF_DEB) {
+		pmic_reg_write(dev, PCA9450_BUCK1OUT_DVS0, buck_val);
+		pmic_reg_write(dev, PCA9450_BUCK3OUT_DVS0, buck_val);
+	} else {
+		pmic_reg_write(dev, PCA9450_BUCK1OUT_DVS0, buck_val + 0x4);
+		pmic_reg_write(dev, PCA9450_BUCK3OUT_DVS0, buck_val + 0x4);
+	}
+
+	if (lpddr4_vddq) {
+		/* Set VDDQ to 1.1V via BUCK2 (required for LPDDR4) */
+		pmic_reg_write(dev, PCA9450_BUCK2OUT_DVS0, 0x28);
+	}
+	/* LPDDR4X: BUCK2 left at reset default 0.6V — no write needed */
+
+	/* Set standby voltage to 0.65V */
+	if (val & PCA9450_REG_PWRCTRL_TOFF_DEB)
+		pmic_reg_write(dev, PCA9450_BUCK1OUT_DVS1, 0x0);
+	else
+		pmic_reg_write(dev, PCA9450_BUCK1OUT_DVS1, 0x4);
+
+	/* I2C_LT_EN */
+	pmic_reg_write(dev, 0xa, 0x3);
+
+	return 0;
+}
diff --git a/board/cargt/imx9x_00363_common/imx9x_00363_pmic.h b/board/cargt/imx9x_00363_common/imx9x_00363_pmic.h
new file mode 100644
index 00000000000..956ce753402
--- /dev/null
+++ b/board/cargt/imx9x_00363_common/imx9x_00363_pmic.h
@@ -0,0 +1,29 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * Copyright (C) 2025 Cargt Inc.
+ *
+ * Shared PCA9451A PMIC initialisation for the Cargt 00363 OSM-L SOM.
+ * Used by both imx93_00363 (LPDDR4X, VDDQ=0.6V) and
+ * imx91_00363 (LPDDR4, VDDQ=1.1V).
+ */
+
+#ifndef IMX9X_00363_PMIC_H
+#define IMX9X_00363_PMIC_H
+
+#include <stdbool.h>
+
+/**
+ * cargt_pca9451a_init() - Initialise the PCA9451A PMIC on the 00363 SOM.
+ *
+ * Configures BUCK1/3 VDD_SOC/VDD_ARM rails for the active voltage drive mode
+ * and BUCK4/5/6 LDO rails to their nominal values.
+ *
+ * @lpddr4_vddq: When true, sets BUCK2 to 1.1 V for LPDDR4 VDDQ.
+ *               When false, BUCK2 is left at its reset default (0.6 V)
+ *               which is appropriate for LPDDR4X.
+ *
+ * Returns 0 on success, negative errno on failure.
+ */
+int cargt_pca9451a_init(bool lpddr4_vddq);
+
+#endif /* IMX9X_00363_PMIC_H */
