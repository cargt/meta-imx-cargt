-	bootph-pre-ram;
-};
-
-&pinctrl_uart2 {
-	bootph-pre-ram;
-};
-
-&pinctrl_usdhc2_gpio {
-	bootph-pre-ram;
-};
-
-&pinctrl_usdhc2 {
+&pinctrl_uart4 {
 	bootph-pre-ram;
 };
 
@@ -175,32 +154,6 @@
 	bootph-pre-ram;
 };
 
-&ethphy0 {
-	reset-gpios = <&gpio4 22 GPIO_ACTIVE_LOW>;
-	reset-assert-us = <15000>;
-	reset-deassert-us = <100000>;
-};
-
-&fec {
-	phy-reset-gpios = <&gpio4 2 GPIO_ACTIVE_LOW>;
-	phy-reset-duration = <15>;
-	phy-reset-post-delay = <100>;
-};
-
-&flexspi {
-	assigned-clock-parents = <&clk IMX8MP_SYS_PLL1_400M>;
-};
-
-&mipi_dsi {
-	/delete-property/ assigned-clocks;
-	/delete-property/ assigned-clock-parents;
-	/delete-property/ assigned-clock-rates;
-};
-
-&media_blk_ctrl {
-	assigned-clock-rates = <500000000>, <200000000>;
-};
-
 &usb_dwc3_0 {
 	compatible = "fsl,imx8mq-dwc3", "snps,dwc3";
 	assigned-clocks = <&clk IMX8MP_CLK_HSIO_AXI>;
diff --git a/arch/arm/dts/imx8mp-cargt-00377-00365.dts b/arch/arm/dts/imx8mp-cargt-00377-00365.dts
index a2ce3a4efa9..1717c7b9153 100644
--- a/arch/arm/dts/imx8mp-cargt-00377-00365.dts
+++ b/arch/arm/dts/imx8mp-cargt-00377-00365.dts
@@ -10,4 +10,225 @@
  
  / {
 	model = "Cargt i.MX8MP 00377 OSM-L SOM on 00365 carrier board";
- };
\ No newline at end of file
+ };
+
+  &lpi2c2 {
+	 #address-cells = <1>;
+	 #size-cells = <0>;
+	 clock-frequency = <400000>;
+	 pinctrl-names = "default", "sleep";
+	 pinctrl-0 = <&pinctrl_lpi2c2>;
+	 pinctrl-1 = <&pinctrl_lpi2c2>;
+	 status = "okay";
+ 
+	 pca9555_20: pca9555@20 {
+		 compatible = "nxp,pca9555";
+		 gpio-controller;
+		 #gpio-cells = <2>;
+		 reg = <0x20>;
+	 };
+ 
+	 ptn5110_51: tcpc@51 {
+		 compatible = "nxp,ptn5110";
+		 reg = <0x51>;
+		 pinctrl-names = "default";
+		 pinctrl-0 = <&pinctrl_ptn5110_51>;
+		 interrupt-parent = <&gpio5>;
+		 interrupts = <24 IRQ_TYPE_LEVEL_LOW>;	
+		 status = "okay";
+ 
+		 port {
+			 typec1_dr_sw: endpoint {
+				 remote-endpoint = <&usb3_0_drd_sw>;
+			 };
+		 };
+ 
+		 typec1_con: connector {
+			 compatible = "usb-c-connector";
+			 label = "USB-C";
+			 power-role = "dual";
+			 data-role = "dual";
+			 try-power-role = "sink";
+			 source-pdos = <PDO_FIXED(5000, 3000, PDO_FIXED_USB_COMM)>;
+			 sink-pdos = <PDO_FIXED(5000, 3000, PDO_FIXED_USB_COMM)
+					 PDO_VAR(5000, 20000, 3000)>;
+			 op-sink-microwatt = <15000000>;
+			 self-powered;
+		 };
+	 };
+ 
+	 ptn5110_52: tcpc@52 {
+		 compatible = "nxp,ptn5110";
+		 reg = <0x52>;
+		 pinctrl-names = "default";
+		 pinctrl-0 = <&pinctrl_ptn5110_52>;
+		 interrupt-parent = <&gpio4>;
+		 interrupts = <30 IRQ_TYPE_LEVEL_LOW>;			
+		 status = "okay";
+
+		usb_con: connector {
+			compatible = "usb-c-connector";
+			label = "USB-C";
+			power-role = "dual";
+			data-role = "dual";
+			try-power-role = "sink";
+			source-pdos = <PDO_FIXED(5000, 3000, PDO_FIXED_USB_COMM)>;
+			sink-pdos = <PDO_FIXED(5000, 3000, PDO_FIXED_USB_COMM)
+				     PDO_VAR(5000, 20000, 3000)>;
+			op-sink-microwatt = <15000000>;
+			self-powered;
+
+			ports {
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				port@1 {
+					reg = <1>;
+					typec_con_ss: endpoint {
+						remote-endpoint = <&usb3_data_ss>;
+					};
+				};
+			};
+
+	 };
+
+	cbtl04gp {
+		compatible = "nxp,cbtl04gp";
+		switch-gpios = <&pcal6416_1 4 GPIO_ACTIVE_LOW>;
+		orientation-switch;
+
+		port {
+			usb3_data_ss: endpoint {
+				remote-endpoint = <&typec_con_ss>;
+			};
+		};
+	};	 
+ };
+
+
+&uart2 {
+	/* OSM UART_A */
+ 	/* These pins are needed for ETH and USB interrupts
+	 * on the 00365 carrier board, so disable UART2
+	 */
+	status = "disabled";
+};
+
+&usb3_phy0 {
+	fsl,phy-tx-vref-tune = <0xe>;
+	fsl,phy-tx-preemp-amp-tune = <3>;
+	fsl,phy-tx-vboost-level = <5>;
+	fsl,phy-comp-dis-tune = <7>;
+	fsl,pcs-tx-deemph-3p5db = <0x21>;
+	fsl,phy-pcs-tx-swing-full = <0x7f>;
+	status = "okay";
+};
+
+&usb3_0 {
+	status = "okay";
+};
+
+&usb_dwc3_0 {
+	dr_mode = "otg";
+	hnp-disable;
+	srp-disable;
+	adp-disable;
+	usb-role-switch;
+	role-switch-default-mode = "none";
+	snps,dis-u1-entry-quirk;
+	snps,dis-u2-entry-quirk;
+	status = "okay";
+
+	port {
+		usb3_0_drd_sw: endpoint {
+			remote-endpoint = <&typec1_dr_sw>;
+		};
+	};
+};
+
+&usb3_phy1 {
+	fsl,phy-tx-preemp-amp-tune = <3>;
+	fsl,phy-tx-vref-tune = <0xb>;
+	status = "okay";
+};
+
+&usb3_1 {
+	status = "okay";
+};
+
+&usb_dwc3_1 {
+	vbus-supply = <&reg_usb_vbus>;
+	dr_mode = "peripheral";
+	status = "okay";
+};
+
+&usdhc2 {
+	assigned-clocks = <&clk IMX8MP_CLK_USDHC2>;
+	assigned-clock-rates = <400000000>;
+	pinctrl-names = "default", "state_100mhz", "state_200mhz";
+	pinctrl-0 = <&pinctrl_usdhc2>, <&pinctrl_usdhc2_gpio>;
+	pinctrl-1 = <&pinctrl_usdhc2_100mhz>, <&pinctrl_usdhc2_gpio>;
+	pinctrl-2 = <&pinctrl_usdhc2_200mhz>, <&pinctrl_usdhc2_gpio>;
+	cd-gpios = <&gpio2 12 GPIO_ACTIVE_LOW>;
+	vmmc-supply = <&reg_usdhc2_vmmc>;
+	bus-width = <4>;
+	status = "okay";
+};
+
+&iomuxc {
+	pinctrl_usdhc2: usdhc2grp {
+		fsl,pins = <
+			MX8MP_IOMUXC_SD2_CLK__USDHC2_CLK	0x190
+			MX8MP_IOMUXC_SD2_CMD__USDHC2_CMD	0x1d0
+			MX8MP_IOMUXC_SD2_DATA0__USDHC2_DATA0	0x1d0
+			MX8MP_IOMUXC_SD2_DATA1__USDHC2_DATA1	0x1d0
+			MX8MP_IOMUXC_SD2_DATA2__USDHC2_DATA2	0x1d0
+			MX8MP_IOMUXC_SD2_DATA3__USDHC2_DATA3	0x1d0
+			MX8MP_IOMUXC_GPIO1_IO04__USDHC2_VSELECT	0xc0
+		>;
+	};
+
+	pinctrl_usdhc2_100mhz: usdhc2-100mhzgrp {
+		fsl,pins = <
+			MX8MP_IOMUXC_SD2_CLK__USDHC2_CLK	0x194
+			MX8MP_IOMUXC_SD2_CMD__USDHC2_CMD	0x1d4
+			MX8MP_IOMUXC_SD2_DATA0__USDHC2_DATA0	0x1d4
+			MX8MP_IOMUXC_SD2_DATA1__USDHC2_DATA1	0x1d4
+			MX8MP_IOMUXC_SD2_DATA2__USDHC2_DATA2	0x1d4
+			MX8MP_IOMUXC_SD2_DATA3__USDHC2_DATA3	0x1d4
+			MX8MP_IOMUXC_GPIO1_IO04__USDHC2_VSELECT 0xc0
+		>;
+	};
+
+	pinctrl_usdhc2_200mhz: usdhc2-200mhzgrp {
+		fsl,pins = <
+			MX8MP_IOMUXC_SD2_CLK__USDHC2_CLK	0x196
+			MX8MP_IOMUXC_SD2_CMD__USDHC2_CMD	0x1d6
+			MX8MP_IOMUXC_SD2_DATA0__USDHC2_DATA0	0x1d6
+			MX8MP_IOMUXC_SD2_DATA1__USDHC2_DATA1	0x1d6
+			MX8MP_IOMUXC_SD2_DATA2__USDHC2_DATA2	0x1d6
+			MX8MP_IOMUXC_SD2_DATA3__USDHC2_DATA3	0x1d6
+			MX8MP_IOMUXC_GPIO1_IO04__USDHC2_VSELECT 0xc0
+		>;
+	};
+
+	pinctrl_usdhc2_gpio: usdhc2gpiogrp {
+		fsl,pins = <
+			MX8MP_IOMUXC_SD2_CD_B__GPIO2_IO12	0x1c4
+		>;
+	};
+	
+	pinctrl_ptn5110_51: ptn5110_51grp {
+		fsl,pins = <
+			MX8MP_IOMUXC_UART2_RXD__GPIO5_IO24		0x31e
+		>;
+	};
+
+	pinctrl_ptn5110_52: ptn5110_52grp {
+		fsl,pins = <
+			MX8MP_IOMUXC_SAI3_RXD__GPIO4_IO30		0x31e
+		>;
+	};
+
+ };
+  
\ No newline at end of file
diff --git a/arch/arm/dts/imx8mp-cargt-00377-osm-som.dts b/arch/arm/dts/imx8mp-cargt-00377-osm-som.dts
index bb8955f804f..5636ec27ffa 100644
--- a/arch/arm/dts/imx8mp-cargt-00377-osm-som.dts
+++ b/arch/arm/dts/imx8mp-cargt-00377-osm-som.dts
@@ -27,6 +27,24 @@
 		reg = <0x0 0x40000000 0 0xc0000000>,
 		      <0x1 0x00000000 0 0x40000000>;
 	};
+
+	reg_usdhc1_vmmc: regulator-usdhc1 {
+		pinctrl-names = "default";
+		pinctrl-0 = <&pinctrl_wifi_reg>;		
+		compatible = "regulator-fixed";
+		regulator-name = "WL_REG_ON";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		gpio = <&gpio2 10 GPIO_ACTIVE_HIGH>; /* WL_REG_ON connects to PDn signal on IW612 */
+		/*
+		 * IW612 wifi chip needs more delay than other wifi chips to complete
+		 * the host interface initialization after power up, otherwise the
+		 * internal state of IW612 may be unstable, resulting in the failure of
+		 * the SDIO3.0 switch voltage.
+		 */
+		startup-delay-us = <20000>;
+		enable-active-high;
+	};
 };
 
 
@@ -246,7 +264,7 @@
 	pinctrl-names = "default";
 	pinctrl-0 = <&pinctrl_uart2>;
 	fsl,uart-has-rtscts;
-	status = "okay";
+	status = "disabled";
 };
 
 &uart3 {
@@ -386,6 +404,17 @@
 		>;
 	};	
 
+	pinctrl_usdhc1_sleep: usdhc1grp-sleep {
+		fsl,pins = <
+			MX8MP_IOMUXC_SD1_CLK__USDHC1_CLK		0x100
+			MX8MP_IOMUXC_SD1_CMD__USDHC1_CMD		0x100
+			MX8MP_IOMUXC_SD1_DATA0__USDHC1_DATA0	0x100
+			MX8MP_IOMUXC_SD1_DATA1__USDHC1_DATA1	0x100
+			MX8MP_IOMUXC_SD1_DATA2__USDHC1_DATA2	0x100
+			MX8MP_IOMUXC_SD1_DATA3__USDHC1_DATA3	0x100
+		>;
+	};	
+
 	pinctrl_usdhc3: usdhc3grp {
 		fsl,pins = <
 			MX8MP_IOMUXC_NAND_WE_B__USDHC3_CLK	0x190
@@ -450,5 +479,11 @@
 		fsl,pins = <
 			MX8MP_IOMUXC_SD1_DATA5__GPIO2_IO07		0x31e /* RTC_nINT */
 		>;
-	 };	
-};
\ No newline at end of file
+	};	
+
+	pinctrl_wifi_reg: wifireggrp {
+		fsl,pins = <
+			MX8MP_IOMUXC_SD1_RESET_B__GPIO2_IO10	0x31e /* WL_REG_ON */
+		>;
+	};
+};
