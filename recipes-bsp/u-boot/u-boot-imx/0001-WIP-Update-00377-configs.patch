 arch/arm/dts/imx8mp-cargt-00377-00365.dts     | 223 +++++++++++++++++-
 arch/arm/dts/imx8mp-cargt-00377-osm-som.dts   |  41 +++-
 3 files changed, 261 insertions(+), 52 deletions(-)

diff --git a/arch/arm/dts/imx8mp-cargt-00377-00365-u-boot.dtsi b/arch/arm/dts/imx8mp-cargt-00377-00365-u-boot.dtsi
