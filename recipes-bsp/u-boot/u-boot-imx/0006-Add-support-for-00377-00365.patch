From 9d6277218fa1eca0bd1281776397cb803ef1e6f6 Mon Sep 17 00:00:00 2001
From: Tim Carney <tim.carney@cargt.com>
Date: Wed, 3 Dec 2025 14:17:48 -0600
Subject: [PATCH] Add support for 00377-00365.

Upstream-Status: Inappropriate [Cargt board specific]
---
 board/cargt/imx8mp_00377/imx8mp_00377.c       |  33 +--
 board/cargt/imx8mp_00377/spl.c                |  18 +-
 configs/imx8mp-cargt-00377-00365_defconfig    |   2 +-
 include/configs/imx8mp_00377.h                |  14 +-
 4 files changed, 29 insertions(+), 39 deletions(-)

diff --git a/board/cargt/imx8mp_00377/imx8mp_00377.c b/board/cargt/imx8mp_00377/imx8mp_00377.c
index 58f6d43c82a..b1b1e5f4895 100644
--- a/board/cargt/imx8mp_00377/imx8mp_00377.c
+++ b/board/cargt/imx8mp_00377/imx8mp_00377.c
@@ -79,7 +79,6 @@ int board_early_init_f(void)
 
 	init_uart_clk(3);
 
-	printf("Board early init done.\n");
 	return 0;
 }
 
@@ -129,6 +128,8 @@ int ft_board_setup(void *blob, struct bd_info *bd)
 #endif
 
 #ifdef CONFIG_USB_TCPC
+/* USB_TCPC is not implemented in U-Boot for 00377 yet */
+#else
 struct tcpc_port port1;
 struct tcpc_port port2;
 
@@ -186,8 +187,8 @@ int pd_switch_snk_enable(struct tcpc_port *port)
 
 /* Port2 is the power supply, port 1 does not support power */
 struct tcpc_port_config port1_config = {
-	.i2c_bus = 0, /*i2c1*/
-	.addr = 0x50,
+	.i2c_bus = 1, /*i2c2*/
+	.addr = 0x51,
 	.port_type = TYPEC_PORT_UFP,
 	.max_snk_mv = 20000,
 	.max_snk_ma = 3000,
@@ -198,7 +199,7 @@ struct tcpc_port_config port1_config = {
 };
 
 struct tcpc_port_config port2_config = {
-	.i2c_bus = 0, /*i2c1*/
+	.i2c_bus = 1, /*i2c2*/
 	.addr = 0x52,
 	.port_type = TYPEC_PORT_UFP,
 	.max_snk_mv = 20000,
@@ -370,6 +371,8 @@ int board_usb_init(int index, enum usb_init_type init)
 	if (index == 0 && init == USB_INIT_DEVICE) {
 		imx8m_usb_power(index, true);
 #ifdef CONFIG_USB_TCPC
+printf("USB_TCPC is not implemented in U-Boot for 00377 yet\n");
+#else
 		ret = tcpc_setup_ufp_mode(&port1);
 		if (ret)
 			return ret;
@@ -378,6 +381,8 @@ int board_usb_init(int index, enum usb_init_type init)
 		return dwc3_uboot_init(&dwc3_device_data);
 	} else if (index == 0 && init == USB_INIT_HOST) {
 #ifdef CONFIG_USB_TCPC
+printf("USB_TCPC is not implemented in U-Boot for 00377 yet\n");
+#else
 		ret = tcpc_setup_dfp_mode(&port1);
 #endif
 		return ret;
@@ -395,6 +400,8 @@ int board_usb_cleanup(int index, enum usb_init_type init)
 		imx8m_usb_power(index, false);
 	} else if (index == 0 && init == USB_INIT_HOST) {
 #ifdef CONFIG_USB_TCPC
+printf("USB_TCPC is not implemented in U-Boot for 00377 yet\n");
+#else
 		ret = tcpc_disable_src_vbus(&port1);
 #endif
 	}
@@ -403,6 +410,8 @@ int board_usb_cleanup(int index, enum usb_init_type init)
 }
 
 #ifdef CONFIG_USB_TCPC
+/* USB_TCPC is not implemented in U-Boot for 00377 yet */
+#else
 /* Not used so far */
 int board_typec_get_mode(int index)
 {
@@ -429,34 +438,26 @@ int board_typec_get_mode(int index)
 
 int board_init(void)
 {
-	printf("Board init\n");
-#ifdef CONFIG_DM_REGULATOR
-printf("Regulator init\n");
-	regulators_enable_boot_on(false);
-#endif
-
 #ifdef CONFIG_USB_TCPC
-	printf("Type-C PD init\n");
-	setup_typec();
+printf("***************************************************\n");
+printf("USB_TCPC is not implemented in U-Boot for 00377 yet\n");
+printf("***************************************************\n");
+	// setup_typec();
 #endif
 
 #ifdef CONFIG_NAND_MXS
-printf("NAND init\n");	
 	setup_gpmi_nand();
 #endif
 
 #if defined(CONFIG_USB_DWC3) || defined(CONFIG_USB_XHCI_IMX8M)
-	printf("USB init\n");	
 	init_usb_clk();
 #endif
 
-	printf("Board init done.\n");
 	return 0;
 }
 
 int board_late_init(void)
 {
-	printf("Board late init\n");
 #ifdef CONFIG_ENV_IS_IN_MMC
 	board_late_mmc_env_init();
 #endif
diff --git a/board/cargt/imx8mp_00377/spl.c b/board/cargt/imx8mp_00377/spl.c
index 4dcb80517bf..95015d51643 100644
--- a/board/cargt/imx8mp_00377/spl.c
+++ b/board/cargt/imx8mp_00377/spl.c
@@ -157,19 +157,14 @@ void board_init_f(ulong dummy)
 
 	board_early_init_f();
 
-	printf("Board init f finished\n");
-	printf("Timer init\n");
 	timer_init();
-	printf("Timer initialized\n");
-	printf("SPL early init\n");
+
 	ret = spl_early_init();
 	if (ret) {
-		printf("spl_early_init() failed: %d\n", ret);
+		debug("spl_early_init() failed: %d\n", ret);
 		hang();
 	}
-	printf("SPL early init done\n");
 
-	printf("Get clock device\n");
 	ret = uclass_get_device_by_name(UCLASS_CLK,
 					"clock-controller@30380000",
 					&dev);
@@ -178,23 +173,14 @@ void board_init_f(ulong dummy)
 		hang();
 	}
 
-	printf("Console init\n");
 	preloader_console_init();
-	printf("Console initialized\n");
 
-	printf("Enable TZC380\n");
 	enable_tzc380();
-	printf("TZC380 enabled\n");
 
-	printf("init board\n");
 	power_init_board();
-	printf("init board complete\n");
 
 	/* DDR initialization */
-	printf("init DRAM\n");
 	spl_dram_init();
-	printf("DRAM initialized\n");
 
-	printf("Jump to board_init_r\n");
 	board_init_r(NULL, 0);
 }
diff --git a/configs/imx8mp-cargt-00377-00365_defconfig b/configs/imx8mp-cargt-00377-00365_defconfig
index 88c528e3d56..5d1d101677a 100644
--- a/configs/imx8mp-cargt-00377-00365_defconfig
+++ b/configs/imx8mp-cargt-00377-00365_defconfig
@@ -34,7 +34,7 @@ CONFIG_OF_BOARD_FIXUP=y
 CONFIG_OF_BOARD_SETUP=y
 CONFIG_OF_SYSTEM_SETUP=y
 CONFIG_BOOTCOMMAND="run distro_bootcmd;run bsp_bootcmd"
-CONFIG_DEFAULT_FDT_FILE="imx8mp-cargt-00377-00365.dtb"
+CONFIG_DEFAULT_FDT_FILE="boot/imx8mp-cargt-00377-00365.dtb"
 CONFIG_ARCH_MISC_INIT=y
 CONFIG_BOARD_EARLY_INIT_F=y
 CONFIG_BOARD_LATE_INIT=y
diff --git a/include/configs/imx8mp_00377.h b/include/configs/imx8mp_00377.h
index da00825398f..7d5109524c3 100644
--- a/include/configs/imx8mp_00377.h
+++ b/include/configs/imx8mp_00377.h
@@ -31,7 +31,7 @@
 #define BOOTENV
 #endif
 
-#define JH_ROOT_DTB    "imx8mp-evk-root.dtb"
+#define JH_ROOT_DTB    "imx8mp-cargt-00377-00365.dtb"
 
 #define JAILHOUSE_ENV \
 	"jh_clk= \0 " \
@@ -91,7 +91,7 @@
 	"scriptaddr=0x43500000\0" \
 	"kernel_addr_r=" __stringify(CONFIG_SYS_LOAD_ADDR) "\0" \
 	"bsp_script=boot.scr\0" \
-	"image=Image\0" \
+	"image=boot/Image\0" \
 	"splashimage=0x50000000\0" \
 	"console=ttymxc3,115200\0" \
 	"fdt_addr_r=0x43000000\0"			\
@@ -105,12 +105,13 @@
 	"mmcpart=1\0" \
 	"mmcroot=/dev/mmcblk1p2 rootwait rw\0" \
 	"mmcautodetect=yes\0" \
-	"mmcargs=setenv bootargs ${jh_clk} ${mcore_clk} console=${console} root=${mmcroot}\0 " \
-	"loadbootscript=fatload mmc ${mmcdev}:${mmcpart} ${loadaddr} ${bsp_script};\0" \
+	"mmcargs=setenv bootargs ${jh_clk} console=${console} " \
+		"root=/dev/mmcblk${mmcdev}p${mmcpart} rootwait rw ${cargt_bootargs}\0" \
+	"loadbootscript=${loadcmd} mmc ${mmcdev}:${mmcpart} ${loadaddr} ${script};\0" \
 	"bootscript=echo Running bootscript from mmc ...; " \
 		"source\0" \
-	"loadimage=fatload mmc ${mmcdev}:${mmcpart} ${loadaddr} ${image}\0" \
-	"loadfdt=fatload mmc ${mmcdev}:${mmcpart} ${fdt_addr_r} ${fdtfile}\0" \
+	"loadimage=${loadcmd} mmc ${mmcdev}:${mmcpart} ${loadaddr} ${image}\0" \
+	"loadfdt=${loadcmd} mmc ${mmcdev}:${mmcpart} ${fdt_addr_r} ${fdtfile}\0" \
 	"mmcboot=echo Booting from mmc ...; " \
 		"run mmcargs; " \
 		"if test ${boot_fit} = yes || test ${boot_fit} = try; then " \
@@ -143,6 +144,7 @@
 			"fi; " \
 		"fi;\0" \
 	"bsp_bootcmd=echo Running BSP bootcmd ...; " \
+		"setenv loadcmd ext4load; " \
 		"mmc dev ${mmcdev}; if mmc rescan; then " \
 		   "if run loadbootscript; then " \
 			   "run bootscript; " \
