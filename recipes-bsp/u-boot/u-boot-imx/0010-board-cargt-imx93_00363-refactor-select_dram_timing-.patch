From 79d0b4c582749b62a476e3a5d02ae697a6d36723 Mon Sep 17 00:00:00 2001
From: Tim Carney <tim.carney@cargt.com>
Date: Tue, 26 May 2026 12:14:15 -0500
Subject: [PATCH] board/cargt(imx93_00363): refactor select_dram_timing() to
 switch-by-size for readability

---
 board/cargt/imx93_00363/spl-cargt.c | 41 ++++++++++++++---------------
 1 file changed, 20 insertions(+), 21 deletions(-)

diff --git a/board/cargt/imx93_00363/spl-cargt.c b/board/cargt/imx93_00363/spl-cargt.c
index 6ffd0cc7f3f..01d547632d9 100644
--- a/board/cargt/imx93_00363/spl-cargt.c
+++ b/board/cargt/imx93_00363/spl-cargt.c
@@ -90,30 +90,29 @@ static struct dram_timing_info *select_dram_timing(uint16_t speed_mts,
 												  uint16_t size_mbytes,
 												  uint8_t rank)
 {
-	/* Prefer 3200 MT/s as the default speed and prefer 512MB as default */
-	if (speed_mts == 3200) {
-		if (size_mbytes == 2048)
-			return &cargt_lpddr4x_2gbyte_3200mts_timing;
-		if (size_mbytes == 512)
-			return &cargt_lpddr4x_512mb_3200mts_timing;
-		/* default case falls back to 512MB */
-		return &cargt_lpddr4x_512mb_3200mts_timing;
-	}
-
-	if (speed_mts == 3733) {
-		if (size_mbytes == 2048)
+	/* Choose by size first to make the cases explicit and readable */
+	switch (size_mbytes) {
+	case 2048: /* 2 GB */
+		if (speed_mts == 3733)
 			return &cargt_lpddr4x_2gbyte_3733mts_timing;
-		if (size_mbytes == 512)
-			return &cargt_lpddr4x_512mb_3733mts_timing;
-		/* otherwise fall back to 1GB@3733 */
-		return &cargt_lpddr4x_1gbyte_3733mts_timing;
-	}
-
-	/* Fallback: prefer 3200/512 variants */
-	if (size_mbytes == 2048)
+		/* default to 3200 for 2GB */
 		return &cargt_lpddr4x_2gbyte_3200mts_timing;
 
-	return &cargt_lpddr4x_512mb_3200mts_timing;
+	case 1024: /* 1 GB */
+		if (speed_mts == 3733)
+			return &cargt_lpddr4x_1gbyte_3733mts_timing;
+		/* default to 3200 for 1GB */
+		return &cargt_lpddr4x_1gbyte_3200mts_timing;
+
+	case 512: /* 512 MB */
+		if (speed_mts == 3733)
+			return &cargt_lpddr4x_512mb_3733mts_timing;
+		/* default to 3200 for 512MB */
+		return &cargt_lpddr4x_512mb_3200mts_timing;
+
+	default: /* unknown size: fall back to the preferred default (512MB@3200) */
+		return &cargt_lpddr4x_512mb_3200mts_timing;
+	}
 }
 
