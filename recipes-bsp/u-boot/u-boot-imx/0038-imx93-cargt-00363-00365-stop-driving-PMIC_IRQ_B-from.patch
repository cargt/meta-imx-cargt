From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Graham Taylor-Jones <graham.taylor-jones@cargt.com>
Date: Wed, 4 Nov 2026 10:09:08 -0600
Subject: [PATCH] imx93-cargt-00363-00365: stop driving PMIC_IRQ_B from u-boot

The 00365 u-boot dts carried an always-on, pre-reloc carrier-pwr-en
regulator that drove GPIO1_IO10 high from SPL. On the 00363 SOM that
pad (PDM_BIT_STREAM1) is PMIC_IRQ_B; CARRIER_PWR_EN is driven by the
buffered reset, not a GPIO. The kernel 00365 dts has no such regulator.

Drop the regulator, its pinctrl group, the unused pinctrl_pca21 group
on the same pad and their bootph overrides, leaving the pin as an
input. Same change as the 00428 one before it.

Backport of the regulator part of meta-imx-cargt wrynose !56, by Tim
Carney.

Upstream-Status: Inappropriate [Cargt board support]
Signed-off-by: Graham Taylor-Jones <graham.taylor-jones@cargt.com>
---
 .../dts/imx93-cargt-00363-00365-u-boot.dtsi   |  8 ------
 arch/arm/dts/imx93-cargt-00363-00365.dts      | 25 -------------------
 2 files changed, 33 deletions(-)

diff --git a/arch/arm/dts/imx93-cargt-00363-00365-u-boot.dtsi b/arch/arm/dts/imx93-cargt-00363-00365-u-boot.dtsi
index 708e1759552..27d1b3a9108 100644
--- a/arch/arm/dts/imx93-cargt-00363-00365-u-boot.dtsi
+++ b/arch/arm/dts/imx93-cargt-00363-00365-u-boot.dtsi
@@ -71,14 +71,6 @@
 	bootph-some-ram;
 };
 
-&reg_carrier_pwr_en {
-	bootph-pre-ram;
-};
-
-&pinctrl_reg_carrer_pwr_en{
-	bootph-pre-ram;
-};
-
 &reg_usdhc2_vmmc {
 	u-boot,off-on-delay-us = <20000>;
 	bootph-pre-ram;
diff --git a/arch/arm/dts/imx93-cargt-00363-00365.dts b/arch/arm/dts/imx93-cargt-00363-00365.dts
index 533139b9d3c..fc645d4ad9c 100644
--- a/arch/arm/dts/imx93-cargt-00363-00365.dts
+++ b/arch/arm/dts/imx93-cargt-00363-00365.dts
@@ -16,20 +16,6 @@
 		 rtc1 = &bbnsm_rtc;
 	 };
  
-	 reg_carrier_pwr_en: regulator-carrier-pwr-en {
-		 compatible = "regulator-fixed";
-		 pinctrl-names = "default";
-		 pinctrl-0 = <&pinctrl_reg_carrer_pwr_en>;
-		 regulator-name = "carrier-pwr-en";
-		 regulator-min-microvolt = <3300000>;
-		 regulator-max-microvolt = <3300000>;
-		 gpio = <&gpio1 10 GPIO_ACTIVE_HIGH>;
-		 off-on-delay-us = <12000>;
-		 enable-active-high;
-		 regulator-boot-on;
-		 regulator-always-on;		
-	 };
- 
 	 reg_usdhc2_vmmc: regulator-usdhc2 {
 		 pinctrl-names = "default";
 		 pinctrl-0 = <&pinctrl_usdhc2_reg>;		
@@ -321,12 +307,6 @@
 		 >;
 	 };
  
-	 pinctrl_pca21: pca21grp {
-		 fsl,pins = <
-			 MX93_PAD_PDM_BIT_STREAM1__GPIO1_IO10 	0x31e
-		 >;
-	 };
- 
 	 pinctrl_flexcan1: flexcan1grp {
 		 fsl,pins = <
 			 MX93_PAD_PDM_CLK__CAN1_TX				0x139e
@@ -387,11 +367,6 @@
 		 >;
 	  };
  
-	  pinctrl_reg_carrer_pwr_en: carrerpwrengrp {
-		 fsl,pins = <
-			 MX93_PAD_PDM_BIT_STREAM1__GPIO1_IO10		0x31e
-		 >;
-	 };
  
  };
   
\ No newline at end of file
