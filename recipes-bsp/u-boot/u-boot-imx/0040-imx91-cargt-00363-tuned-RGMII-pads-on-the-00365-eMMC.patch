-			MX91_PAD_ENET2_TD1__ENET2_RGMII_TD1				0x57e
-			MX91_PAD_ENET2_TD2__ENET2_RGMII_TD2				0x57e
-			MX91_PAD_ENET2_TD3__ENET2_RGMII_TD3				0x57e
-			MX91_PAD_ENET2_TXC__ENET2_RGMII_TXC				0x5fe
-			MX91_PAD_ENET2_TX_CTL__ENET2_RGMII_TX_CTL			0x57e
+			MX91_PAD_ENET2_MDC__ENET2_MDC					0x50e
+			MX91_PAD_ENET2_MDIO__ENET2_MDIO					0x50e
+			MX91_PAD_ENET2_RD0__ENET2_RGMII_RD0				0x51e
+			MX91_PAD_ENET2_RD1__ENET2_RGMII_RD1				0x51e
+			MX91_PAD_ENET2_RD2__ENET2_RGMII_RD2				0x51e
+			MX91_PAD_ENET2_RD3__ENET2_RGMII_RD3				0x51e
+			MX91_PAD_ENET2_RXC__ENET2_RGMII_RXC				0x51e
+			MX91_PAD_ENET2_RX_CTL__ENET2_RGMII_RX_CTL			0x51e
+			MX91_PAD_ENET2_TD0__ENET2_RGMII_TD0				0x51e
+			MX91_PAD_ENET2_TD1__ENET2_RGMII_TD1				0x51e
+			MX91_PAD_ENET2_TD2__ENET2_RGMII_TD2				0x51e
