board: cargt: imx95_00414: print the SOM serial number

Read the Cargt SOM EEPROM through the System Manager in board_late_init()
and print the serial number in decimal, with the part number, when the
record is valid. A blank EEPROM prints nothing; a record with the magic
but a bad CRC is reported by cargt_eeprom_is_valid(). Building
cargt_eeprom.o also adds the cargt_eeprom command.

Upstream-Status: Inappropriate [Cargt board specific]

---

diff -Nru a/board/cargt/imx95_00414/imx95_00414.c b/board/cargt/imx95_00414/imx95_00414.c
--- a/board/cargt/imx95_00414/imx95_00414.c	2026-10-23 09:36:25.248426428 -0500
+++ b/board/cargt/imx95_00414/imx95_00414.c	2026-10-23 09:36:25.249426455 -0500
@@ -23,6 +23,8 @@
 #include <dm/device.h>
 #include <dm/uclass.h>
 
+#include "../common/cargt_eeprom.h"
+
 extern int board_fix_fdt_fuse(void *fdt);
 
 static int imx9_scmi_power_domain_enable(u32 domain, bool enable)
@@ -109,8 +111,29 @@
 	return 0;
 }
 
+/* Print the SOM serial number (decimal) when the EEPROM holds a valid record */
+static void board_print_som_serial(void)
+{
+	struct cargt_eeprom ep;
+	char cpn[sizeof(ep.cpn) + 1];
+
+	if (cargt_eeprom_read(&ep))
+		return;
+
+	/* Blank EEPROM: say nothing. A bad record is reported by cargt_eeprom_is_valid(). */
+	if (be32_to_cpu(ep.magic) != CARGT_EEPROM_MAGIC || !cargt_eeprom_is_valid(&ep))
+		return;
+
+	if (cargt_eeprom_get_cpn_string(&ep, cpn, sizeof(cpn)))
+		cpn[0] = '\0';
+
+	printf("Serial: %u (%s)\n", be32_to_cpu(ep.serial), cpn);
+}
+
 int board_late_init(void)
 {
+	board_print_som_serial();
+
 	if (IS_ENABLED(CONFIG_ENV_IS_IN_MMC))
 		board_late_mmc_env_init();
 
diff -Nru a/board/cargt/imx95_00414/Makefile b/board/cargt/imx95_00414/Makefile
--- a/board/cargt/imx95_00414/Makefile	2026-10-23 09:36:25.248426428 -0500
+++ b/board/cargt/imx95_00414/Makefile	2026-10-23 09:36:25.249426455 -0500
@@ -8,6 +8,7 @@
 
 ifndef CONFIG_SPL_BUILD
 obj-y += sm_eeprom_i2c.o
+obj-y += ../common/cargt_eeprom.o
 endif
 
 ifdef CONFIG_SPL_BUILD
diff -Nru a/include/configs/imx95_00414.h b/include/configs/imx95_00414.h
--- a/include/configs/imx95_00414.h	2026-10-23 09:36:25.248426428 -0500
+++ b/include/configs/imx95_00414.h	2026-10-23 09:36:25.249426455 -0500
@@ -29,6 +29,15 @@
 #define CFG_SYS_SECURE_SDRAM_BASE	0x8A000000 /* Secure DDR region for A55, SPL could use first 2MB */
 #define CFG_SYS_SECURE_SDRAM_SIZE	0x06000000
 
+/* SOM EEPROM, reached through the System Manager (sm_eeprom_i2c.c) */
+#define CARGT_EEPROM_I2C_NAME		"i2c-sm-eeprom"
+/*
+ * Fallbacks for cargt_eeprom.c only. On the 00414 OEI picks the DDR
+ * configuration and U-Boot takes the size from the SM, not from these.
+ */
+#define DEFAULT_SDRAM_SIZE_MB		(2048)
+#define DEFAULT_SDRAM_SPEED_MTS		(6400)
+
 #ifdef CONFIG_AHAB_BOOT
 #define AHAB_ENV "sec_boot=yes\0"
 #else
