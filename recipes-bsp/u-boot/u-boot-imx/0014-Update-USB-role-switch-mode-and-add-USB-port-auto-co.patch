From a2439064a6190fe3d47b58b128342007664ac586 Mon Sep 17 00:00:00 2001
From: Tim Carney <tim.carney@cargt.com>
Date: Fri, 27 Feb 2026 10:05:51 -0600
Subject: [PATCH] Update USB role switch mode and add USB port auto
 configuration

---
 arch/arm/dts/imx8mp-cargt-00377-00365.dts  | 6 ++++--
 cmd/fastboot.c                             | 3 ---
 configs/imx8mp-cargt-00377-00365_defconfig | 1 +
 3 files changed, 5 insertions(+), 5 deletions(-)

diff --git a/arch/arm/dts/imx8mp-cargt-00377-00365.dts b/arch/arm/dts/imx8mp-cargt-00377-00365.dts
index 6cfa536778f..2d73e38177e 100644
--- a/arch/arm/dts/imx8mp-cargt-00377-00365.dts
+++ b/arch/arm/dts/imx8mp-cargt-00377-00365.dts
@@ -156,7 +156,7 @@ model = "Cargt i.MX8MP 00377 OSM-L SOM on 00365 carrier board";
 	srp-disable;
 	adp-disable;
 	usb-role-switch;
-	role-switch-default-mode = "none";
+	role-switch-default-mode = "peripheral";
 	snps,dis-u1-entry-quirk;
 	snps,dis-u2-entry-quirk;
 	status = "okay";
@@ -184,7 +184,7 @@ model = "Cargt i.MX8MP 00377 OSM-L SOM on 00365 carrier board";
 	srp-disable;
 	adp-disable;
 	usb-role-switch;
-	role-switch-default-mode = "none";
+	role-switch-default-mode = "peripheral";
 	snps,dis-u1-entry-quirk;
 	snps,dis-u2-entry-quirk;
 	status = "okay";
@@ -206,6 +206,8 @@ model = "Cargt i.MX8MP 00377 OSM-L SOM on 00365 carrier board";
 	cd-gpios = <&gpio2 12 GPIO_ACTIVE_LOW>;
 	vmmc-supply = <&reg_usdhc2_vmmc>;
 	bus-width = <4>;
+	no-1-8-v;
+	max-frequency = <25000000>;
 	status = "okay";
 };
 
diff --git a/cmd/fastboot.c b/cmd/fastboot.c
index 65e14c8e398..88fd26bdfb0 100644
--- a/cmd/fastboot.c
+++ b/cmd/fastboot.c
@@ -88,9 +88,6 @@ static int do_fastboot_usb(int argc, char *const argv[],
 			pr_err("Error: Wrong USB controller index format\n");
 			return CMD_RET_FAILURE;
 		}
-#ifdef CONFIG_FASTBOOT_USB_DEV
-		controller_index = CONFIG_FASTBOOT_USB_DEV;
-#endif
 	}
 
 	ret = udc_device_get_by_index(controller_index, &udc);
diff --git a/configs/imx8mp-cargt-00377-00365_defconfig b/configs/imx8mp-cargt-00377-00365_defconfig
index 34ceee8d6ef..ad32c1469e3 100644
--- a/configs/imx8mp-cargt-00377-00365_defconfig
+++ b/configs/imx8mp-cargt-00377-00365_defconfig
@@ -110,6 +110,7 @@ CONFIG_CLK_IMX8MP=y
 CONFIG_DFU_TFTP=y
 CONFIG_DFU_MMC=y
 CONFIG_DFU_RAM=y
+CONFIG_USB_PORT_AUTO=y
 CONFIG_USB_FUNCTION_FASTBOOT=y
 CONFIG_UDP_FUNCTION_FASTBOOT=y
 CONFIG_FASTBOOT_BUF_ADDR=0x42800000
-- 
2.34.1

