From 28a96f74527332298d9766e7d53cfc0388324fff Mon Sep 17 00:00:00 2001
From: Tim Carney <tim.carney@cargt.com>
Date: Tue, 23 Sep 2025 17:08:14 -0500
Subject: [PATCH] Update u-boot-imx to boot Cargt Linux image.

---
 configs/imx93-cargt-00363-00365_defconfig |  4 ++--
 include/configs/imx93_00363.h             | 15 ++++++++-------
 2 files changed, 10 insertions(+), 9 deletions(-)

diff --git a/configs/imx93-cargt-00363-00365_defconfig b/configs/imx93-cargt-00363-00365_defconfig
index 4ec46337de8..af3bf873b3e 100644
--- a/configs/imx93-cargt-00363-00365_defconfig
+++ b/configs/imx93-cargt-00363-00365_defconfig
@@ -30,8 +30,8 @@ CONFIG_FIT=y
 CONFIG_FIT_SIGNATURE=y
 CONFIG_DISTRO_DEFAULTS=y
 CONFIG_OF_SYSTEM_SETUP=y
-CONFIG_BOOTCOMMAND="run ext4boot"
-CONFIG_DEFAULT_FDT_FILE="boot/imx93-cargt-00363-00365-glt0557201280is1.dtb"
+CONFIG_BOOTCOMMAND="run distro_bootcmd;run bsp_bootcmd"
+CONFIG_DEFAULT_FDT_FILE="boot/imx93-cargt-00363-00365.dtb"
 CONFIG_SYS_CBSIZE=2048
 CONFIG_SYS_PBSIZE=2074
 CONFIG_ARCH_MISC_INIT=y
diff --git a/include/configs/imx93_00363.h b/include/configs/imx93_00363.h
index 1cab1452a30..8e8e3fd46c5 100644
--- a/include/configs/imx93_00363.h
+++ b/include/configs/imx93_00363.h
@@ -67,7 +67,7 @@
 	"prepare_mcore=setenv mcore_clk clk-imx93.mcore_booted;\0" \
 	"scriptaddr=0x83500000\0" \
 	"kernel_addr_r=" __stringify(CONFIG_SYS_LOAD_ADDR) "\0" \
-	"image=Image\0" \
+	"image=boot/Image\0" \
 	"splashimage=0x90000000\0" \
 	"console=ttyLP0,115200 earlycon\0" \
 	"fdt_addr_r=0x83000000\0"			\
@@ -80,15 +80,15 @@
 	"bootm_size=0x10000000\0" \
 	"mmcdev=" __stringify(CONFIG_SYS_MMC_ENV_DEV)"\0" \
 	"mmcpart=1\0" \
-	"mmcroot=/dev/mmcblk1p2 rootwait rw\0" \
 	"mmcautodetect=yes\0" \
-	"mmcargs=setenv bootargs ${jh_clk} ${mcore_clk} console=${console} root=${mmcroot}\0 " \
-	"loadbootscript=fatload mmc ${mmcdev}:${mmcpart} ${loadaddr} ${script};\0" \
+	"mmcargs=setenv bootargs ${jh_clk} console=${console} " \
+		"root=/dev/mmcblk${mmcdev}p${mmcpart} rootwait rw\0" \
+	"loadbootscript=${loadcmd} mmc ${mmcdev}:${mmcpart} ${loadaddr} ${script};\0" \
 	"bootscript=echo Running bootscript from mmc ...; " \
 		"source\0" \
-	"loadimage=fatload mmc ${mmcdev}:${mmcpart} ${loadaddr} ${image}\0" \
-	"loadfdt=fatload mmc ${mmcdev}:${mmcpart} ${fdt_addr_r} ${fdtfile}\0" \
-	"loadcntr=fatload mmc ${mmcdev}:${mmcpart} ${cntr_addr} ${cntr_file}\0" \
+	"loadimage=${loadcmd} mmc ${mmcdev}:${mmcpart} ${loadaddr} ${image}\0" \
+	"loadfdt=${loadcmd} mmc ${mmcdev}:${mmcpart} ${fdt_addr_r} ${fdtfile}\0" \
+	"loadcntr=${loadcmd} mmc ${mmcdev}:${mmcpart} ${cntr_addr} ${cntr_file}\0" \
 	"auth_os=auth_cntr ${cntr_addr}\0" \
 	"boot_os=booti ${loadaddr} - ${fdt_addr_r};\0" \
 	"mmcboot=echo Booting from mmc ...; " \
@@ -140,6 +140,7 @@
 			"fi;" \
 		"fi;\0" \
 	"bsp_bootcmd=echo Running BSP bootcmd ...; " \
+		"setenv loadcmd ext4load; " \
 		"mmc dev ${mmcdev}; if mmc rescan; then " \
 		   "if run loadbootscript; then " \
 			   "run bootscript; " \
