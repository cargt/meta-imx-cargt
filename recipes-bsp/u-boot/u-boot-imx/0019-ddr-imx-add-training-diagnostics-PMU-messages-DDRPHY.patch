From aadcf18b75cab384c9535f6367c1230f089f519e Mon Sep 17 00:00:00 2001
From: Tim Carney <tim.carney@cargt.com>
Date: Tue, 26 May 2026 09:54:13 -0500
Subject: [PATCH 19/23] ddr/imx: add training diagnostics (PMU messages +
 DDRPHY CSR snapshot)

---
 drivers/ddr/imx/phy/ddrphy_utils.c | 33 +++++++++++++++++++++++++++++-
 1 file changed, 32 insertions(+), 1 deletion(-)

diff --git a/drivers/ddr/imx/phy/ddrphy_utils.c b/drivers/ddr/imx/phy/ddrphy_utils.c
index 59a15764526..2e98b420c16 100644
--- a/drivers/ddr/imx/phy/ddrphy_utils.c
+++ b/drivers/ddr/imx/phy/ddrphy_utils.c
@@ -85,10 +85,40 @@ static inline void decode_streaming_message(void)
 	debug("\n");
 }
 
+static inline int pmu_message_ready_now(void)
+{
+	unsigned int reg = reg32_read(IP2APB_DDRPHY_IPS_BASE_ADDR(0) + ddrphy_addr_remap(0xd0004));
+	return !(reg & 0x1);
+}
+
+static void dump_ddr_training_diagnostics(void)
+{
+	unsigned int i, reg, mail;
+	unsigned int base = IP2APB_DDRPHY_IPS_BASE_ADDR(0) + ddrphy_addr_remap(0xd0000);
+
+	printf("=== DDR training diagnostics ===\n");
+	/* Non-blocking consumption of any pending PMU messages */
+	for (i = 0; i < 16; i++) {
+		reg = reg32_read(IP2APB_DDRPHY_IPS_BASE_ADDR(0) + ddrphy_addr_remap(0xd0004));
+		if (reg & 0x1)
+			break; /* no message ready */
+		mail = reg32_read(IP2APB_DDRPHY_IPS_BASE_ADDR(0) + ddrphy_addr_remap(0xd0032));
+		decode_major_message(mail);
+		if (mail == 0x08)
+			decode_streaming_message();
+	}
+
+	/* Print a small block of DDRPHY CSR registers for offline analysis */
+	for (i = 0; i < 0x40; i += 4) {
+		reg = reg32_read(base + i);
+		printf("DDRPHY[0x%03x]=0x%08x\n", i, reg);
+	}
+	printf("=== end diagnostics ===\n");
+}
+
 int wait_ddrphy_training_complete(void)
 {
 	unsigned int mail;
-
 	while (1) {
 		mail = get_mail();
 		decode_major_message(mail);
@@ -99,6 +129,7 @@ int wait_ddrphy_training_complete(void)
 			return 0;
 		} else if (mail == 0xff) {
 			printf("Training FAILED\n");
+			dump_ddr_training_diagnostics();
 			return -1;
 		}
 	}
-- 
