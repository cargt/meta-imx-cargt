index 994257ad450..f70f5b612d0 100644
--- a/board/cargt/imx93_00363/Kconfig
+++ b/board/cargt/imx93_00363/Kconfig
@@ -38,4 +38,5 @@ config CARGT_IMX93_00363_LPDDR4X_TIMING_FILENAME
 	  Name of the timing file to use when CARGT_IMX93_00363_LPDDR4X_TIMING_BY_NAME is used.
 
 
+
 endif
diff --git a/board/cargt/imx93_00363/Makefile b/board/cargt/imx93_00363/Makefile
index 6371018a7c2..c761fe8ccc7 100644
