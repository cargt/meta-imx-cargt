From f7ac900e9c39acab7f8f1344ef6149092a91b2fe Mon Sep 17 00:00:00 2001
From: Tim Carney <tim.carney@cargt.com>
Date: Tue, 26 May 2026 12:31:31 -0500
Subject: [PATCH] tools: revert temporary 512MB mapping in comparator (skip
 512MB files)

---
 tools/compare_all_generated_vs_board.py | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/tools/compare_all_generated_vs_board.py b/tools/compare_all_generated_vs_board.py
index 059fafcf31f..afb83d026d9 100644
--- a/tools/compare_all_generated_vs_board.py
+++ b/tools/compare_all_generated_vs_board.py
@@ -65,6 +65,8 @@ def pick_board_file_for_gen(gen_name):
         return BOARD_DIR / 'cargt_lpddr4x_2gbyte_3200mts_timing.c'
     if '2g_3733' in gen_name:
         return BOARD_DIR / 'cargt_lpddr4x_2gbyte_3733mts_timing.c'
+    # No mapping for 512MB variants; they will be skipped if no board file
+    # exists for that size/speed combination.
     return None
 
 
