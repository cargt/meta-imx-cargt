diff --git a/board/cargt/imx8mp_00377/Kconfig b/board/cargt/imx8mp_00377/Kconfig
index 01a1474bfb6..ca9a5dc8902 100644
--- a/board/cargt/imx8mp_00377/Kconfig
+++ b/board/cargt/imx8mp_00377/Kconfig
@@ -12,4 +12,27 @@ config SYS_CONFIG_NAME
 config IMX_CONFIG
 	default "board/cargt/imx8mp_00377/imximage-8mp-lpddr4.cfg"
 
+choice
+	prompt "Select method to choose LPDDR4 timing for TARGET_IMX8MP_00377"
+	default CARGT_IMX8MP_00377_LPDDR4_TIMING_BY_EEPROM
+
+config CARGT_IMX8MP_00377_LPDDR4_TIMING_BY_NAME
+	bool "Using CARGT_IMX8MP_00377_LPDDR4_TIMING_FILENAME for LPDDR4 Timing selection"
+	help
+	  Select the LPDDR4 timing based on specified filename
+
+config CARGT_IMX8MP_00377_LPDDR4_TIMING_BY_EEPROM
+	bool "Using Cargt EEPROM contents for LPDDR4 Timing selection"
+	help
+	  Select the LPDDR4 timing based on contents of EEPROM on SOM
+
+endchoice
+
+config CARGT_IMX8MP_00377_LPDDR4_TIMING_FILENAME
+	string "Specify the LPDDR4 Timing Filename"
+	depends on CARGT_IMX8MP_00377_LPDDR4_TIMING_BY_NAME
+	default "lpddr4_timing"
+	help
+	  Name of the timing file to use when CARGT_IMX8MP_00377_LPDDR4_TIMING_BY_NAME is used.
+
 endif
diff --git a/board/cargt/imx8mp_00377/Makefile b/board/cargt/imx8mp_00377/Makefile
index cc4d917800e..ed027d18003 100644
--- a/board/cargt/imx8mp_00377/Makefile
+++ b/board/cargt/imx8mp_00377/Makefile
@@ -5,12 +5,22 @@
 #
 
 obj-y += imx8mp_00377.o
+obj-$(CONFIG_TARGET_IMX8MP_00377) += ../common/cargt_eeprom.o
 
 ifdef CONFIG_SPL_BUILD
 obj-y += spl.o
+
+ifdef CONFIG_CARGT_IMX8MP_00377_LPDDR4_TIMING_BY_EEPROM
+# When EEPROM timing selection is enabled, build both timing files
+# so we can switch between them based on EEPROM content
+obj-$(CONFIG_IMX8M_LPDDR4) += lpddr4_timing.o lpddr4_timing_ndm.o
+else
+# Use CONFIG_IMX8M_LPDDR4_FREQ0_3200MTS to choose single timing file
 ifdef CONFIG_IMX8M_LPDDR4_FREQ0_3200MTS
 obj-y += lpddr4_timing_ndm.o
 else
 obj-$(CONFIG_IMX8M_LPDDR4) += lpddr4_timing.o
 endif
 endif
+
+endif
