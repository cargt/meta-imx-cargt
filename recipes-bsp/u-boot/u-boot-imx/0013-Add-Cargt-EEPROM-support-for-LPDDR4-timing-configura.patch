 	{
 		/* P0 3200mts 1D */
 		.drate = 3200,
@@ -2469,7 +2469,7 @@ struct dram_fsp_msg ddr_dram_fsp_msg[] = {
 };
 
 /* ddr timing config params */
-struct dram_timing_info dram_timing = {
+struct dram_timing_info dram_timing_ndm = {
 	.ddrc_cfg = ddr_ddrc_cfg,
 	.ddrc_cfg_num = ARRAY_SIZE(ddr_ddrc_cfg),
 	.ddrphy_cfg = ddr_ddrphy_cfg,
diff --git a/board/cargt/imx8mp_00377/spl.c b/board/cargt/imx8mp_00377/spl.c
index 95015d51643..b089d8d539c 100644
--- a/board/cargt/imx8mp_00377/spl.c
+++ b/board/cargt/imx8mp_00377/spl.c
@@ -28,9 +28,12 @@
 #include <mmc.h>
 #include <asm/arch/ddr.h>
 #include <asm/sections.h>
+#include "../common/cargt_eeprom.h"
 
 DECLARE_GLOBAL_DATA_PTR;
 
+static struct cargt_eeprom eeprom = {0};
+
 int spl_board_boot_device(enum boot_device boot_dev_spl)
 {
 #ifdef CONFIG_SPL_BOOTROM_SUPPORT
@@ -57,15 +60,62 @@ int spl_board_boot_device(enum boot_device boot_dev_spl)
 #endif
 }
 
+extern struct dram_timing_info dram_timing;
+extern struct dram_timing_info dram_timing_ndm;
+
 void spl_dram_init(void)
 {
-	ddr_init(&dram_timing);
+	struct dram_timing_info *ptiming = &dram_timing;
+
+#if IS_ENABLED(CONFIG_CARGT_IMX8MP_00377_LPDDR4_TIMING_BY_EEPROM)
+	uint16_t dram_speed_mts = 0;
+	uint16_t dram_size_mb = 0;
+
+	printf("Reading Cargt EEPROM over I2C...\n");
+	cargt_eeprom_read(&eeprom);
+	printf("Cargt EEPROM read complete.\n");
+	cargt_eeprom_print_prod_info(&eeprom);
+
+	/* Determine timing based on speed */
+	dram_speed_mts = cargt_eeprom_get_dram_speed_mts(&eeprom);
+	dram_size_mb = cargt_eeprom_get_dram_size_mb(&eeprom);
+
+	switch (dram_speed_mts) {
+	case 3200:
+		ptiming = &dram_timing_ndm;
+		printf("\tLoading timing for 3200 MTS LPDDR4 (%d MB)\n", dram_size_mb);
+		break;
+	case 4000:
+		ptiming = &dram_timing;
+		printf("\tLoading timing for 4000 MTS LPDDR4 (%d MB)\n", dram_size_mb);
+		break;
+	default:
+		printf("Warning: Unsupported DRAM speed %d MTS in EEPROM, defaulting to 4000 MTS\n",
+		       dram_speed_mts);
+		ptiming = &dram_timing;
+		printf("\tLoading timing for 4000 MTS LPDDR4 (%d MB)\n", dram_size_mb);
+		break;
+	}
+
+	/* Warn if size doesn't match expected 4GB */
+	if (dram_size_mb != 4096 && dram_size_mb != 0) {
+		printf("Warning: Unexpected DRAM size %d MB in EEPROM (expected 4096 MB)\n",
+		       dram_size_mb);
+	}
+#endif /* CONFIG_CARGT_IMX8MP_00377_LPDDR4_TIMING_BY_EEPROM */
+
+	ddr_init(ptiming);
 }
 
 void spl_board_init(void)
 {
+	struct cargt_eeprom *ep = CARGT_EEPROM_DATA;
+
 	arch_misc_init();
 
+	/* Copy EEPROM contents to DRAM */
+	memcpy(ep, &eeprom, sizeof(*ep));
+
 	/*
 	 * Set GIC clock to 500Mhz for OD VDD_SOC. Kernel driver does
 	 * not allow to change it. Should set the clock after PMIC
