 	{0x90001, 0x400},
@@ -2437,7 +2437,7 @@ struct dram_cfg_param ddr_phy_pie[] = {
 	{0xd0000, 0x1},
 };
 
-struct dram_fsp_msg ddr_dram_fsp_msg[] = {
