[Unit]
Description=Detach the framebuffer console from the display
# Until Weston is up, fbcon on the display only shows a cursor under the
# splash and clears the screen when Weston's unit switches VT.
# cargt-fbcon-attach puts it back afterwards.
DefaultDependencies=no
Before=psplash-start@fb0.service sysinit.target

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'for v in /sys/class/vtconsole/vtcon*; do grep -q "frame buffer" $$v/name && echo 0 > $$v/bind; done; true'
