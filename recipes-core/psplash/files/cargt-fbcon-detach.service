[Unit]
Description=Detach the framebuffer console from the display
# The console is on serial. On the display fbcon only shows a cursor under
# the splash and clears the screen when Weston's unit switches VT. To get a
# text console on the display back, e.g. for Ctrl+Alt+F2:
#   echo 1 > /sys/class/vtconsole/vtcon1/bind
DefaultDependencies=no
Before=psplash-start@fb0.service sysinit.target

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'for v in /sys/class/vtconsole/vtcon*; do grep -q "frame buffer" $$v/name && echo 0 > $$v/bind; done; true'
